    {
      "path": "cordis.patch.yml",
      "text": "# dsh-peer-bus bundle patch: mounted as one insert over the profile root.\n#\n# One row: the bus itself — tools and delivery.\n#\n# There used to be a second row, `peer-bus-invariant`, the package-owned\n# durable-shape checks behind the package's `./invariant` export. DSH 0.2.1\n# removed the runtime invariants plugin and every package's `./invariant` export\n# (\"使用这些诊断入口的开发者需相应调整扩展或自定义 profile\"), and\n# `@deepseek-ai/dsh-invariants` is no longer present in the install at all, so\n# that row could never activate again. It is gone, along with src/invariant.js.\n# The checks it ran were always inert on the base, web and headless bundles\n# anyway: only `dsh-sdk-minimal` mounted the `invariants` service.\n#\n# This ships default-deny, so installing the plugin alone grants no session the\n# ability to message another. Add allow rules through the profile's own\n# cordis.patch.yml, targeting the bus row's id:\n#\n#   - id: peer-bus\n#     config:\n#       allow:\n#         - from: 'session-abc'\n#           to: 'session-def'\n#\n# A patch replaces the targeted row's whole `config`, so restate every key you\n# still want rather than only the one you are changing.\n- insert:\n    - id: peer-bus\n      name: 'dsh-peer-bus'\n      config:\n        allow: []\n        maxMessageBytes: 16384\n        maxSendsPerWindow: 10\n        rateWindowMs: 60000\n"
    }
  ],
