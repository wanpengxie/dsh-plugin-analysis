      "path": "cordis.patch.yml",
      "text": "# dsh-official-vision bundle patch.\n# Installed via `dsh plugin --profile web add dsh-official-vision` —\n# this patch inserts the direct official DeepSeek vision provider route.\n#\n# The route advertises the official multimodal model `deepseek-v4-flash-vision-exp`\n# (input: text + image) and streams directly against https://api.deepseek.com.\n# No third-party vision model is involved; the API key comes from DSH's\n# credential store (same key as the built-in DeepSeek provider).\n#\n# Optional config:\n#   model: deepseek-v4-flash-vision-exp   # wire model id (default)\n#   detail: auto                          # low | high | original | auto\n#   maxImagesPerRequest: 600\n#   preferFilesApi: true                  # use Files API for large/reused images\n- insert:\n    - id: dsh-official-vision\n      name: 'dsh-official-vision'\n"
    }
