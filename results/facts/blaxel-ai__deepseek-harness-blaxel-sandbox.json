  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# Local execution and existing tool-only bindings use native provider routers.\n# New Web handoffs move the complete agent host into a private cloud session.\n- id: subprocess\n  name: '@deepseek-ai/dsh-subprocess-local'\n  disabled: true\n\n- id: fs-sandbox\n  name: '@deepseek-ai/dsh-fs-sandbox'\n  disabled: true\n\n- id: sandbox-policy\n  name: '@deepseek-ai/dsh-sandbox-policy'\n  config:\n    mode: !!js process.env.DSH_PERMISSION_MODE ?? 'workspace-write'\n    workspaceRoot: !!js process.cwd()\n\n- id: bash-sandbox\n  name: '@deepseek-ai/dsh-bash-sandbox'\n  disabled: !!js process.platform === 'win32'\n  config:\n    timeoutMs: 300000\n\n- id: pwsh-sandbox\n  name: '@deepseek-ai/dsh-pwsh-sandbox'\n  disabled: !!js process.platform !== 'win32'\n\n- id: approval\n  name: '@deepseek-ai/dsh-user-approval'\n  config:\n    policy: !!js \"(process.env.DSH_PERMISSION_MODE ?? 'workspace-write') === 'danger-full-access' ? 'never' : 'ask'\"\n\n- id: permission\n  name: '@deepseek-ai/dsh-permission-presets'\n  config:\n    presets: !!js \"({ 'read-only': { sandbox: 'read-only', approval: 'ask' }, 'workspace-write': { sandbox: 'workspace-write', approval: 'ask' }, 'danger-full-access': { sandbox: 'danger-full-access', approval: 'never' } })\"\n    defaultPreset: !!js process.env.DSH_PERMISSION_MODE ?? 'workspace-write'\n\n- insert:\n    - id: blaxel-sessions\n      name: '@blaxel/dsh-sandbox/session-runtime'\n\n    - id: blaxel-subprocess-router\n      name: '@blaxel/dsh-sandbox/subprocess-routing'\n\n    - id: blaxel-filesystem-router\n      name: '@blaxel/dsh-sandbox/filesystem-routing'\n\n    # A root-package row lets DSH discover the package's browser client module.\n    - id: blaxel-client\n      name: '@blaxel/dsh-sandbox'\n\n    # The host bridge creates ordinary DSH sessions and binds their execution\n    # backends and complete cloud hosts to Blaxel sandboxes.\n    - id: blaxel-web\n      name: '@blaxel/dsh-sandbox/web'\n\n# The native Gateway retains authentication and validation while fencing migrated sessions.\n- id: typert-gateway\n  disabled: true\n\n- insert:\n    - id: blaxel-native-gateway-client\n      name: './dist/native-client/gateway/index.js'\n    - id: blaxel-cloud-gateway\n      name: '@blaxel/dsh-sandbox/cloud-gateway'\n- insert:\n    - id: blaxel-cloud\n      name: '@blaxel/dsh-sandbox/cloud'\n"
    }
  ],
