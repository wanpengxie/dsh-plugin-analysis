  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# dsh-deepseek-monitor bundle patch\n#\n# Published-package patch layer: `dsh plugin --profile <name> add dsh-deepseek-monitor`\n# appends this package to the profile bundle stack and merges this insert.\n#\n# Aggregate double-mount guard: aggregate bundles may already mount this\n# package under their own entry id. Two mounts register /dsm/api twice and\n# fail the whole plugin tree at boot (\"duplicate prefix route\"). The !!js\n# expression backs THIS row off when another *enabled* entry already mounts\n# dsh-deepseek-monitor; the aggregate instance then owns the monitoring.\n- insert:\n    - id: deepseek-monitor\n      name: 'dsh-deepseek-monitor'\n      disabled: !!js \"[...ctx.loader.entries()].some((e) => e.options.name === 'dsh-deepseek-monitor' && e.options.id !== 'deepseek-monitor' && !e.disabled)\"\n"
    }
  ],
