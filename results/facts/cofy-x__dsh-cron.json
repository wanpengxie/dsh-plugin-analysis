  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# Bundle patch applied over the selected DSH profile when this package is listed\n# in `dsh.profile.bundles`. The row id is deployment-local; the package name\n# must match package.json. In web profiles this same row also contributes the\n# browser task center declared by the package's `dsh.client` manifest.\n\n- insert:\n    - id: dsh-cron\n      name: '@cofy-x/dsh-cron'\n      # config:\n      #   dataDir: <string>            # job store directory; defaults to $DSH_HOME/cron\n      #   defaultTimeZone: <string>    # IANA zone for schedules; defaults to the host local zone\n      #   maxJobs: 64                  # maximum active jobs\n      #   minIntervalMinutes: 1        # minimum gap between recurring fires\n      #   defaultCwd: <absolute-workspace> # required for browser/API jobs without an explicit target\n      #   reconcilePollMs: 1000        # durable Automation event-feed polling interval\n      #   maxRunHistory: 100           # retained source occurrences per job\n\n# No invariant companion row: the shipped web/headless profiles do not compose\n# the `invariants` service, so an invariant row would never resolve there.\n"
    }
