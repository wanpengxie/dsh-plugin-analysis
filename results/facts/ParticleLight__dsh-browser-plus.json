  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# dsh-browser-plus bundle patch: mounts the shared-browser capability into a\n# profile composition. The browser seam (ctx.browser) is always mounted. The\n# Electron provider and browser_* tools are ALWAYS registered: when the host\n# provides `electronViewHost` (the desktop shell) that embedded view is used,\n# and otherwise the plugin self-hosts its own Electron window, so installing\n# the plugin is enough for the browser to work anywhere.\n- insert:\n    # Root row: no behaviour of its own, but the client module system only reads\n    # a package's `dsh.client` from a Loader row whose specifier is the EXACT\n    # package root (a subpath resolves to undefined and is skipped). Without this\n    # row the Web GUI panel is never composed, however many subpath rows exist.\n    - id: browser-plus\n      name: dsh-browser-plus\n\n    - id: browser\n      name: dsh-browser-plus/browser\n\n    - id: browser-electron\n      name: dsh-browser-plus/browser-electron\n      config:\n        viewHost: !!js ctx.get('electronViewHost')\n\n    - id: tool-browser\n      name: dsh-browser-plus/tool-browser\n\n    # Human-facing `/browser`: opens/raises the shared window without the model.\n    # Its own row on purpose — a composition without the command registry must\n    # still get the tools above.\n    - id: browser-command\n      name: dsh-browser-plus/command-browser\n\n    # The Web GUI panel's bridge: opens/raises the window from a button in the\n    # right sidebar. Needs the web server, so it is its own row too.\n    - id: browser-http\n      name: dsh-browser-plus/http-browser\n\n    # Bridges the Agent's todo list (DSH session projection) into the browser, so\n    # the floating orb can show what the Agent is working on. Its own row because\n    # it needs optional services the browser itself does not.\n    - id: browser-task-todos\n      name: dsh-browser-plus/task-todos\n"
    }
  ],
