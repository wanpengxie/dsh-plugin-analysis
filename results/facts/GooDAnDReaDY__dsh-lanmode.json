  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# dsh-lanmode bundle layer: applied automatically when the package is installed\n# as a profile bundle (package.json declares dsh.bundle.patch).\n#\n# `name` must stay the full npm package name: the loader entry name is how the\n# served bundle is resolved.\n#\n# DSH 0.1.7+: configuration lives directly in the profile row config below.\n# The settings.register API was removed; the profile row is the single source\n# of truth. Override values in your own profile patch as needed:\n#\n#   - id: dsh-lanmode\n#     config:\n#       mode: direct\n#       directHost: '0.0.0.0'\n#       directPort: 3080\n#       tls: self-signed\n#       allow:\n#         - '192.168.1.0/24'\n#\n# Default config below is fail-closed: localhost-only, loopback allowlist.\n# To enable network access, set directHost and allow in your profile.\n\n# #241: Disable OS native directory chooser on remote/headless server\n- id: directory-picker\n  disabled: true\n\n- insert:\n    - id: dsh-lanmode\n      name: '@goodandready/dsh-lanmode'\n      config:\n        mode: auto\n        directHost: '127.0.0.1'\n        directPort: 3088\n        allow:\n          - '127.0.0.0/8'\n\n    # #241: Mount in-app browser directory picker backend and client UI dialog\n    - id: directory-picker-browse\n      name: '@deepseek-ai/dsh-host-directory-picker-browse'\n      config:\n        maxEntries: 1000\n\n    - id: ui-directory-picker-browse\n      name: '@deepseek-ai/dsh-client-ui-directory-picker-browse'\n"
    }
  ],
