  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# dsh-eteams bundle patch: mounts the eteams plugin into the host composition\n# of a dsh profile. The plugin injects tools/subagents/agents/systemPrompt and\n# registers the full `eteams_*` captain+member tool face (team lifecycle,\n# execution chains, mailboxes), and its client bundle adds the 团队 tab and the\n# composer 团队 button.\n#\n# Install: `dsh plugin --profile <name> add <this package>` (npm or a local\n# path). The `dsh plugin` command pnpm-installs the package into the profile\n# and reconciles it into the profile's `dsh.profile.bundles` layer list.\n- insert:\n    - id: eteams\n      # Node-resolvable package name — must stay in sync with package.json\n      # `name`. Quoted because `@` is a reserved indicator in YAML and cannot\n      # open a plain scalar (kept quoted for uniformity with the reference).\n      name: 'dsh-eteams'\n      config:\n        # 状态根（用户迭代 2026-09-04 全局单库）：绝对路径 = 所有工作区共用\n        # 这一个根——一个 eteams.db、一份成员库、一份用量台账；相对路径 =\n        # per-workspace（<workspace>/<stateDir>，旧口径）。\n        stateDir: C:/Users/epat/.eteams\n        # Task working directory root: `<workspace>/<workRoot>/<主任务号>-slug/`\n        # (一个主任务一个目录：留言板.md + <任务号>-slug.纪要.md + 计划/ + 文档/).\n        workRoot: teams\n        # Hard cap on concurrently existing members per team.\n        maxMembers: 20\n        # Same-member auto-retry budget before a task fails hard (D6).\n        maxRetries: 3\n        # Provider used to spawn member subagents ('spawn' or 'fork').\n        memberProvider: spawn\n"
    }
  ],
  "entries": [
    "cordis.patch.yml",
    "package.json"
  ],
