  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# dsh-selection-explain bundle patch\n#\n# 本文件是包的 dsh.bundle.patch 层：官方 CLI 装配\n#   dsh plugin --profile <name> add @yfwu2020/dsh-selection-explain\n# 会把本包加进 profile 的 dsh.profile.bundles，启动时合并下面的 insert 行——\n# 无需手写 profile 的 cordis.patch.yml。运行时注入（dsh-super-injector 的\n# dev_inject_plugin / dev_install_package）同样使用这一行语义。\n#\n# 可调参数（改 profile 的 cordis.patch.yml 里同 id 行即可覆盖）：\n#   provider / model      固定模型路由；留空 = 跟随「默认模型」设置\n#   reasoningEffort       详解阶段的推理档位：off / low / high / max\n#   translationReasoningEffort  首轮单独一档（默认 off）；需要思考时可改 low / high / max\n#   chatReasoningEffort   追问档位（默认 high；想更快就调 low）\n#   historyMaxEntries     小窗对话历史保留多少个「划词条目」（默认 20，0 = 关闭）；\n#                         每个条目内含它自己的全部追问轮次，升格过的不参与 LRU 淘汰\n#   maxSelectionChars     选中文字长度上限（默认 4000）\n#   maxContextChars       上下文长度上限（默认 12000）\n#   maxRequestsPerMinute  本地限流（默认 40）\n#   toolNames             工具白名单（默认 advanced_search,platform_search,read,grep,glob）\n#   toolReadRoot          文件类工具（read/grep/glob）的读取边界：'' = 会话工作目录（默认），\n#                         '*' = 不限制，其他 = 写死的某个目录。越界在**执行前**被拒\n#   tools                 总开关（false = 完全不给工具）\n#   bridgeSidebarPreview  侧边栏 HTML 预览里的划词桥（默认 true）：预览帧会被补上\n#                         allow-scripts 并注入一段桥脚本（**不会**加 allow-same-origin，\n#                         预览页仍读不到 GUI 数据），这样在预览网页里划词也能解读。\n#                         false = 侧边栏网页里不弹「解读」按钮\n- insert:\n    - id: selection-explain\n      name: '@yfwu2020/dsh-selection-explain'\n      config:\n        translationReasoningEffort: off\n        # 首字约 1.9s（实测，off 不思考）；要更深可改 low / high / max\n        reasoningEffort: off\n        # 想再快：把背景窗口调小（少 prefill）\n        # sessionContextMaxMessages: 8\n"
    }
  ],
