  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# Bundle layer for the local `notoken-login` plugin: one host row that\n# registers the login entry route (default GET /__dsh_login).\n#\n# The route exchanges the running process's launch token for the dsh-auth-*\n# browser cookie inside the Host process, so a first visit does not need\n# ?token=... in the URL. Read README.md before enabling this: the entry hands\n# a full operator browser session to anyone who can reach the port and pass\n# the connection trust fence.\n#\n# The row id intentionally avoids the `ui-skin-` prefix: the skin managers own\n# every `ui-skin-*` row and would rewrite or disable it.\n- insert:\n    - id: plugin-notoken\n      name: '@beyondandsharp/dsh-plugin-notoken'\n      config:\n        # Installed-application launches are what makes this necessary: an\n        # Android PWA/WebAPK (home-screen icon) launched from Chrome is\n        # labelled `Sec-Fetch-Site: cross-site`, so the strict fence answers\n        # 403 to the icon while the same URL in a tab works. With this on, the\n        # entry allows a browser-labelled cross-site request only after\n        # re-asking the same fence without those labels (the authority must\n        # still be loopback/trustedHosts), and the session cookie is\n        # SameSite=Strict, so no cross-site page can ever use it. Set it to\n        # `false` for the strict behaviour (bookmarks and typed URLs only).\n        #\n        # Firefox for Android's \"Add to Home Screen\" is a different shape: it\n        # loads the shortcut as an external app and labels the navigation\n        # `Sec-Fetch-Site: none`, which the fence already admits — but Firefox\n        # still treats that launch as a foreign request for SameSite, so the\n        # Strict cookie never comes back. No flag is needed for it: the entry\n        # serves the shell in place for any session-less document navigation.\n        allowCrossSiteNavigation: true\n        # Remaining options are optional; unknown keys fail the plugin load.\n        #   path: /__dsh_login   # one path segment, no trailing slash\n        #   mode: exchange       # exchange (default) | redirect\n"
    }
  ],
