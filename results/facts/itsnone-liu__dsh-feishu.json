  "manifest": {
    "name": "dsh-feishu",
    "version": "0.3.0",
    "private": true,
    "type": "module",
    "description": "Feishu/Lark chat channel for DeepSeek Harness (dsh) — a sibling surface over dsh-base",
    "main": "src/index.js",
    "exports": {
      ".": "./src/index.js",
      "./package.json": "./package.json",
      "./cordis.patch.yml": "./cordis.patch.yml"
    },
    "dsh": {
      "bundle": {
        "patch": "./cordis.patch.yml"
      },
      "capabilities": {
        "required": [
          "dsh.profile.surface",
          "channel.chat"
        ],
        "optional": [
          "channel.chat.group",
          "media.cards.interactive"
        ]
      },
      "note": "no dsh.client section: this surface ships no browser components"
    },
    "dependencies": {},
    "engines": {
      "node": ">=22"
    },
    "keywords": [
      "dsh-plugin",
      "deepseek-harness",
      "feishu",
      "lark"
    ],
    "license": "MIT",
    "repository": {
      "type": "git",
      "url": "local"
    }
  },
  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# The dsh-feishu bundle patch: a Feishu/Lark chat surface directly over dsh-base.\n# It mounts no Host, HTTP server, Web runtime, or browser plugin — same stance\n# as dsh-headless. One plugin row carries the whole bridge; configuration lives\n# in a JSON file (default $DSH_HOME/feishu/config.json) so the row config stays\n# a pointer. Secrets come from the environment (FEISHU_APP_ID / FEISHU_APP_SECRET).\n\n- id: system-prompt\n  config:\n    persona: >-\n      You are a coding agent powered by the {{model}} model. Your working directory is {{cwd}}.\n\n# Same Code Mode opt-in as the Web/headless surfaces.\n- id: tools\n  config:\n    mode: !!js process.env.DSH_TOOLS_MODE\n\n- insert:\n    - id: feishu-bridge\n      name: 'dsh-feishu'\n\n# The preset roster (same row web mounts). The launcher auto-injects the\n# shipped system root beside the installed app for any profile that has this\n# row; $DSH_HOME/.agent-presets stays the user-authorable root.\n- insert:\n    - id: agent-presets\n      name: '@deepseek-ai/dsh-agent-presets'\n      config:\n        default: standard\n"
    }
  ],
