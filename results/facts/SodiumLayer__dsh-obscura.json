  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# dsh-obscura-plugin bundle layer.\n#\n# Applied automatically when this package is registered as a profile bundle\n# (`dsh plugin --profile web add <path-to-this-folder>`). It mounts the plugin's\n# host entry; the browser half is discovered from the same package's\n# `dsh.client` declaration (see package.json).\n#\n# This row only starts the plugin. Wiring the obscura MCP server into the\n# harness is done from the plugin's settings page (\"Obscura\" -> \"一键配置 MCP\"),\n# which writes an `mcp-obscura` row into the profile's cordis.patch.yml.\n- insert:\n    - id: obscura-mcp-host\n      name: 'dsh-obscura-plugin'\n"
    }
