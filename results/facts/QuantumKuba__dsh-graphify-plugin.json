  "manifest": {
    "name": "dsh-graphify",
    "version": "0.2.1",
    "description": "Native Graphify knowledge graph plugin for DeepSeek Harness (DSH)",
    "keywords": [
      "deepseek",
      "deepseek-harness",
      "dsh",
      "dsh-plugin",
      "cordis",
      "graphify",
      "knowledge-graph",
      "code-intelligence",
      "mcp",
      "agent-tools"
    ],
    "license": "MIT",
    "author": "QuantumKuba",
    "repository": {
      "type": "git",
      "url": "git+https://github.com/QuantumKuba/dsh-graphify-plugin.git"
    },
    "bugs": {
      "url": "https://github.com/QuantumKuba/dsh-graphify-plugin/issues"
    },
    "homepage": "https://github.com/QuantumKuba/dsh-graphify-plugin#readme",
    "type": "module",
    "main": "lib/index.js",
    "types": "lib/types/index.d.ts",
    "exports": {
      ".": {
        "types": "./lib/types/index.d.ts",
        "default": "./lib/index.js"
      },
      "./client": {
        "types": "./lib/types/web-client.d.ts",
        "default": "./lib/graphify-client.js"
      },
      "./package.json": "./package.json"
    },
    "files": [
      "assets",
      "lib",
      "cordis.patch.yml",
      "README.md",
      "LICENSE"
    ],
    "engines": {
      "node": ">=22.18.0"
    },
    "packageManager": "pnpm@10.32.0",
    "dsh": {
      "bundle": {
        "patch": "./cordis.patch.yml"
      },
      "client": {
        "inject": [
          "@deepseek-ai/dsh-client-locale",
          "@deepseek-ai/dsh-client-ui-conversation",
          "@deepseek-ai/dsh-client-ui-primitives"
        ],
        "platform": "web"
      }
    },
    "scripts": {
      "clean": "rm -rf lib",
      "build": "tsc && tsdown",
      "test": "node --import tsx --test test/*.test.ts",
      "test:e2e": "node --import tsx --test test/graphify-e2e.test.ts",
      "test:drift": "node --import tsx --test test/schema-drift.test.ts",
      "typecheck": "tsc --noEmit",
      "prepublishOnly": "pnpm run clean && pnpm run build && pnpm test"
    },
    "dependencies": {
      "@deepseek-ai/schemastery": "^3.18.4",
      "@modelcontextprotocol/sdk": "^1.30.0"
    },
    "peerDependencies": {
      "@deepseek-ai/cordis": ">=4.0.4 <5"
    },
    "peerDependenciesMeta": {
      "@deepseek-ai/cordis": {
        "optional": true
      }
    },
    "devDependencies": {
      "@deepseek-ai/cordis": "^4.0.4",
      "@deepseek-ai/dsh-client-locale": "0.2.0-rc.2",
      "@deepseek-ai/dsh-client-ui-chat": "0.2.0-rc.2",
      "@deepseek-ai/dsh-client-ui-conversation": "0.2.0-rc.2",
      "@deepseek-ai/dsh-client-ui-primitives": "0.2.0-rc.2",
      "@deepseek-ai/dsh-client-ui-renderer": "0.2.0-rc.2",
      "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.2",
      "@deepseek-ai/dsh-commands": "0.2.0-rc.2",
      "@deepseek-ai/dsh-session": "0.2.0-rc.2",
      "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
      "@deepseek-ai/dsh-util-values": "0.2.0-rc.2",
      "@types/node": "^22.13.0",
      "@types/react": "~18.3.31",
      "react": "^18.3.1",
      "tsdown": "^0.22.14",
      "tsx": "^4.19.2",
      "typescript": "^5.7.3",
      "unrun": "^0.3.1"
    }
  },
  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "- insert:\n    - id: dsh-graphify\n      name: dsh-graphify\n      config:\n        autoDetect: true\n        enablePromptSection: true\n        timeoutMs: 60000\n"
    }
