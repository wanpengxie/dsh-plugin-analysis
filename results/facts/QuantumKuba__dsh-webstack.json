  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# Cordis patch layer for dsh-webstack (and dsh-advanced-web-search alias)\n# Configures ctx.web to use SearXNG and Scrapling, tunes tool-web bounds for local LLMs,\n# and mounts the provider bundle.\n\n- id: web\n  config:\n    searchProvider: searxng\n    fetchProvider: scrapling\n\n- id: tool-web\n  config:\n    fetch: true\n    searchTimeoutMs: 30000\n    searchMaxResults: 8\n    searchMaxQueries: 4\n    fetchMaxOutputChars: 50000\n\n- insert:\n    - id: dsh-webstack\n      name: dsh-webstack\n      config:\n        searxng:\n          baseURL: http://127.0.0.1:8080\n          timeoutMs: 15000\n        scrapling:\n          timeoutMs: 20000\n          maxRedirects: 5\n          maxResponseBytes: 5000000\n          enableDynamicFallback: true\n          enableStealthFallback: true\n          stealthSolveCloudflare: true\n          stealthHideCanvas: true\n          stealthBlockWebRtc: true\n          stealthAllowWebGl: true\n          stealthGoogleSearch: true\n          stealthBlockAds: true\n          stealthRealChrome: true\n          stealthTimeoutMs: 60000\n"
    }
  ],
