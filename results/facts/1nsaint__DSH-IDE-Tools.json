      "path": "cordis.patch.yml",
      "text": "# Meta-bundle: full IDE Tools suite (same inserts as installing each plugin).\n# Prefer individual packages à la carte when you only need one feature.\n# Do not also list these packages in dsh.profile.bundles if you install this meta package.\n- insert:\n    - id: dsh-ai-metrics\n      name: dsh-ai-metrics\n    - id: dsh-image-upload\n      name: dsh-image-upload\n    - id: dsh-archive\n      name: dsh-archive\n    - id: dsh-session-move\n      name: dsh-session-move\n    - id: dsh-files\n      name: dsh-files\n    - id: dsh-code-tab\n      name: dsh-code-tab\n    - id: web-search-router\n      name: dsh-web-search-router\n    - id: dsh-workspace-accent\n      name: dsh-workspace-accent\n    - id: dsh-sidebar-files\n      name: dsh-sidebar-files\n    - id: dsh-ssh-workspace\n      name: dsh-ssh-workspace\n    - id: dsh-workspace-sync\n      name: dsh-workspace-sync\n    - id: dsh-workspace-delete\n      name: dsh-workspace-delete\n    - id: dsh-git\n      name: dsh-git\n    - id: dsh-agent-review\n      name: dsh-agent-review\n    - id: dsh-live-write\n      name: dsh-live-write\n    - id: dsh-containers\n      name: dsh-containers\n    - id: dsh-torrent\n      name: dsh-torrent\n    - id: dsh-testenv\n      name: dsh-testenv\n    - id: dsh-automation-startup\n      name: dsh-automation/startup\n    - id: dsh-automation\n      name: dsh-automation\n    - id: dsh-automation-app\n      name: dsh-automation/app\n    - id: dsh-cron\n      name: dsh-cron\n    - id: dsh-terminal\n      name: dsh-terminal\n    - id: dsh-database\n      name: dsh-database\n    - id: dsh-browser\n      name: dsh-browser\n    - id: dsh-hero-tools\n      name: dsh-hero-tools\n    - id: dsh-settings-polish\n      name: dsh-settings-polish\n    - id: dsh-plugin-list-filter\n      name: dsh-plugin-list-filter\n    - id: dsh-ui-polish\n      name: dsh-ui-polish\n    - id: dsh-runtime-clock\n      name: dsh-runtime-clock\n    - id: dsh-split-view\n      name: dsh-split-view\n    - id: dsh-local-agent\n      name: dsh-local-agent\n    - id: dsh-mcp-manager\n      name: dsh-mcp-manager\n    - id: dsh-composer-dock\n      name: dsh-composer-dock\n\n\n# Web profile: Automation Worker/CLI app must not own the process (ProDesk same).\n- id: dsh-automation-startup\n  disabled: true\n- id: dsh-automation-app\n  disabled: true\n"
