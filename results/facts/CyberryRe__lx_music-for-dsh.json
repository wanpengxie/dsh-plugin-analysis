  "manifest": {
    "name": "lx-music-for-dsh",
    "version": "1.3.0",
    "description": "LX Music 增强控制插件：内置音源引擎（SDK 搜索 + 音源脚本隔离子进程）、侧边栏迷你播放卡（音量调节 + 播放模式切换）、滚动歌词（逐字卡拉OK，五平台歌词 + 音源脚本 lyric）、系统媒体控件（SMTC）元数据与媒体键、细粒度 LLM 音乐工具集、设置窗口音源管理。（实验性音乐画像默认关闭；安装/更新后请彻底退出并重启 DSH 才会生效，已知问题下个大版本修复）",
    "type": "module",
    "main": "lib/index.js",
    "types": "lib/types/index.d.ts",
    "exports": {
      ".": {
        "types": "./lib/types/index.d.ts",
        "default": "./lib/index.js"
      },
      "./client": {
        "types": "./lib/types/client.d.ts",
        "default": "./lib/client.js"
      },
      "./cordis.patch.yml": "./cordis.patch.yml",
      "./package.json": "./package.json"
    },
    "dsh": {
      "bundle": {
        "patch": "./cordis.patch.yml"
      },
      "client": {
        "platform": "web",
        "inject": [
          "@deepseek-ai/dsh-client-connection",
          "@deepseek-ai/dsh-client-locale",
          "@deepseek-ai/dsh-client-ui-renderer",
          "@deepseek-ai/dsh-api-remotes"
        ],
        "immediately": false
      }
    },
