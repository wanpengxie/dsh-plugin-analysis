    {
      "path": "cordis.patch.yml",
      "text": "# 两行组件：\n# - llm-antigravity-acp：官方 ACP 宿主（默认模式），不写入任何 agent-default-model row；\n# - antigravity-proxy-router：代理模式路由（默认关闭，proxyMode 开启后注册\n#   antigravity-proxy 并由宿主行注销 antigravity-acp，两者互斥）。\n- insert:\n    - id: llm-antigravity-acp\n      name: dsh-bundle-antigravity-host\n      inject: [llm, subprocess]\n    - id: antigravity-proxy-router\n      name: dsh-bundle-antigravity-host/proxy\n      inject: [llm, antigravityProxyAuth, antigravityProxyMode]\n"
    }
  ],
