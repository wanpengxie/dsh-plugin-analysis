  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# Bundle patch layered over the shipped base profile: take the native\n# web_search provider's seat in place.\n#\n# The plugin registers its provider as `deepseek-official`, the id the shipped\n# `web` row already selects with `searchProvider: deepseek-official`, so the\n# shared `web` row is left untouched. A patch replaces a row's whole config:\n# rewriting `searchProvider` alone would drop `fetchProvider: http` and leave\n# web_fetch to auto-selection, breaking fetch plugins such as\n# dsh-web-fetch-enhanced that rely on the shipped selection.\n#\n# DeepSeek Messages search registers the same id, so its row is disabled. Its\n# role is covered by this plugin's DeepSeek and model connections; disabling it\n# also hides the built-in Web search settings page, whose switch rewrites `web`\n# in the user layer. `web-deepseek-api` stays mounted: both selections remain\n# pinned, so its providers are reached only when a user selects them, and its\n# `deepseek-fetch-api` belongs to web_fetch, not to this plugin.\n- id: web-search-deepseek\n  disabled: true\n\n- insert:\n    - id: web-search-enhanced\n      name: dsh-web-search-enhanced\n      config:\n        # Zero-key default for new Sessions; never replaces a saved selection.\n        defaultConnection: builtin:exa\n"
    }
  ],
