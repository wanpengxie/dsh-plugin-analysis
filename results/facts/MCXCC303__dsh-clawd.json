  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# dsh-clawd bundle patch: one host row over the web profile.\n#\n# The row id is the plugin's identity everywhere in the Harness:\n#   * the settings namespace,\n#   * the `/plugins/<id>/client.js` served client bundle,\n#   * the `plugin_manager` entry id.\n# The name resolves from the profile's node_modules, where\n#   dsh plugin --profile web add link:/abs/path/dsh-clawd\n# installed this package.\n#\n# Every key below is a default for the plugin's own settings store; a value the\n# user changes in Settings -> Clawd wins over the value written here.\n- insert:\n    # The id is this plugin's identity inside the Harness (settings namespace,\n    # /plugins/<id>/), so it stays `dsh-clawd` across a rename of the package.\n    # The name is the module to resolve, and a scalar starting with @ must be\n    # quoted or the YAML is invalid.\n    - id: dsh-clawd\n      name: '@mcxcc303/dsh-clawd'\n      config:\n        enabled: true\n        theme: clawd\n        size: 64\n        sounds: false\n"
    }
  ],
