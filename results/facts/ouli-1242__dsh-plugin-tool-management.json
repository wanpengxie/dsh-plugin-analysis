  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# Install only this plugin. History composes the already active host services.\n# Do NOT disable workspace/session-projection-cache, insert competing service\n# providers, or infer capabilities from another package's name.\n# Existing explicit user-layer overrides remain the user's responsibility.\n#\n# Double-mount guard: inspect raw options only. Entry.disabled is a computed\n# getter and reading it from another disabled expression can recurse at boot.\n#\n# Why the IIFE + try/catch: this expression is evaluated by the host at EVERY\n# boot (`cordis-plugin-loader` Entry.disabledOf → evaluate → new Function+eval),\n# and that call chain has no protection of its own. It reads host-internal\n# shapes (ctx.loader.entries(), e.options.{id,name,disabled}), while the peer\n# range on cordis carries no upper bound — so an upstream shape change would\n# otherwise throw on the boot path, where the only outcomes are \"DSH does not\n# start\" or \"this row never mounts\". An error therefore means `false` (not\n# disabled → stay mounted), never a throw.\n#\n# The optional subagent spawn provider is resolved at runtime by the subagent\n# service; an unavailable optional package must not prevent the host from booting.\n- insert:\n    - id: dsh-plugin-tool-management\n      name: 'dsh-plugin-tool-management'\n      disabled: !!js \"(function () { try { return [...ctx.loader.entries()].some((e) => e.options.id !== 'dsh-plugin-tool-management' && e.options.name === 'dsh-plugin-tool-management' && e.options.disabled !== true && typeof e.options.disabled !== 'object') } catch (err) { return false } })()\"\n"
    }
  ],
  "entries": [
    "package.json",
    "cordis.patch.yml"
