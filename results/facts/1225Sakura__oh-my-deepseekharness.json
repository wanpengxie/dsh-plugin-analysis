  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# oh-my-dsh bundle patch: mounts the omd orchestration plugin into the host\n# composition of a dsh profile. The plugin registers the protocol section,\n# bilingual skills/role cards, /omd-doctor /omd-cancel commands and\n# omd_memory_* tools; the bundled MCP server (omd-state) is mounted\n# dynamically at runtime via cordis ctx.plugin() because a static patch\n# cannot express package-internal absolute paths (see spec §7-1).\n#\n# Install: `dsh plugin --profile <name> add @sakura12/oh-my-deepseekharness` (npm or a local path).\n- insert:\n    - id: oh-my-dsh\n      name: '@sakura12/oh-my-deepseekharness'\n"
    }
  ],
