  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# @lisonevf/dsh-qwen-image — host-side Cordis bundle patch.\n#\n# 这个文件是包的 `dsh.bundle.patch` 入口（见 package.json 的 `dsh.bundle.patch`）。\n# DSH 在启动时把它作为 cordis.patch.yml 层加载进 Loader，\n# 从而把 `@lisonevf/dsh-qwen-image` 注册成 Cordis entry（host 半）。\n#\n# 注入方案（官方槽位版）：\n#   host 半（lib/index.cjs）只做业务侧注册——\n#   工具面（ctx.tools）、worker 管理、webServer 同源路由、skills 注册，\n#   **不改动宿主任何文件**。\n#\n#   界面注入全部走官方槽位：\n#   browser 半（lib/client.js）用\n#   `ctx.slots.inject('tool.call.toolview', …)` 注册工具内联卡片，\n#   `ctx.slots.inject('conversation.view', …)` 注册「画室」视图标签页。\n#\n# 配置层（§4 全部可调，无硬编码）：每一处默认值都是用户大概率会保留的值，\n# 其余交给 schema 约束。用户可在自己 profile 的 cordis.patch.yml 覆盖本行。\n\n- insert:\n    - id: qwen-image\n      name: '@lisonevf/dsh-qwen-image'\n      config:\n        # —— 执行后端 ——\n        # diffusers（本地，默认）| openai-images（远端逃生，暂不实现）| comfyui（后置）\n        backend: 'diffusers'\n\n        # —— 权重目录 ——\n        # 默认 $DSH_HOME/models/Qwen-Image-2.1；想指向已有的一份权重就覆写这里\n        # modelDir: 'D:/models/Qwen-Image-2.1'\n        modelDir: '$DSH_HOME/models/Qwen-Image-2.1'\n\n        # —— Python ——\n        # 显式优先，其次 venv，最后 PATH；留空自动探测\n        pythonExe: ''\n\n        # —— 设备 / 精度 / 显存 offload ——\n        # auto：按 compute capability 与空闲显存决策\n        device: 'auto'\n        dtype: 'auto'\n        # none | model | sequential\n        offload: 'auto'\n\n        # —— 尺寸预设 ——\n        # draft(768²,12步) | standard(1024²,24步) | native(2048²,40步) | custom\n        preset: 'standard'\n        defaultSteps: 24\n        maxPixels: 1048576\n\n        # —— 输出 ——\n        # 默认 $DSH_HOME/dsh-qwen-image/outputs\n        outputDir: '$DSH_HOME/dsh-qwen-image/outputs'\n        keepAliveMinutes: 15\n\n        # —— Worker ——\n        maxConcurrent: 1\n        toolTimeoutMs: 1800000\n        workerPort: 0\n        routePrefix: '/api/qwen-image'\n\n        # —— 权重下载（代办）——\n        allowModelFetch: true\n        hfEndpoint: 'https://hf-mirror.com'\n        modelRepo: 'Qwen/Qwen-Image-2.1'\n        maxReferenceImages: 10\n\n        # —— 显存守卫 ——\n        lowVramGuardMiB: 1024\n"
    }
  ],
