  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# dsh bundle layer: mount the typed long-term memory plugin.\n#\n# `name` is resolved with `new URL(name, baseUrl)` by the Cordis loader, so a\n# bare package name and a relative/file URL both work — that is what lets the\n# development copy mount straight from the workspace with `--patch` before it\n# is ever installed into a profile.\n# Optional, both default to off/lexical:\n#\n#   config:\n#     conflictRanking: embedding      # rank the conflict window by cosine similarity\n#     embedding:\n#       apiKeyEnv: ZHIPU_API_KEY      # credential goes in ~/.dsh/.credentials.yaml\n#       model: embedding-3            # Zhipu BigModel; 0.5 CNY per million tokens\n#       dimensions: 512\n#\n# Turning it on sends the stored sentences to that provider. Measured 2026-09-29:\n# 3 sentences in one request took 305ms; a paraphrase scored 0.77 and an unrelated\n# sentence 0.53, so it is used to *rank* candidates, never as an absolute threshold.\n- insert:\n    - id: jev-memory\n      name: 'dsh-jev-memory'\n"
    }
  ],
