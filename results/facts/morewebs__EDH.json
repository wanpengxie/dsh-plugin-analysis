  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# EDH bundle patch — one row per thing EDH carries.\n#\n# The `edh` row is the shell: its module name is the bare package name, so the\n# browser half binds to it. It must stay enabled — disabling it would unload the\n# EDH control itself.\n#\n# Every other row is a feature: module names live under `@moreweb/edh/…`, which\n# is what the browser half scans for when it aggregates the master switch.\n# Turning a feature row off therefore never touches the shell or its UI.\n- insert:\n    - id: edh\n      name: '@moreweb/edh'\n      config: {}\n\n    # retry — unlimited retries of a failed model request inside the same turn.\n    - id: edh-retry\n      name: '@moreweb/edh/retry'\n      config: {}\n\n    # edit — edit a user message by forking just before it and seeding the fork's\n    # composer. The browser half reads this row's enablement to show the action.\n    - id: edh-edit\n      name: '@moreweb/edh/edit'\n      config: {}\n\n    # btw — open a side chat: a fork of this conversation, opened at once as its\n    # own row in the sidebar. The Host half is empty; the browser half adds the\n    # /btw and /side commands and reads this row's enablement before listing them.\n    - id: edh-btw\n      name: '@moreweb/edh/btw'\n      config: {}\n\n    # export — download the Session as Markdown. The row owns the Host download\n    # route; the browser half reads this row's enablement to show the button.\n    - id: edh-export\n      name: '@moreweb/edh/export'\n      config: {}\n\n    # update — update EDH itself from its published repo. The row owns the Host\n    # routes that check and apply; the browser half puts the action on EDH's own\n    # Plugin Manager page and reloads the new browser half in place.\n    - id: edh-update\n      name: '@moreweb/edh/update'\n      config: {}\n\n    # mcp — the MCP client. EDH keeps its own server list, speaks MCP from this\n    # half and registers the tools it discovers with the Harness, so a person\n    # adds a server in the UI instead of writing a Loader row into the profile.\n    - id: edh-mcp\n      name: '@moreweb/edh/mcp'\n      config: {}\n\n    # remote — the same Web GUI on a phone over the LAN. The row owns a listener\n    # of its own on 0.0.0.0 (the harness webserver refuses a wildcard bind), a\n    # login page, and the reverse proxy to the loopback GUI; the browser half\n    # carries the settings page.\n    - id: edh-remote\n      name: '@moreweb/edh/remote'\n      config: {}\n\n    # usage — token accounting across every stored Session: totals, per model,\n    # per local day. The row owns the route and a background scan of the\n    # Session logs, cached under the profile; the browser half draws the page.\n    - id: edh-usage\n      name: '@moreweb/edh/usage'\n      config: {}\n\n    # mobile — the web app manifest, and nothing else. The visible half of mobile\n    # (metas, stylesheet, manifest link) is injected into the live document by\n    # EDH's browser half, which already runs inside the page; this row only\n    # serves the manifest a phone needs a URL for.\n    - id: edh-mobile\n      name: '@moreweb/edh/mobile'\n      config: {}\n\n    # notify — the Windows sound files, and nothing else. A browser page cannot\n    # read C:\\Windows\\Media, so this row serves a curated few of the real system\n    # WAVs; the browser half owns the settings, the synthesised tones and the\n    # watcher that decides when to fire.\n    - id: edh-notify\n      name: '@moreweb/edh/notify'\n      config: {}\n\n    # search — full-text search across every stored Session, for the Ctrl+K\n    # palette. A blocking scan is out of the question (761 MB of plaintext, 7.5–15 s\n    # a pass), so this row keeps a derived, incrementally-built index under the\n    # profile and answers queries from memory; the browser half draws the palette.\n    - id: edh-search\n      name: '@moreweb/edh/search'\n      config: {}\n\n    # skills — a listing for the Skills settings tab, split by source. The row\n    # reads the Harness skill registry (never the filesystem: several skills ship\n    # inside the asar and have no path), scoped to a Session's preset, because the\n    # filesystem provider is mounted per preset and a bare list finds nothing.\n    - id: edh-skills\n      name: '@moreweb/edh/skills'\n      config: {}\n\n    # ask — \"which of my past conversations is about X?\", answered by the model\n    # over EDH's own search index. Two model calls (plan, then synthesise) around\n    # one memory scan, and no Session created or resumed: no `sessionId` is ever\n    # passed to the model service.\n    - id: edh-ask\n      name: '@moreweb/edh/ask'\n      config: {}\n\n    # Enter on an empty composer steers the first queued message. The gesture is\n    # the whole feature; the row exists so the switch can turn it off.\n    - id: edh-queue\n      name: '@moreweb/edh/queue'\n      config: {}\n"
    }
  ],
