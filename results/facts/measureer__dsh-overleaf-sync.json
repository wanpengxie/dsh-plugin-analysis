  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# dsh-overleaf-sync — bind a local LaTeX folder to an Overleaf project.\n#\n# This is the bundle default. A profile-level patch replaces this whole row\n# (`- id: overleaf-sync` + `config:`), so keep every non-default field you rely\n# on there — there is no deep merge.\n#\n#   dsh plugin --profile <name> add dsh-overleaf-sync\n#\n# After enabling, run `overleaf_login` once (paste the browser Cookie and CSRF\n# token — never your password), then `overleaf_projects` / `overleaf_link` /\n# `overleaf_pull`.\n- insert:\n    - id: overleaf-sync\n      name: dsh-overleaf-sync\n      config:\n        baseUrl: https://www.overleaf.com\n        localRootPattern: \"~/Overleaf/{project}\"\n        defaultStrategy: keep-both\n        watch:\n          autoStart: false\n          idleLeaveDocMs: 60000\n          maxOpenDocs: 20\n        git:\n          autoInit: true\n          autoCommit: false\n          initialCommitMessage: 'chore: import \"{project}\" from Overleaf'\n          includeBinaryInFirstCommit: false\n        journal:\n          enabled: true\n          keepDays: 7\n        confirmRemoteWrite: true\n        debug: false\n"
    }
  ],
