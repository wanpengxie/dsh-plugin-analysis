  "bundle": [
    {
      "path": "bridge/dsh/cordis.patch.yml",
      "text": "# interest-memory × DeepSeek Harness bundle patch.\n#\n# This is the `dsh.bundle.patch` layer declared in package.json. Installing\n# the package with `dsh plugin --profile <name> add @djasdh/interest-memory-dsh-bridge`\n# and mounting this bundle (or copying the row below into your profile's\n# cordis.patch.yml) registers the plugin row once; the last write wins per row,\n# so users can override `config` (baseUrl / agent / timeouts) in their own\n# profile patch.\n\n- insert:\n    - id: interest-memory\n      name: '@djasdh/interest-memory-dsh-bridge'\n      config:\n        baseUrl: http://127.0.0.1:8899\n        agent: dsh\n"
    }
  ],
