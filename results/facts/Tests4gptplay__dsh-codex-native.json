    {
      "path": "cordis.patch.yml",
      "text": "- insert:\n    - id: llm-codex-app-server\n      name: dsh-codex-native\n      config:\n        provider: codex-local\n        displayName: Codex (local login)\n        modelProvider: openai\n        models:\n          - id: gpt-6-astra\n            name: GPT-6-Astra\n            description: Our most capable model for complex, demanding work.\n            inputModalities: [text, image]\n            reasoningEfforts: [low, medium, high, xhigh, max, ultra]\n            defaultReasoningEffort: medium\n          - id: gpt-6.1-sol\n            name: GPT-6.1-Sol\n            description: Near-Astra performance for complex work at a lower cost.\n            inputModalities: [text, image]\n            reasoningEfforts: [low, medium, high, xhigh, max]\n            defaultReasoningEffort: medium\n          - id: gpt-5.6-sol\n            name: GPT-5.6-Sol\n            description: Reliable agentic workhorse for everyday tasks.\n            inputModalities: [text, image]\n            reasoningEfforts: [low, medium, high, xhigh, max, ultra]\n            defaultReasoningEffort: low\n          - id: gpt-5.6-terra\n            name: GPT-5.6-Terra\n            description: Balanced agentic coding model for everyday work.\n            inputModalities: [text, image]\n            reasoningEfforts: [low, medium, high, xhigh, max, ultra]\n            defaultReasoningEffort: medium\n          - id: gpt-5.6-luna\n            name: GPT-5.6-Luna\n            description: Fast and affordable agentic coding model.\n            inputModalities: [text, image]\n            reasoningEfforts: [low, medium, high, xhigh, max]\n            defaultReasoningEffort: medium\n          - id: gpt-5.5\n            name: GPT-5.5\n            description: Proven previous-generation model for coding and general work.\n            inputModalities: [text, image]\n            reasoningEfforts: [low, medium, high, xhigh]\n            defaultReasoningEffort: medium\n          - id: gpt-5.3-codex-spark\n            name: GPT-5.3-Codex-Spark\n            description: Ultra-fast coding model.\n            inputModalities: [text]\n            reasoningEfforts: [low, medium, high, xhigh]\n            defaultReasoningEffort: high\n        disposeGraceMs: 3000\n        maxJsonRpcLineBytes: 0\n        maxRequestImageBytes: 0\n        maxStderrBytes: 65536\n        maxRetries: 1\n        maxCachedSessions: 8\n        sessionIdleTimeoutMs: 600000\n"
    }
