  "manifest": {
    "name": "@xiguazhiprince/dsh-session-map",
    "version": "0.3.0",
    "description": "Session map: a turn-tree canvas over every DSH session — users' turns are nodes, sessions are coloured lines and tags, and forks leave from the exact inherited turn — as a Conversation tab and two right-sidebar tabs. Also adds Settings → Clone from Git, which clones a repository and registers the directory as a workspace, Settings → Skills, which lists user-level and project-level skills, a Conversation → Skills tab that lists the skills effective in the current session, and a Conversation → Instructions tab that lists, injects-order-labels, creates, edits, and deletes the AGENTS.md instruction files at the user roots and at every project directory level down to the session working directory, and a composer `BTW` button that forks the running session at its exact current progress into a read-only session (named `… · BTW` and marked with a bubble in its sidebar row) and switches the view to it",
    "type": "module",
    "license": "MIT",
