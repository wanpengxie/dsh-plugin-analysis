    {
      "path": "cordis.patch.yml",
      "text": "# JiuwenSwarm is the agent brain; DSH is Cordis ABI/shell only (ARCHITECTURE.md).\n# Default mode=gateway (override with JIUWEN_MODE=openai for diagnostics).\n#\n# Make the dsh agent (or any host agent-loop) select Jiuwen:\n#   - id: agent-default-model\n#     config: { provider: jiuwen, model: jiuwen-default }\n#\n- insert:\n    - id: llm-jiuwen\n      name: '@dsh-jiuwen/adapter'\n      config:\n        provider: jiuwen\n        displayName: JiuwenSwarm\n        mode: gateway\n        defaultModel: jiuwen-default\n        models:\n          - id: jiuwen-default\n            name: Jiuwen Default\n            contextWindow: 128000\n            maxTokens: 8192\n          - id: jiuwen-swarm\n            name: Jiuwen Swarm\n            contextWindow: 128000\n            maxTokens: 8192\n"
    }
  ],
