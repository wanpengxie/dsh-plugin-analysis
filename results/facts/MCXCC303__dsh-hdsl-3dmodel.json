  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# dsh-hdsl-3dmodel bundle patch: one host row over the web profile.\n#\n# The row id is the plugin's identity everywhere in the Harness:\n#   * the settings namespace,\n#   * the `plugin_manager` entry id.\n#\n# Every key under `config` is a DEFAULT for the plugin's own settings store,\n# written to $DSH_HOME/dsh-hdsl-3dmodel/settings.json: a value the user changes\n# in Settings -> 3D 摆件 wins over the value written here. The patch layer\n# replaces `config` wholesale rather than deep-merging it, so keep the whole\n# set of defaults here.\n#\n# It is deliberately NOT the package name below: the row id also decides the\n# data dir ($DSH_HOME/dsh-hdsl-3dmodel/) and the host route prefix, so renaming\n# the package must not move it. The only string that has to track the package\n# name is the browser entry id in lib/client.js — the client module table keys\n# bundles by package name and rejects a bundle that registers under another id.\n- insert:\n    - id: dsh-hdsl-3dmodel\n      name: @mcxcc303/dsh-hdsl-3dmodel\n      config:\n        enabled: true\n        # Height of the whole standing figure, in CSS pixels (1 skin pixel = size / 32).\n        size: 160\n        opacity: 1\n        # Starting pose id; see the POSES table in lib/client.js.\n        pose: idle\n        # The pose a right *click* strikes; `null` leaves the right button\n        # turning the camera and nothing else.\n        rightClickPose: wave\n        # Camera, in degrees. yaw 0 looks the figure in the face.\n        yaw: -20\n        pitch: 8\n        # Idle behaviour.\n        autoRotate: false\n        autoPose: true\n        # null = the default corner (bottom right, above the composer).\n        position: null\n"
    }
  ],
