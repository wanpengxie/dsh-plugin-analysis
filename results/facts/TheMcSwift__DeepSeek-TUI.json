  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# The dsh-tui-app bundle patch: the interactive terminal surface over dsh-base.\n# Mirrors the headless bundle: persona override, HMR off, tools mode, and the\n# startup + runner rows over the worker-thread code runtime.\n\n- id: system-prompt\n  config:\n    persona: >-\n      You are a coding agent powered by the {{model}} model. Your working directory is {{cwd}}.\n\n- id: hmr\n  disabled: true\n\n- id: tools\n  config:\n    mode: !!js process.env.DSH_TOOLS_MODE\n\n# Bundle-registered skill: the tui manual is self-describing content (the only\n# skill shipped by this bundle; see docs/BOUNDARY-DESIGN.md §6.2). The\n# expression resolves this bundle's own `skills/` dir from the profile's\n# node_modules layout (same resolution the loader uses for the bundle itself).\n- id: skill-filesystem\n  config:\n    customSkillDirs:\n      - !!js \"process.getBuiltinModule('node:path').dirname(process.getBuiltinModule('node:module').createRequire(new URL('package.json', ctx.baseUrl)).resolve('@mcswift/dsh-tui/package.json')) + '/skills'\"\n\n- insert:\n    - id: code-runtime\n      name: '@deepseek-ai/dsh-code-runtime-worker-thread'\n\n    - id: tui-startup\n      name: '@mcswift/dsh-tui/startup'\n\n    - id: tui-runner\n      name: '@mcswift/dsh-tui'\n      inject: [tuiStartup]\n      config:\n        resume: !!js ctx.tuiStartup.resume\n        model: !!js ctx.tuiStartup.model\n        workspace: !!js ctx.tuiStartup.workspace\n        regular: !!js ctx.tuiStartup.regular\n"
    }
  ],
