  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# The dsh-security bundle patch: the security-audit surface over dsh-base +\n# dsh-web-app. The bundle is one self-contained package — every row resolves\n# to a subpath of the bundle package itself, so the whole thing installs from\n# a single tarball via `dsh plugin add`.\n#\n# The patch contributes:\n# 1. the threat-model host row (provider + swarm + interview + command + UI);\n# 2. the vuln-scan host row (seam + stub + swarm + command + UI);\n# 3. the triage host row (seam + stub + swarm + command + UI);\n# 4. a preset-root row registering this package's read-only preset root.\n\n- insert:\n    - id: threat-model\n      name: dsh-security/threat-model-in-memory\n\n    - id: threat-model-swarm\n      name: dsh-security/threat-model-swarm\n\n    - id: threat-model-interview\n      name: dsh-security/threat-model-interview\n\n    - id: command-threat-model\n      name: dsh-security/command-threat-model\n\n    - id: ui-threat-model\n      name: dsh-security/ui-threat-model\n\n    - id: vuln-scan\n      name: dsh-security/vuln-scan\n\n    - id: vuln-scan-stub\n      name: dsh-security/vuln-scan-stub\n\n    - id: vuln-scan-swarm\n      name: dsh-security/vuln-scan-swarm\n      config:\n        targetDir: '.'\n\n    - id: command-vuln-scan\n      name: dsh-security/command-vuln-scan\n\n    - id: ui-vuln-scan\n      name: dsh-security/ui-vuln-scan\n\n    - id: triage\n      name: dsh-security/triage\n\n    - id: triage-stub\n      name: dsh-security/triage-stub\n\n    - id: triage-swarm\n      name: dsh-security/triage-swarm\n      config:\n        intent:\n          repo: '.'\n\n    - id: command-triage\n      name: dsh-security/command-triage\n\n    - id: ui-triage\n      name: dsh-security/ui-triage\n\n- insert:\n    - id: security-preset-root\n      name: dsh-security/preset-root\n"
    }
  ],
