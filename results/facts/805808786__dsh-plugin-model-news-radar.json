  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# 模型资讯雷达的默认配置。安装后在 DSH 的插件页改这些值，或在对话里让模型调 model_news_radar_configure。\n- insert:\n    - id: model-news-radar\n      name: dsh-plugin-model-news-radar\n      config:\n        enabled: true\n        period: daily          # daily / weekly / monthly\n        runAt: \"07:30\"\n        timeZone: Asia/Shanghai\n        weekday: 1             # weekly 时：0 周日 … 6 周六\n        monthDay: 1            # monthly 时：1–28\n        tiers: [A, B]          # A 前沿旗舰 / B 主力 / C 区域或专项 / D 观察\n        vendors: []            # 填厂商 id 就只盯这些家\n        sourcesPath: \"\"        # 留空：~/.dsh/model-news-radar/sources.json，没有就用自带示例清单\n        summarize: true        # 采集后起一个 DSH 会话写摘要\n        language: zh\n        catchUp: true\n"
    }
  ],
