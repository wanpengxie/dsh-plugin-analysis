  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# dsh-qq-bot bundle patch: one insert row carrying the whole plugin config.\n# Cordis 插件 id 仍是 qq-bridge（与上游兼容）。界面显示名仍是 dsh-qq-bot。\n# name 是 Node 用来加载插件的包名，必须等于实际安装的 npm 包。\n# 无作用域的 dsh-qq-bot 发不出去；写成那个名字时 Cordis 解析不到模块，\n# qq-bridge 不会挂上，/api/qq-bridge/settings 就是 HTTP 404。\n# 用户在 profile 的 cordis.patch.yml 里按 id 覆盖这一行；patch 会替换整份 config，\n# 所以要保留的键请全部重述。覆盖里如果写了 name，也要写成同一个包名。\n- insert:\n    - id: qq-bridge\n      name: '@fengye_nobug/dsh-qq-bot'\n      config:\n        # 固定目标会话：QQ 的一切都注入这一个会话（保留其上下文）。\n        # 留空表示不驱动任何会话。\n        targetSessionId: ''\n        # 可选：resume 目标会话时挂载的 agent preset（留空则沿用会话 header 里记录的）。\n        agentPreset: ''\n        # 状态文件（最近聊天缓冲 + 唤醒日志 + 出站目的地）。留空 = $DSH_HOME/qq-bridge-state.json\n        statePath: ''\n        # 注册 qq_bridge_status / qq_bridge_send / qq_bridge_transport / qq_bridge_simulate\n        # 四个调试工具（排障用，正式环境可关）。\n        debugTools: true\n\n        # ── M2：OneBot 传输（NapCat / go-cqhttp）─────────────────────────────\n        # NapCat 的“正向 WebSocket”地址；**留空 = 完全不启用传输**（默认安全）。\n        onebotUrl: ''\n        # 存放 access_token 的**凭据引用名**（就是一个环境变量名），不要明文写 token。\n        # 它会经 ctx.credentials 解析（进程环境 → 凭据存储 → .env），每次建连重新解析。\n        # 设置方式见 README「配置」。细节在 DESIGN.md「配置 access_token」。\n        accessTokenEnv: ''\n        # 机器人自己的 QQ 号；留空则连上后自动调 get_login_info 获取。\n        selfId: ''\n        # 回复时引用触发的那条消息（[CQ:reply]）。\n        replyWithQuote: false\n        # 群里只有被 @ 才处理（比概率唤醒更严的一道闸门）。\n        atOnlyInGroup: false\n        # 出站前去掉 Markdown 标记（QQ 不渲染，留着只是噪音）。\n        stripMarkdown: true\n        # 多久没有任何 WS 流量就判定连接已死并重连。\n        heartbeatTimeoutMs: 90000\n\n        # ── M5：NapCat 自助托管（“一键包”体验，但不真打包）─────────────────────\n        # 注意：这些只是**参数**。插件加载时绝不会去下载或执行任何东西，\n        # 一切动作都要靠显式调用 qq_bridge_napcat 工具触发。\n        # NapCat 安装目录；留空 = $DSH_HOME/napcat\n        napcatInstallDir: ''\n        # 对外可打开的 NapCat WebUI。留空 = 读 webui.json（通常是 127.0.0.1，只在跑 NapCat 的机器上打得开）。\n        napcatWebuiUrl: ''\n        # 要装的版本 tag（如 v4.18.28）；留空 = 最新\n        napcatVersion: ''\n        # 下载用的 HTTP 代理。**本机直连 GitHub 不通**，走代理才行，例如\n        # http://127.0.0.1:7890；留空 = 读 HTTPS_PROXY/HTTP_PROXY/ALL_PROXY 环境变量。\n        downloadProxy: ''\n        # 写进 NapCat 配置、并用来连的正向 WS 端口\n        onebotPort: 3001\n        # 快速登录用的 QQ 号（需先用 QQ 手动成功登录过一次）\n        qqNumber: ''\n\n        # 会话怎么分：single = 所有群共用 targetSessionId；perGroup = 每个群/私聊各一条。\n        sessionScope: single\n        # 每个会话最多保留的最近轮数。0 = 不限制。\n        maxRecentTurns: 40\n        # ↓ 以下几项是 settings 命名空间 qq-bridge 的默认值（设置界面可覆盖）\n        nicknames: ['244', '小助手']\n        # 非昵称消息的唤醒概率（5%）\n        wakeProbability: 0.05\n        # ⚠️ 白名单 fail-closed：留空表示任何来源都不能唤醒会话。\n        # 正式使用时填入实际的 QQ openid。\n        whitelist: []\n        groupWhitelist: []\n        # 哪些 QQ 号能在 QQ 里用「白名单」命令改群白名单。留空 = 谁都不能用。\n        ownerWhitelist: []\n        # 启动时向 GitHub 检查一次有没有新版本。默认关。只写日志，不自动安装。\n        checkUpdateOnStart: false\n"
    }
  ],
