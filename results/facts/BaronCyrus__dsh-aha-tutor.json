  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# 开窍 · AI 私人老师 (dsh-aha-tutor)\n#\n# 1. The plugin's host row: tutoring services, the browser channel and the\n#    upload / speech routes.\n# 2. A conversation preset \"AI 私人老师\": a patient tutor persona with\n#    read-only file tools, web search and the plugin's teaching tools\n#    (whiteboard, quiz, course, cheat sheet, learner profile). Compaction\n#    stays so long tutoring sessions keep working. No shell, no file writes.\n- insert:\n    - id: aha-tutor\n      name: 'dsh-aha-tutor'\n    - id: preset-aha-tutor\n      name: '@deepseek-ai/dsh-agent-preset'\n      config:\n        id: aha-tutor\n        name: 开窍 · AI 私人老师\n        description: 一对一讲解：白板板书与语音、随堂小测、定制课程与速查表。只读文件，可联网搜索。\n        order: 15\n        plugins:\n          - id: persona\n            name: '@deepseek-ai/dsh-persona'\n            config:\n              prefix: |-\n                You are Aha (开窍), a patient and brilliant private tutor powered by {{model}}.\n                Your goal is real understanding, not answers handed over.\n                - First find out what the learner already knows and why they want to learn it; ask briefly when unsure.\n                - Teach one idea at a time: intuition first, then precision, then a worked example.\n                - Check understanding often with a quick question, and adapt to the reply.\n                - Reply in the learner's language. Keep chat answers short when the whiteboard does the teaching.\n                - For homework, guide with hints and questions; give full solutions only after the learner has tried.\n          - id: time-context\n            name: '@deepseek-ai/dsh-time-context'\n          - id: tool-fs\n            name: '@deepseek-ai/dsh-tool-fs'\n            config:\n              read: true\n              readImage: true\n              write: false\n              edit: false\n          # DSH 0.2.1-rc.3 requires this setting and gives it no default; its\n          # own presets keep the first paths, as rc.2 did.\n          - id: tool-fs-search\n            name: '@deepseek-ai/dsh-tool-fs-search'\n            config:\n              sampleOverCapGlobResults: false\n          - id: tool-web\n            name: '@deepseek-ai/dsh-tool-web'\n            config:\n              search: true\n              fetch: true\n          - id: tool-ask-user\n            name: '@deepseek-ai/dsh-tool-ask-user'\n          - id: compaction\n            name: cordis:group\n            group: true\n            isolate:\n              compaction: true\n              toolResultPruner: true\n            config:\n              - id: compaction-basic\n                name: '@deepseek-ai/dsh-compaction-basic'\n              - id: command-compact\n                name: '@deepseek-ai/dsh-command-compact'\n              - id: tool-result-pruner\n                name: '@deepseek-ai/dsh-compaction-tool-result-pruner'\n                config:\n                  thresholdChars: 8192\n                  headChars: 4096\n                  tailChars: 1024\n          - id: aha-tutor-tools\n            name: 'dsh-aha-tutor/agent'\n"
    }
  ],
