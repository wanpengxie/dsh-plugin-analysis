  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# dsh-live2d bundle: mount the host half (config route) and the browser\n# half (the bottom-corner Live2D widget) in one row.\n#\n# The row's `name` is the package itself: the host Loader resolves the Node\n# half through `exports[\".\"]` (lib/index.mjs), while the client-modules node\n# half scans this entry for `dsh.client` and serves the browser half\n# (exports[\"./client\"], lib/client.js) into window.__DSH_BOOT__.\n#\n# Users override these values either in the Web settings (Live2D section) or\n# in their profile's own cordis.patch.yml by id (a patch replaces the WHOLE\n# row config, so restate every key you keep).\n- insert:\n    - id: live2d\n      name: 'dsh-live2d'\n      config:\n        enabled: true\n        modelUrl: 'https://model.hacxy.cn/Mao/Mao.model3.json'\n        width: 280\n        height: 360\n        offsetX: 12\n        offsetY: 12\n        anchor: 'right'\n        scale: 1\n        opacity: 1\n        zIndex: 9999\n        draggable: true\n        volume: 0\n        logLevel: 'warn'\n"
    }
  ],
