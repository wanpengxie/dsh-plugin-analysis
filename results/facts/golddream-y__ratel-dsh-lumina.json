  "manifest": {
    "name": "@ratel-works/dsh-lumina",
    "version": "1.2.0",
    "description": "Make development more fun. A subtle layer of motion for DeepSeek Harness, with customizable visual effects and reduced-motion support.",
    "license": "MIT",
    "type": "module",
    "main": "./lib/index.js",
    "types": "./lib/types/index.d.ts",
