  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# dsh-academic-toolkit bundle patch.\n# Mounts the personal academic toolkit. All tools/effects are owned by lib/index.js;\n# removing this row (or uninstalling the bundle) removes every contribution.\n#\n# Fill in your own local paths / school before use:\n#   chromeProfileDir  - a dedicated Chrome profile dir that keeps your CARSI login\n#   papersDir         - where downloaded PDFs go\n#   schoolName        - your school's full name (used to pick it in the CARSI portal)\n#   idpEntityId       - optional; leave empty to auto-detect from the CARSI portal\n- insert:\n    - id: academic-toolkit\n      name: 'dsh-academic-toolkit'\n      config:\n        # Local Chrome started with --remote-debugging-port=9222 (see scripts/start-chrome.ps1).\n        browserEndpoint: 'http://127.0.0.1:9222'\n        chromePath: 'C:/Program Files/Google/Chrome/Application/chrome.exe'\n        chromeProfileDir: 'D:/chrome-debug'\n        papersDir: 'D:/papers'\n        # Optional proxy for the Antigravity/Gemini OCR path.\n        proxy: ''\n        ocrModel: 'gemini-3.8-flash-high'\n        # Poppler pdftotext; empty = search PATH.\n        pdftotextPath: ''\n        profileNodeModules: ''\n        ocrMaxPages: 10\n        schoolName: ''\n        idpEntityId: ''\n"
    }
