  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# Cordis patch for `dsh-document-selection-ask`.\n#\n# One row inserts the package itself. The row is a bare plugin by package name:\n# the host half (`exports \".\"`) runs in the host process, and the `dsh.client`\n# declaration in `package.json` makes the browser half (`exports \"./client\"`,\n# served as the plugin's `client.js`) load in the web GUI and call\n# `applyClient(ctx)` on the client context.\n#\n# That browser half is the whole activation surface today, and this patch is\n# still one insert row of one entry. On the client context `applyClient`\n# registers four extension renderers — PDF, DOCX, PPTX and XLSX — through the\n# public `ctx.documentPreviews.register` service. The builtin TXT, Markdown,\n# code and CSV previews are not replaced: this plugin registers only the four\n# formats DSH's own preview service does not render. The Ask surface is\n# contributed through the `shell.overlay` slot and the composer target through\n# the `conversation.input.overlay` slot; none of those registrations is a patch\n# entry, and disabling the plugin disposes them and leaves the builtin previews\n# intact.\n- insert:\n    - id: document-selection-ask\n      name: 'dsh-document-selection-ask'\n"
    }
  ],
