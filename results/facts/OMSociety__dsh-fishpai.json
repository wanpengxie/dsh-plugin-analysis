  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# DSH bundle layer: mount the host plugin that registers the fishpai tools,\n# the /fishpai/api routes, and the bundled `fishpai` skill.\n#\n# `name` is the module specifier DSH imports (the vendor/loader resolves\n# `options.name`), so it must be the published package name, not the repo name.\n# The same package also declares its browser half through `dsh.client` +\n# `exports[\"./client\"]`, which the client module loader serves as one bundle.\n- insert:\n    - id: fishpai\n      name: dsh-fishpai\n"
    }
  ],
