  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# The @dsh-yzj/bundle patch layer: mounts the Yunzhijia bridge, tool family,\n# model defaults, and the browser surface over the base + web-app layers.\n# robot-yzj / memory-yzj 已彻底退役删除（决策 53，2026-08-25）：包、RPC、卡片、\n# 工具全无——机器人通道/记忆库/话题功能面不再存在；恢复只能从 git 历史重建。\n# All rows resolve into this single monobundle package via\n# its exports subpaths; @deepseek-ai/* come from the registry. Deployments override\n# per-row config in their own cordis.patch.yml (an id-targeted patch replaces the\n# whole config).\n- insert:\n    # Host channel to the yzj-cli binary (spawns it directly, reusing the\n    # machine's yzj-cli login state; the harness never sees credentials).\n    - id: yzj-bridge\n      name: '@dsh-yzj/bundle/bridge'\n\n    # Model-facing tools over the bridge; destructive operations confirm\n    # through yzj/confirm-request (write-gate answers; not harness ask).\n    - id: tool-yzj\n      name: '@dsh-yzj/bundle/tool-yzj'\n\n    # Browser surface: /yzj RPC channel (node half) + rich tool cards and the\n    # workspace panel (browser half via the dsh.client declaration; the\n    # closure bundle ships as ./client). The Loader name is the package root so\n    # 0.1.2 client-modules treats the row as a package (subpaths are not\n    # scanned) and the graph id matches the handoff id `@dsh-yzj/bundle`.\n    - id: ui-yzj\n      name: '@dsh-yzj/bundle'\n\n    # Plugin-wide default model route ($DSH_HOME/yzj-model.json): the fallback\n    # of the robot model-resolution chain and the dream executor (ctx.yzjModels).\n    - id: model-yzj\n      name: '@dsh-yzj/bundle/model-yzj'\n"
    }
  ],
  "entries": [
    "lib/ui-yzj.mjs",
