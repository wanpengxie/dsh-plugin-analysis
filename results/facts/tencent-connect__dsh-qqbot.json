  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# dsh-im-qqbot bundle patch\n#\n# 当本包通过 `dsh plugin --profile <name> add @tencent-connect/dsh-qqbot` 安装后，\n# dsh 启动时自动加载此 patch。\n#\n# 环境变量：\n#   QQBOT_APPID  - QQ Bot AppID（必填）\n#   QQBOT_SECRET - QQ Bot AppSecret（必填）\n#\n# 叠加顺序：dsh-base → 本 bundle patch → profile cordis.patch.yml → --patch\n\n# ── 插入 im-qqbot 插件行 ──\n- insert:\n    - id: im-qqbot\n      name: '@tencent-connect/dsh-qqbot'\n      config:\n        appId: __FROM_ENV__\n        appSecret: __FROM_ENV__\n        # provider/model 留空：从宿主默认模型路由继承\n        # 用户可通过 /model 命令在聊天中切换\n        requireMention: true\n        textChunkLimit: 4500\n        sessionIdleTimeout: 1800000\n        maxQueue: 20\n        processingTimeoutMs: 1800000\n        historyLimit: 10\n        debug: false\n"
    }
  ],
