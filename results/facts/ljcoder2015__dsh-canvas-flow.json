  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# dsh-canvas bundle: mount the host plugin under its package name.\n#\n# The host half opens the `dsh-canvas` storage domain and needs a routed storage\n# backend, so it is inserted after the storage domain consumer (order 100).\n# Override the Config defaults from src/index.ts by adding a `config` block:\n#   - insert:\n#       - id: 'dsh-canvas-flow'\n#         name: 'dsh-canvas-flow'\n#         config:\n#           workspaceRoot: ./canvas\n#           arrangeGap: 88\n#\n# `name` is the module specifier resolved in the profile — the package name — and\n# `id` is the instance id a patch layer targets. Both follow the package name\n# (docs 技术文档 §三「改名时必须同步的位置」); the short `dsh-canvas` word the\n# logs and prompt sections use is a label (`src/host/prompt.ts` `PLUGIN_ID`), not\n# this identity.\n- insert:\n    - id: 'dsh-canvas-flow'\n      name: 'dsh-canvas-flow'\n"
    }
  ],
