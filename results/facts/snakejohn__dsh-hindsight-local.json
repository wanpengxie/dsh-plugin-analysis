  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# dsh-hindsight-memory —— bundle patch layer.\n# Mounts this plugin into the DSH profile tree.\n# Config values here are the persisted defaults; every key can also be overridden\n# through environment variables (see README \"环境变量\" table) or through the\n# external JSON config file (`config.file`).\n- insert:\n    - id: dsh-hindsight-memory\n      name: dsh-hindsight-memory\n      config:\n        setup: unset              # unset | existing (attach only) | local (slim + pg0, plugin starts it) — the web panel's wizard writes this\n        enabled: true\n        service:\n          mode: auto              # auto | attach | local | docker | process | compose (setup overrides)\n          base_url: http://127.0.0.1:8888\n          autostart: true\n          keep_alive_on_exit: false\n          local:                  # used when setup: local (mode: local)\n            runner: auto          # auto (venv -> uvx -> pip -> docker) | venv | uvx | pip | docker\n            venv_dir: \"\"          # empty = ~/.dsh-hindsight/venv\n            variant: auto         # auto | slim (no local models, ~500MB) | full\n            version: 1.1.0\n            port: 8888\n            database_url: pg0://dsh-hindsight\n            hf_endpoint: \"\"       # e.g. https://hf-mirror.com (full variant only)\n            install_timeout_ms: 1800000\n          health_path: /health\n          request_timeout_ms: 8000\n          startup_timeout_ms: 300000\n          retry_degraded_ms: 30000\n          retry_interval_ms: 1500\n          shutdown_grace_ms: 5000\n          docker:\n            container: hindsight\n            image: ghcr.io/vectorize-io/hindsight:latest\n            port: 8888\n            cp_port: 9999\n            restart_policy: unless-stopped\n            bind_host: 127.0.0.1\n            volume: hindsight-data\n            shm_size: 1g\n        bank:\n          default_bank: ''\n          name_template: 'dsh-{slug}-{hash}'\n          workspace_bank_mapping: {}\n          prefix_match: true\n        # 模型通道（仅当本插件自己拉起 Hindsight 时映射成服务端 env 生效）\n        embedding:\n          provider: ''\n          base_url: ''\n          api_key: ''\n          model: ''\n          dimensions: 0\n          batch_size: 0\n        reranker:\n          enabled: true\n          provider: ''\n          base_url: ''\n          api_key: ''\n          model: ''\n          top_n: 6\n          score_threshold: 0.25\n        llm:\n          provider: ''\n          base_url: ''\n          api_key: ''\n          model: ''\n          temperature: 0.2\n          max_tokens: 1024\n          context_window: 32768\n        recall:\n          enabled: true\n          budget: mid\n          max_tokens: 1200\n          max_chars: 4000\n          top_n: 6\n          score_threshold: 0.25\n        retain:\n          enabled: true\n          async: true\n          max_turns_per_batch: 8\n        prune:\n          enabled: false\n          keep_recent_turns: 6\n          trigger_after_turns: 12\n        logging:\n          level: info\n"
    }
  ],
