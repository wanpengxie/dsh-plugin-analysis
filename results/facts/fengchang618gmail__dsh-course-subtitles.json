  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# dsh-course-subtitles - course/video subtitles -> bilingual Feishu docs\n#\n# `dsh plugin add` applies this patch to the profile, inserting the plugin into\n# the Cordis composition. The `id` is the row identity used by the loader - it\n# must stay `dsh-course-subtitles` so this file and scripts/activate.js produce\n# exactly the same row and never add a duplicate.\n#\n# A bare `- id:` row only *overrides* an existing entry and is silently ignored,\n# so the row must be written as an `insert:` list.\n- insert:\n    - id: dsh-course-subtitles\n      name: 'dsh-course-subtitles'\n"
    }
  ],
