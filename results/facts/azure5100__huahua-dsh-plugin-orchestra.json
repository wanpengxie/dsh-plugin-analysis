      "path": "cordis.patch.yml",
      "text": "# huahua-dsh-plugin-orchestra bundle patch: mounts the plugin-orchestra host\n# half (inventory / updater / install + Typert Remote, namespace\n# pluginOrchestra) into the profile composition. The dsh client-module\n# scanner discovers the dsh.client manifest and serves lib/client.js into the\n# browser, where the client half self-mounts the remote face and registers the\n# settings entry (S1 §7 / S3 §5). Row order carries no load semantics.\n#\n# Install: `dsh plugin --profile <name> add huahua-dsh-plugin-orchestra`\n# (npm or a local path). The `dsh plugin` command pnpm-installs the package\n# into the profile and reconciles it into the profile's dsh.profile.bundles\n# layer list.\n- insert:\n    - id: plugin-orchestra\n      # Node-resolvable package name — must stay in sync with package.json\n      # `name`. Quoted because `@` is a reserved indicator in YAML and cannot\n      # open a plain scalar.\n      name: huahua-dsh-plugin-orchestra\n      config:\n        # T0 骨架：唯一持久数据目录（S1 §13——config.json / backups/ / cache/\n        # / logs/ 均在此下；实际解析与展开由 S2 实现任务填充）。\n        dataDir: '~/.dsh/plugin-orchestra'\n"
    }
