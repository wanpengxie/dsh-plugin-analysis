  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# KnowLP-RAG bundle patch for DeepSeek Harness (dsh)\n#\n# Install (npm):\n#   dsh plugin add \"@eqman00003/knowlp-rag\"\n# Install (github source):\n#   dsh plugin add \"github:wly8691-jpg/knowlp-rag#main\"\n#\n# Prerequisites: Node 18+ and Python 3.11+. On first search bin/knowlp-mcp.mjs bootstraps\n# a Python env in ~/.knowlp-dsh/venv (mcp + pyyaml, ~30s).\n#\n# 2026-08-15 P0 fix: cwd/env used to inject DSH_HOME/KNOWLP_VAULT via !!js expressions —\n# on machines without those env vars they evaluated to empty string/undefined, and dsh\n# 0.1.0-rc.6's zod validation (env: z.dict(String)) rejected them → dsh web crashed on\n# startup (KnowLP is a preinstalled bundle of the official default profile, so every\n# fresh install broke). Both optional fields are now omitted entirely (schema defaults\n# env={} / cwd=\"\"), and npx resolves the published package from the npm registry.\n# vault config: users add env.KNOWLP_VAULT in their profile's cordis.patch.yml\n# (template: dsh/knowlp.cordis.local.example.yml), or set a system env var.\n#\n# bundle patches must use insert form for new entries (a bare entry is treated as\n# \"modify existing\", erroring with patch: entry \"knowlp-mcp\" not found — reproduced 2026-08-14)\n- insert:\n    - id: knowlp-mcp\n      name: '@deepseek-ai/dsh-mcp-client'\n      config:\n        serverName: knowlp\n        transport: stdio\n        command: npx\n        args:\n          - '--yes'\n          - '--package'\n          - '@eqman00003/knowlp-rag'\n          - 'knowlp-mcp'\n        toolCallTimeoutMs: 60000\n        failOnStartupError: false\n"
    }
  ],
