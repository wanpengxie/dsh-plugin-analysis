  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# dsh-phocinae bundle patch — mounts the local Phocinae decision layer.\n#\n# Layer order: this bundle patch, then the profile patch, then\n# $DSH_HOME/cordis.patch.yml, then --patch overlays; later layers win.\n# Every key below has a documented default in lib/config.mjs, so this file can be\n# reduced to `enabled: true` and the plugin still works.\n- insert:\n    - id: phocinae\n      name: dsh-phocinae\n      config:\n        # Local Phocinae decision service. Loopback is enforced: the decision\n        # state carries raw tool-call text, so a remote endpoint is a load-time\n        # error unless `allowRemoteEndpoint: true` is set deliberately.\n        endpoint: http://127.0.0.1:8155/v1/systemone\n        model: Phocinae-Largha-150M-v1\n        # CPU single-thread inference is ~1.5 s; 3 s covers a full request.\n        timeoutMs: 3000\n        # Confidence below this marks an answer `escalate: true`. This is the\n        # model release's frozen E1 value and is an escalation SIGNAL, not a\n        # token-saving claim — see the README's measured table.\n        escalateAt: 0.6\n        # Cap on the rendered decision state, in characters.\n        maxStateChars: 4096\n        # Ask the server to permutation-average choice questions (4x forwards).\n        permuteChoice: false\n        gate:\n          enabled: true\n          # harm      = \"how harmful is this command?\" harmless/risky/destructive\n          #             (default; measured recall 0.97 on destructive commands)\n          # tri-state = allow / ask / deny (measured recall 0.74)\n          # noul      = the original boolean \"should this be blocked?\" question\n          #             (measured recall 0.00 — it passed every destructive command)\n          # off       = no local screening\n          mode: harm\n          # noul mode only: P(risky) at or above this reads as a positive signal.\n          threshold: 0.8\n          # An `allow` verdict below this confidence becomes a review instead of\n          # passage. Measured: the model's tri-state allow-confidence runs\n          # 0.27-0.54, so this bar is deliberately low; see README\n          # \"Measured behaviour\" before raising it.\n          minConfidence: 0.45\n          # Commands passed locally without asking the model. Entries containing\n          # a shell operator are refused at load time. Set to [] to screen every\n          # command through the model (expect a review for nearly all of them).\n          autoAllow:\n            - 'git status'\n            - 'git log'\n            - 'git diff'\n            - 'git branch'\n            - 'git fetch'\n            - 'Get-ChildItem'\n            - 'Get-Content'\n            - 'Test-Path'\n            - 'Select-String'\n            - 'npm test'\n            - 'npm ci'\n            - 'python -m pytest'\n            - 'go test'\n            - 'cargo build'\n          # Exact tool names, `*` wildcards, or `*` for every tool. The default\n          # covers every platform: the shell tool is `pwsh` on Windows and `bash`\n          # elsewhere, and MCP servers add their own names.\n          tools:\n            - '*'\n          # closed = an unreachable decision service asks a human (recommended).\n          # open   = an unreachable decision service allows the call.\n          failMode: closed\n          # What a confident risky verdict does: deny, or ask.\n          riskyDecision: deny\n          # Log every verdict through the host logger.\n          audit: true\n"
    }
  ],
