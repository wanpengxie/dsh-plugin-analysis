      "typecheck": "tsc --noEmit",
      "benchmark": "node tools/benchmark-plugin.mjs && node tools/benchmark-performance.mjs",
      "test:performance": "node tools/test-performance.mjs",
      "setup": "node scripts/dsh-plugin.mjs install",
      "doctor": "node scripts/dsh-plugin.mjs doctor",
      "audit:public": "node scripts/audit-public.mjs",
      "test:exchange": "node tools/test-exchange.mjs",
      "desktop:install": "npm --prefix desktop ci",
      "desktop:start": "npm --prefix desktop start",
      "desktop:build": "npm --prefix desktop run build",
      "test:desktop": "node tools/test-desktop.mjs && node tools/test-web-navigation.mjs && node tools/test-persistence.mjs",
      "test:platform": "node --test tools/test-platform.mjs tools/test-web-navigation.mjs tools/test-harness-update.mjs tools/test-holidays.mjs tools/test-exchange.mjs tools/test-persistence.mjs"
    },
