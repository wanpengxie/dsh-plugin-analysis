      "preview": "node tools/preview-server.mjs",
      "preview:whale": "node experiments/whale-lab/server.mjs",
      "link": "node scripts/dsh-plugin.mjs install",
      "unlink": "node scripts/dsh-plugin.mjs uninstall",
      "reinstall": "node scripts/dsh-plugin.mjs install",
      "rename": "node tools/rename.mjs",
