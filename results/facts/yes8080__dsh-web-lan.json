  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# dsh-web-lan bundle layer — applied automatically when the package is added\n# with `dsh plugin --profile web add dsh-web-lan` (the dsh plugin command\n# reconciles any dependency that declares dsh.bundle into the profile's\n# bundle stack). No manual cordis.patch.yml editing needed.\n#\n# The row replaces only the webserver row's `config` (dsh-web-app owns the\n# row's name/inject); `insert` adds the lan-access plugin row. The password\n# defaults to '123' and can be overridden with the DSH_LAN_PASSWORD\n# environment variable; once logged in it can also be changed from\n# 设置 → 插件 → 插件配置 (persisted, survives restarts).\n\n- id: webserver\n  config:\n    host: '0.0.0.0'\n    port: !!js ctx.webStartup.port ?? 3080\n\n- insert:\n    - id: lan-access\n      name: 'dsh-web-lan'\n      config:\n        password: !!js process.env.DSH_LAN_PASSWORD ?? '123'\n"
    }
  ],
