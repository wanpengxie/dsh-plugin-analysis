  "manifest": {
    "name": "dsh-lan-web-access",
    "version": "0.1.9",
    "description": "DeepSeek Harness（dsh）局域网 Web 访问插件：局域网 / 异地组网里多台设备同时访问同一台 dsh；允许列表 + 管理密码，本机与 SSH 隧道免 token，Desktop 与 Web 通用。",
    "type": "module",
    "main": "lib/index.js",
    "types": "lib/types/index.d.ts",
    "exports": {
      ".": {
        "types": "./lib/types/index.d.ts",
        "default": "./lib/index.js"
      },
      "./client": {
        "types": "./lib/types/client/index.d.ts",
        "default": "./lib/client.js"
      },
      "./cordis.patch.yml": "./cordis.patch.yml",
      "./package.json": "./package.json"
    },
    "files": [
      "lib",
      "src",
      "cordis.patch.yml",
      "README.md"
    ],
    "scripts": {
      "typecheck": "tsc --noEmit",
      "lint": "eslint src/ tests/",
      "format": "prettier --write \"src/**/*.{ts,tsx}\" \"tests/**/*.ts\"",
      "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"tests/**/*.ts\"",
      "build": "node -e \"require('node:fs').rmSync('lib', { recursive: true, force: true })\" && tsc -p tsconfig.json && tsdown",
      "bundle": "tsdown",
      "dev": "npm run build && dsh web",
      "test": "vitest run",
      "prepack": "npm run typecheck && npm run lint && npm test && npm run build"
    },
