  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# dsh-miloco-bridge — bundle patch layer.\n#\n# 两半架构：\n#\n#   1. dsh-miloco-bridge —— 全局 infra 半边。负责：\n#        - POST /miloco/webhook         Miloco 主动推送的落点\n#        - /dsh-miloco-bridge/api/*     Web 设置页数据与写入\n#        - 一键部署 / 连接已有 Miloco\n#      这些能力必须全局常驻，与当前使用哪个 Agent 无关。\n#\n#   2. dsh-miloco-bridge/tools —— 只挂在专用 Agent 预设「miloco」里。\n#      设备/感知/规则/任务/身份/档案/通知等工具与全部技能都只属于这个预设，\n#      普通会话看不到任何 miloco_* 工具，也不会被注入 miloco 技能。\n#\n# 推送目标的运行时选择（会话 / 模型）写在 ~/.dsh/miloco-plugin.json；\n# 连接信息（baseUrl / token）也写在这里，因此「连接已有 Miloco」立即生效，\n# 不必重启 DSH。\n- insert:\n    - id: dsh-miloco-bridge\n      name: 'dsh-miloco-bridge'\n      config:\n        # 默认只读：写工具根本不注册，模型看不到也不会误触真实设备。\n        readOnly: true\n        # 留空 = 自动读取 $MILOCO_HOME/config.json 的 server.url / server.token。\n        baseUrl: \"\"\n        token: \"\"\n        home: \"~/.miloco\"\n        timeoutMs: 30000\n        # 留空 = $DSH_HOME/miloco-plugin.json / $DSH_HOME/miloco-plugin.state.json\n        overlayFile: \"\"\n        stateFile: \"\"\n        # 可选：写 profile patch 的绝对路径；留空则只写运行时 overlay。\n        profilePatch: \"\"\n        push:\n          enabled: true\n          path: \"/miloco/webhook\"\n          # 留空 = 回退到运行时 overlay 里的 push.token；两者都空则拒绝所有入站请求。\n          token: \"\"\n          waitForResult: true\n          target:\n            # 空 = 投到「上一次触发 miloco 的会话」。\n            sessionId: \"\"\n            # 新建推送会话时使用的 Agent 预设。\n            agentPreset: \"miloco\"\n          model:\n            # 空 = 跟随目标对话自己选的模型；provider+model 都填才覆盖。\n            provider: \"\"\n            model: \"\"\n            reasoningEffort: \"\"\n          perception:\n            # all / low / medium / high：低于该等级的感知建议不投递到 DSH。\n            # 规则、任务、onboarding、普通对话事件不带 urgency，始终放行。\n            minLevel: \"all\"\n        deploy:\n          repo: \"https://github.com/XiaoMi/xiaomi-miloco\"\n          # 一键部署下载官方 release install.sh，不再 clone 源码。\n          # 留空 = $DSH_HOME/plugin-data/dsh-miloco-bridge/xiaomi-miloco\n          # （release 部署不创建该目录；仅保留给旧源码部署/卸载清理）\n          sourceDir: \"\"\n          # --skip-openclaw 阻止上游安装 OpenClaw 插件；--agent-platform=openclaw\n          # 只用于通过上游非交互式平台检测，实际由 DSH adapter 接管。\n          installArgs: [\"--skip-openclaw\", \"--agent-platform=openclaw\", \"--lang=zh\"]\n          # 直连 GitHub 失败时按顺序尝试这些镜像（直接拼接原 URL）。\n          githubMirrors:\n            - \"https://gh-proxy.com/\"\n            - \"https://gh-proxy.org/\"\n          # release 包默认从第一个镜像下载；留空 = 自动拼接 releases/download。\n          downloadSite: \"\"\n          # 额外的 uv 索引，不覆盖用户默认索引；PyPI 带 upload-time 元数据，\n          # 部分国内镜像缺少该元数据会触发安装器 exclude-newer 解析失败。\n          uvIndex: \"https://pypi.org/simple\"\n        # 设置页里不展示任何「DSH 默认模型」配置项。模型下拉只有\n        # 「跟随该对话」+ 实际模型；不选模型就完全不动会话的模型选择。\n    # ------------------------------------------------------------------\n    # 专用 Agent 预设：只有选了它的会话才拿到米家工具与技能。\n    # ------------------------------------------------------------------\n    - id: preset-miloco\n      name: '@deepseek-ai/dsh-agent-preset'\n      config:\n        id: miloco\n        name: Miloco 家庭助手\n        description: >-\n          家里的全屋智能管家：米家工具与技能隔离在这个预设中，能看设备、问摄像头、查档案与用量。\n        order: 30\n        plugins:\n          - id: dsh-miloco-bridge-tools\n            name: 'dsh-miloco-bridge/tools'\n            config:\n              readOnly: true\n              baseUrl: \"\"\n              token: \"\"\n              home: \"~/.miloco\"\n              timeoutMs: 30000\n              # 留空 = $DSH_HOME 下的运行时文件，与全局半边共用\n              overlayFile: \"\"\n              stateFile: \"\"\n              cwd: \"\"\n          # 保留标准 DSH Agent 的工具面；子插件只在 miloco 预设内生效。\n          - id: tool-bash\n            name: '@deepseek-ai/dsh-tool-bash'\n            disabled: !!js process.platform === 'win32'\n          - id: tool-pwsh\n            name: '@deepseek-ai/dsh-tool-pwsh'\n            disabled: !!js process.platform !== 'win32'\n          - id: tool-fs\n            name: '@deepseek-ai/dsh-tool-fs'\n          - id: tool-fs-search\n            name: '@deepseek-ai/dsh-tool-fs-search'\n            config:\n              sampleOverCapGlobResults: false\n          - id: tool-jobs\n            name: '@deepseek-ai/dsh-tool-jobs'\n          - id: tool-schedule\n            name: '@deepseek-ai/dsh-tool-schedule'\n          - id: skill-filesystem\n            name: '@deepseek-ai/dsh-skill-filesystem'\n          - id: tool-skill\n            name: '@deepseek-ai/dsh-tool-skill'\n          - id: command-goal\n            name: '@deepseek-ai/dsh-command-goal'\n          - id: tool-goal\n            name: '@deepseek-ai/dsh-tool-goal'\n          - id: tool-ask-user\n            name: '@deepseek-ai/dsh-tool-ask-user'\n          - id: tool-todo\n            name: '@deepseek-ai/dsh-tool-todo'\n            config:\n              allowParallelInProgress: true\n          - id: tool-web\n            name: '@deepseek-ai/dsh-tool-web'\n            config:\n              fetch: true\n              searchTimeoutMs: 60000\n          - id: present\n            name: '@deepseek-ai/dsh-tool-present'\n          - id: delegation\n            name: cordis:group\n            group: true\n            isolate:\n              workflowEngine: true\n            config:\n              - id: tool-subagent-control\n                name: '@deepseek-ai/dsh-tool-subagent-control'\n              - id: tool-subagent\n                name: '@deepseek-ai/dsh-tool-subagent'\n                config:\n                  provider: spawn\n                  toolName: subagent\n                  modelSelection: true\n                  modelDiscovery: true\n              - id: tool-subagent-fork\n                name: '@deepseek-ai/dsh-tool-subagent'\n                config:\n                  provider: fork\n                  toolName: subagent_fork\n              - id: workflow-ptc\n                name: '@deepseek-ai/dsh-workflow-ptc'\n                config:\n                  provider: spawn\n              - id: tool-workflow\n                name: '@deepseek-ai/dsh-tool-workflow'\n"
    }
  ],
