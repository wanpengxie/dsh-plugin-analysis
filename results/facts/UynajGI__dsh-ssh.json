  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# The dsh-ssh bundle patch: SSH remote development over the dsh-web-app layer.\n#\n# Rows here are overridden by the profile's own cordis.patch.yml and any\n# --patch overlays, so a deployment can retune or disable any of them.\n#\n# - The aggregate `ssh-remote` row mounts ctx.ssh / ctx.subprocess / ctx.fs and\n#   makes the client bundle scannable. Its connection is a placeholder: nothing\n#   connects lazily — real remote work happens on registry connections created\n#   in the web UI and persisted to ~/.dsh/dsh-ssh-connections.json.\n# - The default host directory picker is disabled because dsh-ssh's client UI\n#   (sidebar + browser, plus the native system chooser) takes over the whole\n#   add-workspace flow.\n\n# 关闭默认 -auto picker（它动态挂载的界面随行一起消失）\n- id: directory-picker\n  name: '@deepseek-ai/dsh-host-directory-picker-auto'\n  disabled: true\n\n- insert:\n    # ctx.ssh / ctx.subprocess / ctx.fs 三个远程 provider（占位连接，懒建立）\n    - id: ssh-remote\n      name: dsh-ssh\n      config:\n        host: 127.0.0.1\n        port: 22\n        username: ssh\n        cwd: /tmp\n\n    # 本机/远程目录 browse 后端\n    - id: directory-picker-ssh\n      name: dsh-ssh/picker\n      config:\n        maxEntries: 1000\n\n    # 多连接注册表 + /dsh-ssh RPC（持久化、连接管理、远程目录浏览）\n    - id: ssh-web-channel\n      name: dsh-ssh/web\n      config:\n        maxEntries: 1000\n"
    }
  ],
