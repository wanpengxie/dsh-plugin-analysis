  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# dsh-blender-mcp-bridge — DSH bundle patch\n#\n# The entry has the same id as the package name so the profile can target it\n# with per-key overrides. The values below are the bundled defaults: they seed\n# the plugin's own settings files on first run (DSH_HOME/dsh-blender-mcp-bridge/\n# connection.json, snapshot.json, safety.json, task.json, helper.json) and are\n# not the runtime source of truth after that. The settings page edits the JSON\n# files; profile overrides are ignored once those files exist.\n- insert:\n    - id: dsh-blender-mcp-bridge\n      name: dsh-blender-mcp-bridge\n      config:\n        host: 127.0.0.1\n        port: 9876\n        maxConcurrentSends: 5\n        connectTimeoutMs: 5000\n        responseTimeoutMs: 30000\n        captureTimeoutMs: 30000\n        renderTimeoutMs: 120000\n        maxResponseChars: 200000\n        taskRootMode: blendFile\n        taskRoot: ''\n        snapshot:\n          enabled: true\n          generations: 3\n          on: adaptive\n          everyWrites: 10\n          onDestructive: true\n          compress: true\n          timeoutMs: 120000\n        guard:\n          enabled: true\n        helper:\n          basePython: ''\n          pipIndexUrl: ''\n          timeoutMs: 120000\n          maxOutputChars: 200000\n          enableMaintenanceHelpers: false\n        audit:\n          enabled: true\n          storeCode: false\n"
    }
  ],
