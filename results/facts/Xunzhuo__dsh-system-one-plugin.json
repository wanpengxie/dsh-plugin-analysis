  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# System Duo for DeepSeek Harness: System One (decision models) on the agent loop, and System Two, the free LLM\n# vllm-sr/auto from vLLM Semantic Router, both at app.vllm-sr.ai with one key fetched on first use. A model chosen in\n# the app's settings still wins, and a profile patch can replace either row.\n- insert:\n    - id: system-one\n      name: '@vllm-sr/dsh'\n\n- id: llm-pi-ai\n  config:\n    providers:\n      vllm-sr:\n        displayName: System Duo (vLLM Semantic Router)\n        apiKeyEnv: VLLM_SR_API_KEY\n        api: openai-completions\n        baseURL: https://app.vllm-sr.ai/v1\n        compat:\n          supportsDeveloperRole: false\n          maxTokensField: max_tokens\n        timeoutMs: 600000\n        models:\n          - id: vllm-sr/auto\n            name: vllm-sr/auto\n            # the router sends a request that carries an image to its vision decision, tool calls and all\n            input: [text, image]\n            contextWindow: 131072\n            maxTokens: 32768\n\n- id: agent-default-model\n  config:\n    provider: vllm-sr\n    model: vllm-sr/auto\n"
    }
  ],
