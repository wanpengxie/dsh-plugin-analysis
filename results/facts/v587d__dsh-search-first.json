  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# dsh-search-first bundle patch\n#\n# Installed through the official CLI:\n#\n#   dsh plugin --profile web add <this package>\n#\n# The command reconciles `dsh.profile.bundles` against installed packages and,\n# seeing the `dsh.bundle.patch` declaration, appends `dsh-search-first` to the\n# bundle stack. The profile boot then merges THIS patch (a single `insert` of\n# the plugin row) exactly like a manual cordis.patch.yml mount line.\n#\n# Every value below is a *default*: the Settings → Search First page (runtime\n# user layer) and the `search-first` settings namespace can override each\n# field. Per-provider keys are credential refs resolved via ctx.credentials\n# (values live in $DSH_HOME/.credentials.yaml or the environment).\n- insert:\n    - id: dsh-search-first\n      name: 'dsh-search-first'\n      config:\n        defaultEnabled: true\n        injectMode: 'rewrite'\n        queryExtraction:\n          provider: ''\n          model: ''\n          timeoutMs: 120000\n          maxTokens: 384\n        cache:\n          dir: ''\n          searchTtlSec: 3600\n          fetchTtlSec: 86400\n        limits:\n          maxSearchResults: 64\n          maxFetchPages: 16\n          maxInjectChars: 12800\n        onSearchFailure: 'continue'\n        overallTimeoutMs: 20000\n        engine:\n          searchMode: 'sequential'\n          providers:\n            - id: tavily\n              enabled: true\n              apiKeyEnv: TAVILY_API_KEY\n              priority: 10\n            - id: anysearch\n              enabled: true\n              apiKeyEnv: ANYSEARCH_API_KEY\n              priority: 20\n            - id: tinyfish\n              enabled: true\n              apiKeyEnv: TINYFISH_API_KEY\n              priority: 30\n          fallbackToWeb: true\n          fetchLocalHttpFallback: true\n          providerTimeoutMs: 8000"
    }
  ],
