  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# dsh-tui is a terminal surface over the shared Harness base bundle. The\n# startup provider owns command-line parsing; the runtime owns the root agent\n# and terminal lifecycle.\n\n- insert:\n    - id: code-runtime\n      name: '@deepseek-ai/dsh-code-runtime-worker-thread'\n\n    # Match WebUI's durable workspace registry so archive state and session\n    # visibility are shared between both surfaces.\n    - id: storage\n      name: '@deepseek-ai/dsh-storage'\n\n    - id: storage-json\n      name: '@deepseek-ai/dsh-storage-json'\n      config:\n        root: !!js dshHomePath('storages')\n\n    - id: storage-domain\n      name: '@deepseek-ai/dsh-storage-domain'\n      config:\n        backend: json\n\n    - id: workspace\n      name: '@deepseek-ai/dsh-workspace'\n\n    # Read the same cheap conversation summaries as WebUI. This lets the\n    # chooser suppress abandoned zero-turn sessions without loading logs.\n    - id: session-stats\n      name: '@deepseek-ai/dsh-session-stats'\n\n    - id: session-projection-cache\n      name: '@deepseek-ai/dsh-session-projection-cache'\n      config:\n        writeEveryEvents: 200\n        writeIntervalMs: 5000\n\n    - id: tui-startup\n      name: 'dsh-tui/startup'\n\n    - id: tui-runtime\n      name: 'dsh-tui'\n      inject: [tuiStartup]\n      config:\n        initialPrompt: !!js ctx.tuiStartup.initialPrompt\n        globalSession: !!js ctx.tuiStartup.globalSession\n        sessionId: !!js ctx.tuiStartup.sessionId\n"
    }
  ],
