      "path": "cordis.patch.yml",
      "text": "# dsh-ticktick bundle patch: inserts the plugin row into the profile roster.\n# Applied as a profile bundle layer (declared by the `dsh.bundle.patch`\n# manifest field in package.json). Activate with:\n#\n#   # local development (link)\n#   dsh plugin --profile web add link:/path/to/dsh-ticktick\n#   # after publishing to GitHub (repo tagged with the `dsh-plugin` topic)\n#   dsh plugin --profile web add github:zhengjy01/dsh-ticktick\n- insert:\n    - id: ticktick\n      name: dsh-ticktick\n      config:\n        announceToAgent: true   # 在系统提示中公告插件（工具 + 能力说明）\n        enabled: true           # 插件总开关\n"
    }
