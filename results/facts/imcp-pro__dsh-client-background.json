  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# The dsh bundle patch for this external client plugin.\n#\n# Installed with `dsh plugin --profile web add <this-package>`; the layer\n# inserts one `dsh.client` row into the Web composition. The package's own\n# `dsh.client` manifest (in package.json) is what the client-modules scan reads\n# to serve its browser half.\n- insert:\n    - id: ui-background\n      name: '@imcp-pro/dsh-client-background'\n"
    }
