  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# Host-plane PPT runtime. Model-facing tools are mounted only by the `ppt` preset.\n- insert:\n    # Headless 0.1.1-rc.2 has no preset roster. The entry-level injection makes\n    # this row activate only when the headless launcher supplies its startup\n    # service; Web keeps using the preset roster already owned by its bundle.\n    - id: ppt-headless-agent-presets\n      name: '@deepseek-ai/dsh-agent-presets'\n      inject: [headlessStartup]\n      disabled: !!js >-\n        !(process.argv.includes('--profile=headless') ||\n        process.argv.some((value, index) => value === 'headless' &&\n        process.argv[index - 1] === '--profile'))\n      config:\n        default: ppt\n    - id: ppt\n      name: '@yejiming/dsh-ppt'\n\n# Disable the stock headless runner when present, then add a PPT-aware runner.\n# On Web the inserted runner waits for the absent headless-only service and\n# DSH's native Web preset flow remains.\n- id: headless-runner\n  disabled: true\n- insert:\n    - id: ppt-headless-runner\n      name: '@yejiming/dsh-ppt/headless'\n      inject: [headlessStartup]\n      disabled: !!js >-\n        !(process.argv.includes('--profile=headless') ||\n        process.argv.some((value, index) => value === 'headless' &&\n        process.argv[index - 1] === '--profile'))\n      config:\n        task: !!js ctx.headlessStartup.task\n        presetId: ppt\n"
    }
  ],
