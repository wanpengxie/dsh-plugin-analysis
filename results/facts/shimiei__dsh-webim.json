  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# dsh-webim bundle patch\n#\n# 插入一个宿主侧插件：在本机另开一个端口（默认 0.0.0.0:3081），\n# 用它作为「远程入口」——带令牌的链接（设置页里出二维码/可复制）直接登录，\n# 口令作为备用方式；登录后把 DSH Web 前端原样代理给远端浏览器，\n# 请求全部转给本机正在运行的 Harness（同一套 API / WebSocket / 会话），\n# 并额外提供远程可用的本地文件访问与路径链接转换。\n#\n# 前端 UI 完全沿用 DSH 自带的那一套（同一个 index、同一套插件 bundle），\n# 这里不另做界面；“另外做”的是入口鉴权、同源桥接、路径/文件适配。\n#\n# 改这里之后需要重启宿主才会生效。默认关闭口令入口，只用令牌链接进入\n# （要恢复口令入口就把 password 设成非空字符串，例如 '换成强口令'）。\n# 令牌默认自动生成并保存在 $DSH_HOME/webim/token.json，可在 设置 → 远程接入 里刷新。\n- insert:\n    - id: dsh-webim\n      name: 'dsh-webim'\n      config:\n        enabled: true\n        # 对外的监听地址。0.0.0.0 = 所有网卡（由路由器把 3081 转发进来）。\n        host: '0.0.0.0'\n        port: 3081\n        # 备用进入口令。'' = 关闭口令入口（只认令牌链接 / 二维码），\n        # 填非空字符串则同时保留 http://<公网地址>:3081 的口令登录页。\n        password: ''\n        # 固定入口令牌。留空 = 自动生成并持久化，可在设置页刷新；\n        # 填了则以此为准，设置页里的「刷新令牌」会被禁用。\n        accessToken: ''\n        # 登录状态保持天数\n        sessionDays: 30\n        # 会话绑定：'ua' = 只对当时扫码的那台浏览器有效（默认），\n        # 'off' = 旧行为，任何拿到 cookie 的客户端都能进\n        sessionBind: 'ua'\n        # 失败锁定：10 分钟内失败 8 次，锁定 15 分钟\n        maxFailures: 8\n        failureWindowMinutes: 10\n        blockMinutes: 15\n        # 设备配对码的有效期（天）。0 = 永久有效；在设置页生成时会写进 pairing.json\n        pairDays: 30\n        # 允许通过 /__webim/fs 浏览的根目录；空数组 = 不限制（仍受 deniedPaths 约束）\n        allowedRoots: []\n        # 额外的禁止路径（不区分大小写的前缀匹配）\n        deniedPaths: []\n        # 把聊天里出现的本地绝对路径变成可点击的远程文件链接\n        linkifyPaths: true\n        # 记录每个代理请求（排障用，默认关闭）\n        logRequests: false\n        # 现成的 cloudflared 路径；留空 = 用 $DSH_HOME/webim/cloudflared 里自动下载的那份\n        tunnelBinary: ''\n        # false = 不自动下载 cloudflared（离线 / 受控网络下先手动放好）\n        tunnelAutoInstall: true\n        # 运行时开关的首启默认值；改完在 设置 → 远程接入 里即时生效（写 webim/features.json）\n        features:\n          enabled: true\n          lan: true\n          public: true\n          mobileUi: true\n          tunnel: false\n          fileBrowser: true\n          linkifyPaths: true\n          pill: true\n"
    }
  ],
