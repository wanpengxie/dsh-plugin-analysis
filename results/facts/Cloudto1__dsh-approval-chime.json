      "@deepseek-ai/dsh": "^0.2.0-rc.2"
    }
  },
  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# dsh-approval-chime bundle patch.\r\n#\r\n# Inserts this package's own row into the profile's root entry list. A bundle's\r\n# patch layer is applied when the profile lists the bundle in\r\n# `dsh.profile.bundles` (dsh-app-boot reads `dsh.bundle.patch` from this\r\n# package's package.json), so this file is the ONLY place that inserts this id.\r\n#\r\n# Do NOT insert the same id again from the profile's own cordis.patch.yml:\r\n# every layer's patches are merged into one array and handed to the root group\r\n# in a single update, and the rows are keyed BY ID — so a later layer's row\r\n# silently REPLACES this one and the insert here never takes effect.\r\n# (DSH 0.1.7 changed this: through 0.1.6 a duplicate id threw\r\n# `duplicate loader entry id: dsh-approval-chime` and broke the boot.\r\n# Same advice, different reason — see docs/契约调研.md 勘误 rev-28.)\r\n# To disable this plugin temporarily, patch by id instead:\r\n#   - id: dsh-approval-chime\r\n#     disabled: true\r\n- insert:\r\n    - id: dsh-approval-chime\r\n      name: dsh-approval-chime\r\n"
    }
  ],
  "entries": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "package.json"
  ],
