    {
      "path": "cordis.patch.yml",
      "text": "# Bundle patch layer for dsh-project-context.\n#\n# Four host plugins sharing one settings namespace:\n#   - project-context:  session archives + .agents/memory/session-logs/INDEX.md (no model calls)\n#   - project-memory:   consolidation into .agents/memory/{CONTEXT.md,MEMORY.md} + injection\n#   - project-autolearn: low-frequency skill distillation into .agents/skills/<name>/SKILL.md\n#   - project-handoff:  context-pressure handoff into a fresh session + .agents/memory/HANDOFF.md\n- insert:\n    - id: project-context\n      name: dsh-project-context\n    - id: project-memory\n      name: dsh-project-context/memory\n    - id: project-autolearn\n      name: dsh-project-context/autolearn\n    - id: project-handoff\n      name: dsh-project-context/handoff\n"
    }
  ],
