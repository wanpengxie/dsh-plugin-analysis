  "readme": [
    {
      "section": "dsh-skill-commands",
      "text": "Smarter slash-command matching for DSH skills.\n\nThe stock slash source matches skill names literally. This plugin registers a smart skill-matching slash source in the browser with suffix / contains / alias matching — for example `/studio` finds `autonomous-studio`.\n\nThe host half is an empty mount so the bundle loads cleanly; the behavior ships via `exports[\"./client\"]`."
    },
    {
      "section": "Install",
      "text": "Install it from the **DSH Plugin Market** (Settings → Plugin Market), or add it to your profile bundle stack manually — see `cordis.patch.yml`. Prebuilt; no build step required."
    },
    {
      "section": "License",
      "text": "MIT"
    }
