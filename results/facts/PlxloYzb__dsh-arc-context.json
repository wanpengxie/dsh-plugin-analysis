  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# dsh Web bundle patch: mount the host-plane ARC preset bridge.\n#\n# This is what makes the package installable via `dsh plugin --profile web add\n# dsh-arc-context` (declared in package.json as `dsh.bundle.patch`). The\n# bridge registers the ARC engine as a loader builtin and, on every\n# agent/created, swaps the mounted preset's official compaction-basic row for\n# the ARC engine row inside the same isolate realm — through official\n# Include patch semantics, with zero file writes. The preset file, isolation\n# map, /compact command, and pruner stay intact; uninstall (or a restart\n# without the package) remounts the untouched original composition.\n- insert:\n    - id: compaction-arc-bridge\n      name: 'dsh-arc-context/bridge'\n      config:\n        adaptiveGovernor:\n          enabled: true\n          maxOutputTokens: auto\n          safetyMarginTokens: 32768\n          nudgeAtEffectiveCapacityPct: 0.75\n          emergencyAtEffectiveCapacityPct: 0.90\n          emergencyFallback: true\n"
    }
  ],
  "entries": [
