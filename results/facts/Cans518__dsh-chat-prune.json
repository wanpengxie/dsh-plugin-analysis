  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# dsh-chat-prune bundle patch\n#\n# 一行挂载：host 半注册 /dsh-chat-prune/* 路由，client 半在会话列表上浮出删除按钮。\n#\n# 通过 package.json 的 dsh.bundle.patch 作为 bundle layer 加载。\n#\n# 注意：配置写在这里、不要写在 profile 的 patch 层。profile 的 patch 按 id 定位行，\n# 而 insert 出来的行在 patch 阶段还不存在，会刷\n#   patch: entry \"dsh-chat-prune\" not found\n# 的无害但难看的告警。\n\n- insert:\n    - id: dsh-chat-prune\n      name: 'dsh-chat-prune'\n      config:\n        # 默认不备份。备份是整目录 copy，大会话会白占一份等量磁盘。\n        # 想要可回滚就改成 true，删掉的东西会进\n        #   $DSH_HOME/deleted-sessions/<时间戳>/<sessionId>/\n        backup: false\n        # 兼容开关：true 只绕过附着检查，仍不能越过持久化写所有权。\n        # 默认拒绝运行/附着的会话；保留 false。\n        allowRunning: false\n        # 按钮图标（保留字段）\n        icon: 'trash'\n"
    }
  ],
