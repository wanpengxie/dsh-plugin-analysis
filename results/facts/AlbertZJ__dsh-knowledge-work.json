  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "- insert:\n    - id: dsh-knowledge-work\n      name: cordis:group\n      group: true\n      config:\n        # One row per upstream role plugin. Each row is its own Loader entry, so the\n        # Plugins page switches roles independently; enabling the bundle keeps all of\n        # them on until someone turns a role off. Rows name this package's role\n        # subpath, so Node resolution finds the installed code from the profile.\n        - id: dsh-knowledge-work-bio-research\n          name: dsh-knowledge-work/bio-research\n        - id: dsh-knowledge-work-cowork-plugin-management\n          name: dsh-knowledge-work/cowork-plugin-management\n        - id: dsh-knowledge-work-customer-support\n          name: dsh-knowledge-work/customer-support\n        - id: dsh-knowledge-work-data\n          name: dsh-knowledge-work/data\n        - id: dsh-knowledge-work-design\n          name: dsh-knowledge-work/design\n        - id: dsh-knowledge-work-engineering\n          name: dsh-knowledge-work/engineering\n        - id: dsh-knowledge-work-enterprise-search\n          name: dsh-knowledge-work/enterprise-search\n        - id: dsh-knowledge-work-finance\n          name: dsh-knowledge-work/finance\n        - id: dsh-knowledge-work-human-resources\n          name: dsh-knowledge-work/human-resources\n        - id: dsh-knowledge-work-legal\n          name: dsh-knowledge-work/legal\n        - id: dsh-knowledge-work-marketing\n          name: dsh-knowledge-work/marketing\n        - id: dsh-knowledge-work-operations\n          name: dsh-knowledge-work/operations\n        - id: dsh-knowledge-work-pdf-viewer\n          name: dsh-knowledge-work/pdf-viewer\n        - id: dsh-knowledge-work-product-management\n          name: dsh-knowledge-work/product-management\n        - id: dsh-knowledge-work-productivity\n          name: dsh-knowledge-work/productivity\n        - id: dsh-knowledge-work-sales\n          name: dsh-knowledge-work/sales\n        - id: dsh-knowledge-work-small-business\n          name: dsh-knowledge-work/small-business\n        # Partner-built plugins from upstream. Each needs its vendor's connector\n        # (Apollo, Common Room, Slack, Zoom); turn a row off to drop its skills.\n        - id: dsh-knowledge-work-apollo\n          name: dsh-knowledge-work/apollo\n        - id: dsh-knowledge-work-brand-voice\n          name: dsh-knowledge-work/brand-voice\n        - id: dsh-knowledge-work-common-room\n          name: dsh-knowledge-work/common-room\n        - id: dsh-knowledge-work-slack\n          name: dsh-knowledge-work/slack\n        - id: dsh-knowledge-work-zoom-plugin\n          name: dsh-knowledge-work/zoom-plugin\n"
    }
