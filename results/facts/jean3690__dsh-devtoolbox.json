  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# dsh-devtoolbox bundle patch: mounts the dual-face toolbox plugin row into the\n# web profile roster. The node half (exports \".\") runs in the host process\n# (/toolbox command + agent tool registration + file tools); the `dsh.client`\n# declaration in package.json makes the browser half (exports \"./client\",\n# served at /plugins/<id>/client.js) load in the web GUI.\n#\n# Activate with: dsh plugin --profile web add link:/home/jean/program/dsh-toolbox\n- insert:\n    - id: dsh-devtoolbox\n      name: dsh-devtoolbox\n      config:\n        # Agent-visible tools (deterministic utilities the model can call in\n        # conversation). Empty = expose none; '*' = expose all built-ins.\n        # Built-in candidates: text_stats, cn_convert, case_convert, base64,\n        # url, json_format, json_csv, md5, sha, uuid, password, phone, email,\n        # url_extract, ip_extract, money, radix, timestamp, file_hash, file_encode.\n        agentTools: []\n        # User-defined tools: your own deterministic utilities, written as\n        # JS expressions (the patch layer already trusts !!js). Each entry is\n        # registered as toolbox_<name> when agentTools contains it (or '*').\n        # userTools: []\n        #   - name: shout\n        #     description: 把文本转成大写并加感叹号\n        #     args:\n        #       text: { type: 'string', required: true, description: '输入文本' }\n        #     run: !!js |\n        #       ((args) => ({ text: String(args.text).toUpperCase() + '!' }))\n        # Save-to-workspace RPC (browser \"保存到项目\" button).\n        saveEnabled: true\n"
    }
  ],
