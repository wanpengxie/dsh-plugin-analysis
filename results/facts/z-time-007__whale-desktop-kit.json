  "manifest": {
    "name": "dsh-whale-desktop-kit",
    "version": "1.0.0",
    "description": "DeepSeek Harness 桌面增强套件（鲸跃）：壁纸 / 桌宠 / 工作区美化 + 个人助理 + Office 文档 + 安全自动批准。根目录即规范插件，一键 dsh plugin add 安装。",
    "license": "MIT",
    "type": "module",
    "main": "./src/dsh-plugin.js",
    "exports": {
      ".": "./src/dsh-plugin.js",
      "./client": "./lib/client.js",
      "./package.json": "./package.json"
    },
    "files": [
      "src/**/*.js",
      "lib/**/*.js",
      "plugins/**",
      "cordis.patch.yml",
      "README.md",
      "LICENSE"
    ],
    "dependencies": {
      "docx": "9.7.1",
      "fflate": "0.8.3",
      "sharp": "0.35.3"
    },
    "dsh": {
      "bundle": {
        "patch": "./cordis.patch.yml"
      },
      "client": {
        "inject": [
          "@deepseek-ai/dsh-client-runtime",
          "@deepseek-ai/dsh-client-ui-layout",
          "@deepseek-ai/dsh-client-ui-settings-plugins",
          "@deepseek-ai/dsh-client-ui-conversation"
        ],
        "platform": "web"
      }
    }
  },
  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# dsh-whale-desktop-kit — DeepSeek Harness 桌面增强套件（鲸跃）根 bundle\n# 安装方式：dsh plugin add <本仓库打包的 tgz> --profile web\n# 本补丁插入根插件（whale-desktop-kit），由根 src/dsh-plugin.js 组合全部 6 个增强；\n# 各子插件配置按命名空间嵌套。注：纯 YAML（无 !!js 表达式），任何 patch loader 均可应用。\n\n- insert:\n    - id: whale-desktop-kit\n      name: 'dsh-whale-desktop-kit'\n      config:\n        enabled: true\n        desktopExperience:\n          enabled: true\n        desktopApp:\n          enabled: true\n          pwa: true\n          desktopTools: true\n        officeDocs:\n          enabled: true\n          read: true\n          write: true\n          uploads: true\n          maxUploadBytes: 26214400\n        tokenPet:\n          enabled: true\n          balance: true\n          usage: true\n        personalAssistant:\n          enabled: true\n          auditPath: '.assistant/audit/events.jsonl'\n          computerStatus: true\n          fileSteward: true\n          secretary: true\n          documentWriter: true\n          fileStewardWriteApproval: true\n        safeAutoApproval:\n          enabled: true\n          auditPath: '.assistant/audit/auto-approvals.jsonl'\n"
    }
  ],
  "entries": [
    "src/dsh-plugin.js",
    "lib/client.js",
    "package.json",
    "cordis.patch.yml"
  ],
