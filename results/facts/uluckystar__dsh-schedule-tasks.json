  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# dsh-schedule-tasks bundle patch：把定时任务插件挂进 dsh profile 的 host 组合。\n#\n# 插件行（id: schedule-tasks）以 Service 插件形态（default export 类 + static\n# inject/Config）挂载：提供 `scheduleTasks` Remote 命名空间（浏览器面板经\n# ctx.remote.scheduleTasks.* 读写）与 cron 调度循环。\n#\n# 安装：`dsh plugin --profile <name> add <本包路径>`，随后重启该 profile。\n- insert:\n    - id: schedule-tasks\n      name: dsh-schedule-tasks\n      config:\n        # 每次触发后保留的最近执行日志条数（每任务环形缓冲）。\n        maxLogsPerTask: 20\n        # shell 命令执行的超时（毫秒），超时按失败记录。\n        shellTimeoutMs: 60000\n        # 是否允许 shell 触发动作；false 时 shell 型任务创建/触发会被拒绝。\n        allowShell: true\n        # 调度循环的检查间隔（毫秒）。最小 1000，默认 30000。\n        tickIntervalMs: 30000\n        # shell 命令的工作目录；留空继承宿主进程 cwd。\n        workDir: ''\n"
    }
