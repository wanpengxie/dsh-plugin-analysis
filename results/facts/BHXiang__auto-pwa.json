  "bundle": [
    {
      "path": "patch/auto-pwa.bundle.yml",
      "text": "# auto-pwa npm bundle layer — installable via the profile bundles list.\n#\n# Install (web profile) — 一条命令，dsh plugin add 会自动 reconcile bundles 层栈：\n#   pnpm dsh plugin --profile web add auto-pwa\n#\n# Bundle patches are applied over the profile root config, so the Loader\n# resolves entry names from the PROFILE directory (the loader baseUrl), not\n# from this file or the package root. Plugins are therefore referenced as bare\n# subpath specifiers (\"auto-pwa/plugin/<name>\"), resolved through the package\n# exports map to the compiled lib/plugin/<name>.js — the same convention the\n# in-box bundles use. The dev overlay (patch/auto-pwa.cordis.yml) keeps\n# absolute source-dir paths instead, so iterative development runs the TS.\n#\n# 注意：pwa-fit.ts 是服务定义库（由 pwa-fit-local 导入并注册 ctx.pwaFit），\n# 不作为插件挂载——挂载它会被 loader 当类插件实例化导致重复注册。\n- insert:\n    - id: pwa-fit-local\n      name: 'auto-pwa/plugin/pwa-fit-local'\n    - id: pwa-guard\n      name: 'auto-pwa/plugin/pwa-guard'\n    - id: pwa-commands\n      name: 'auto-pwa/plugin/pwa-commands'\n    - id: auto-pwa\n      name: 'auto-pwa/plugin/auto-pwa'\n"
    }
  ],
