    ],
    "license": "CC-BY-NC-SA-4.0",
    "publishConfig": {
      "access": "public"
    },
    "dsh": {
      "bundle": {
        "patch": "./cordis.patch.yml"
      }
    },
    "scripts": {
      "build": "node node_modules/typescript/bin/tsc -p .",
      "test": "node test/protocol.test.mjs && node test/cap.test.mjs && node test/pure.test.mjs && node test/scoring.test.mjs && node test/recall.test.mjs && node test/triage.test.mjs && node test/lossless.test.mjs && node test/storage.test.mjs && node...",
      "calibrate": "node scripts/calibrate.mjs"
    },
    "peerDependencies": {
