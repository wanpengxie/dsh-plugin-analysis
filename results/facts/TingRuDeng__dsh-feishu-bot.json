  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# The dsh-feishu-bot bundle patch: three plugin rows inserted after the web-app\n# layer. feishu-gateway provides the `ctx.feishu` transport service;\n# feishu-bridge owns all business semantics (bindings, commands, inbound dedup,\n# outbound projection, approval answering); feishu-invariant enforces active\n# binding -> live/persisted session existence and reports through its own\n# channel (DSH removed the `@deepseek-ai/dsh-invariants` registry in\n# v0.2.0-rc.2).\n#\n# Credentials are credential references resolved by the dsh credentials\n# service; no secrets live in this file or this repository.\n#\n# Deployment values (your open_id allowlist and workspace roots) belong in\n# your profile's own patch layer (~/.dsh/profiles/<name>/cordis.patch.yml),\n# which applies after this bundle layer:\n#\n#   - id: feishu-bridge\n#     config:\n#       allowedOpenIds: [ou_your_open_id]\n#       allowedWorkspaces: [~/your/workspace/root]\n#       defaultWorkspace: ~/your/workspace/root\n#\n# The defaults below are fail-closed: an empty allowlist rejects every\n# sender and an empty workspace list rejects every /new.\n\n- insert:\n    - id: feishu-gateway\n      name: '@tingrudeng/dsh-feishu-bot/gateway'\n      config:\n        appIdRef: FEISHU_APP_ID\n        appSecretRef: FEISHU_APP_SECRET\n\n    - id: feishu-bridge\n      name: '@tingrudeng/dsh-feishu-bot/bridge'\n      config:\n        allowedOpenIds: []\n        allowedWorkspaces: []\n        freshnessMs: 600000\n        listingTtlMs: 300000\n        cardThrottleMs: 1000\n\n    - id: feishu-invariant\n      name: '@tingrudeng/dsh-feishu-bot/invariant'\n"
    }
  ],
  "entries": [
    "cordis.patch.yml",
    "package.json"
  ],
