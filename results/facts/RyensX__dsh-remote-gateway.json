      "path": "cordis.patch.yml",
      "text": "# Keep the native DSH Web UI on loopback. The remote listener belongs solely\n# to dsh-remote-gateway, where every request passes authentication.\n- id: webserver\n  config:\n    host: '127.0.0.1'\n    port: !!js ctx.webStartup.port ?? 3080\n\n# 插件客户端接管两个工作区目录流程 slot，并按访问方式分流：本机客户端\n# 调用原生后端，网关客户端使用插件提供的已认证页内目录浏览器。\n- id: directory-picker\n  disabled: true\n\n- insert:\n    - id: directory-picker-native\n      name: '@deepseek-ai/dsh-host-directory-picker-native'\n\n    - id: dsh-remote-gateway\n      name: 'dsh-remote-gateway'\n"
    }
