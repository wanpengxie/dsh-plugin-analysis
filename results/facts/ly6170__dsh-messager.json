  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# 分发包（bundle）的配置层：用户通过 `dsh plugin add ./dsh-messager` 安装后，\n# 本层把插件行插入运行组合。name 使用包名解析（需要先 `pnpm build` 产出 lib/）。\n# host 端由此行加载；client 端由 clientModules 扫描本包的 dsh.client 声明自动编入 Web bundle。\n- insert:\n    - id: messager\n      name: dsh-messager\n      # 配置示例（可省略，schema 有默认值；设置页可覆盖用户层）：\n      # config:\n      #   feishu:\n      #     enabled: true\n      #     webhookUrl: 'https://open.feishu.cn/open-apis/bot/v2/hook/<token>'\n      #   wecom:\n      #     enabled: false\n      #     webhookUrl: 'https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=<key>'\n      #   discord:\n      #     enabled: false\n      #     webhookUrl: 'https://discord.com/api/webhooks/<id>/<token>'\n      #   dingtalk:\n      #     enabled: false\n      #     webhookUrl: 'https://oapi.dingtalk.com/robot/send?access_token=<token>'\n      #   telegram:\n      #     enabled: false\n      #     botToken: ''\n      #     chatId: ''\n"
    }
