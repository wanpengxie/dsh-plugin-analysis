  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# dsh-dot-mcp bundle patch.\n#\n# Only insert the bridge row. dsh-web-app already mounts storage / workspace /\n# session-projection-cache; a second insert of those ids crashes the loader\n# (`duplicate loader entry id: storage`) and is exactly why a dual-profile\n# boot cannot be \"the same rows, later layer wins\".\n#\n# DSH 0.1.7-rc.2 base-backed headless profiles already own storage/cache;\n# add only workspace via cordis.headless.patch.yml (never over Web).\n- insert:\n    - id: dot-mcp\n      name: 'dsh-dot-mcp'\n      config:\n        transport: http\n        host: 127.0.0.1\n        port: 3456\n        resultMaxChars: 8000\n        resultMaxItems: 50\n        sessionMaxItems: 20\n        sessionMaxChars: 4000\n"
    }
  ],
