  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# dsh-zcode-startplan bundle patch\n#\n# 安装后这里就是「开关面板」：改完重启 Harness 生效（fiber 一次性 apply）。\n#\n#   provider / displayName  DSH 里的路由名与展示名（与 llm-pi-ai 的路由不能重名）\n#   models                  暴露给 DSH 的模型 id（与上游目录求交集）\n#   accountProviders        true = 每个启用账号一个独立 provider 栏位（可在面板关统一栏）\n#   captcha.debugPort       宿主 Electron 的 CDP 端口（DSH 桌面端需以\n#                           --remote-debugging-port=9229 启动；captcha 用它产出）\n#   captcha.mode            cdp = 自动产出；manual = 只认人工粘贴（见 CLI）\n#   endpoint.enabled        true 才启动本地 Anthropic 端点（仅 llm-pi-ai 回落路线需要）\n#   statusTool              是否注册 zcode_start_plan_status 工具\n- insert:\n    - id: zcode-start-plan\n      name: dsh-zcode-startplan\n      config:\n        provider: zcode-start-plan\n        displayName: ZCode Start Plan（赠送免费 plan）\n        models:\n          - GLM-5.3-Flash\n          - GLM-5.3\n        accountProviders: true\n        dataDir: ''\n        modelCacheMs: 600000\n        captcha:\n          mode: cdp\n          debugPort: 9229\n          origin: https://zcode.z.ai/\n        endpoint:\n          enabled: false\n          port: 17899\n        statusTool: true\n"
    }
  ],
