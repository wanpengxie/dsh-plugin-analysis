  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# The dsh-bridges bundle patch: one plugin row over the composed tree.\n#\n# The single `dsh-bridges` plugin hosts one bridge subsystem per supported\n# agent tool (claude-code, codebuddy-code, opencode, codex, pi, gemini-cli,\n# and cursor today).\n# Each subsystem registers a skill provider on the host `skills` registry\n# (global layer) and wires the tool's hooks into DeepSeek Harness agent and\n# tool lifecycles. A preset's nearer skill layer shadows its entries on name\n# conflicts, so DeepSeek Harness-native skills always win collisions.\n#\n# Each tool's bridge can be toggled from a later patch layer, e.g.:\n#   - id: bridges\n#     config:\n#       claudeCode:\n#         enabled: false\n\n- insert:\n    - id: bridges\n      name: 'dsh-bridges'\n"
    }
  ],
  "entries": [
    "cordis.patch.yml",
    "package.json"
  ],
