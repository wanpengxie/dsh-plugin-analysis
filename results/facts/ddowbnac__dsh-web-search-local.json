  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# Bundle patch for @djdowbnac/dsh-web-search-local — applied automatically.\n#\n# This file is declared in package.json under `dsh.bundle.patch`, so\n# `dsh plugin --profile <name> add <this package>` registers the package in\n# the profile's `dsh.profile.bundles` and its rows mount on every boot.\n# There is no manual step: nothing to copy into a profile's cordis.patch.yml.\n#\n# Layer order: the stock base/surface bundle layers, then this layer, then the\n# profile's cordis.patch.yml (user layer), then $DSH_HOME/cordis.patch.yml,\n# then --patch overlays. Later layers win, so personal overrides belong in\n# the user layer — this file is the stock base and stays untouched.\n#\n# IMPORTANT: a patch REPLACES the targeted row's whole `config` (it does not\n# merge), so the `web` row restates BOTH searchProvider and fetchProvider.\n# The stock `web-search-deepseek` / `web-fetch-http` rows from dsh-base may\n# stay: once `web` is pinned they are registered-but-unselected (deepseek's\n# provider is permanently \"available\", so pinning is required to avoid\n# WEB_PROVIDER_AMBIGUOUS).\n#\n# Pin `searchProvider: web` => the harness's `web_search` tool queries the\n# internet via the plugin's built-in in-process metasearch (keyless fan-out\n# to DuckDuckGo/Bing/Wikipedia + merge/dedup/rank, no external instance, no\n# API key, no setup). `fetchProvider: local` => `web_fetch` retrieves the\n# http(s) sources the search returns and still reads `file://`. For on-disk\n# corpus search instead, override `searchProvider: local` in the user layer.\n- insert:\n    - id: web-search-local\n      name: '@djdowbnac/dsh-web-search-local'\n      config:\n        # Web backend: auto | duckduckgo | searxng (searxng = built-in metasearch).\n        # Defaults to auto; override in the user layer to change.\n        # engine: auto\n        # Optional on-disk corpus (used only by the `local` search provider).\n        # Left empty on purpose: this layer is applied automatically, so it\n        # must not start indexing the boot directory. Set it in the user layer:\n        # corpusDirs:\n        #   - D:\\docs\n- id: web\n  config:\n    searchProvider: web\n    fetchProvider: local\n"
    }
  ],
