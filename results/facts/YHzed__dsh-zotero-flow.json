  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# 把 dsh-zotero-flow 挂进当前 profile 的组合层。\n# 用户可在 profile 的 cordis.patch.yml 里覆写这里的 config。\n- insert:\n    - id: dsh-zotero-flow\n      name: 'dsh-zotero-flow'\n      config:\n        # Zotero 桌面端本地 HTTP 服务端口（Zotero 高级设置中的 httpServer.port）\n        zoteroPort: 23119\n        # 用于 Crossref / Unpaywall「礼貌池」的联系邮箱，建议填自己的\n        mailto: ''\n        # 浏览器：留空则自动探测 Edge / Chrome\n        browserPath: ''\n        # 机构登录用的独立浏览器资料目录；留空则用 <用户目录>/.dsh-zotero-flow/edge-profile\n        browserProfileDir: ''\n        # CDP 调试端口\n        cdpPort: 9333\n        # PDF 下载目录；留空使用 <用户目录>/.dsh-zotero-flow/downloads\n        downloadDir: ''\n        # 机构代理前缀，例如 WebVPN：https://webvpn.example.edu.cn/http/ 或 EZproxy：\n        # https://login.ezproxy.example.edu/login?url=\n        institutionProxy: ''\n        # 出网代理（仅影响插件的 HTTP 抓取，不影响浏览器）\n        proxyUrl: ''\n"
    }
  ],
