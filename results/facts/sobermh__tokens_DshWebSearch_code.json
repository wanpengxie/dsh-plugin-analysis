  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# tokens-dsh-web-search - web search providers for DSH\n# Registers the free-search plugin into ctx.web + a settings bridge\n# (/api/tokens-dsh-web-search-settings) that serves the \"free-search\" namespace.\n# The engine (ddg / ddg-lite / bing) is chosen from the web Settings page\n# (Settings > Plugins > Web UI plugins > Free Search) or settings.yaml:\n#   free-search:\n#     provider: bing\n#     region: cn-zh        # DuckDuckGo region\n#     bingMarket: zh-CN    # Bing market\n# Failed/empty engines automatically fall back to the next free engine.\n# web.searchProvider must point at this plugin's provider id (ddg).\n- insert:\n    - id: web-search-free\n      name: tokens-dsh-web-search\n      config:\n        provider: bing\n        bingMarket: zh-CN\n# 自动接管默认搜索：让 harness 的 web_search 直接用本插件的 provider（内部含全部引擎）\n- id: web\n  config:\n    searchProvider: ddg\n\n# 禁用原生 DeepSeek 搜索 provider；稳定的 web_search 工具仍由 tool-web 提供。\n# 原生 web-search-deepseek 设置命名空间会随 provider 一同消失，避免重复 UI。\n- id: web-search-deepseek\n  disabled: true\n\n# Desktop bundle 默认关闭 tool-web；重新启用稳定的 web_search 工具，\n# 但继续关闭 web_fetch，避免改变现有的抓取安全边界。\n- id: tool-web\n  disabled: false\n  config:\n    fetch: false\n    searchTimeoutMs: 60000\n"
    }
  ],
  "entries": [
