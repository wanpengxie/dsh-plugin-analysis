  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# name in a DSH patch is an identity guard, NOT a module replacement.\n# Keep the official Connection and supply its exact deployment authorities.\n- id: connection\n  name: '@deepseek-ai/dsh-client-connection'\n  disabled: false\n  inject: [webStartup, remoteSettingsTrust]\n  config:\n    trustedHosts: !!js \"[...new Set([...ctx.webStartup.trustedHosts, ...ctx.remoteSettingsTrust.authorities])]\"\n\n- id: ui-settings\n  # Keep the official settings namespace used by developerTools.setEnabled().\n  disabled: false\n  inject:\n    - remoteSettingsTrust\n\n- insert:\n    - id: remote-settings-compat\n      name: '@lemoncat7/dsh-remote-settings-compat'\n      config:\n        trustedOrigins: []\n\n    - id: remote-access-gate\n      name: '@lemoncat7/dsh-remote-settings-compat/access'\n      config:\n        enabled: false\n        listenHost: 127.0.0.1\n        listenPort: 3081\n        secureCookies: true\n        # Legacy fallback only. The authoritative list is\n        # remote-settings-compat.trustedOrigins above.\n        publicOrigins: []\n        trustedProxyAddresses: []\n        machineBearerPrefixes:\n          - /knowledge-api/v1\n        allowAnonymousKnowledgeShares: false\n        sessionTtlMinutes: 720\n        idleTimeoutMinutes: 60\n        maxFailedAttempts: 5\n        lockoutMinutes: 15\n        bindSessionToIp: false\n"
    }
  ],
