  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "- insert:\n    - id: plan-completion\n      name: 'dsh-plan-completion'\n      config:\n        components: managed\n        progressProtocol: legacy # existing UX; opt into strict receipt/human acceptance in Settings\n        evidenceChars: 1500\n        maxTokensPatch: 800\n        maxTokensRewrite: 1200\n        warmBackfill: true\n        modelCalls: true # false: no helper generation; receipt validation remains active\n        # Plans + last suggestion are persisted per session so a DSH restart restores the UI.\n        persistPlans: true\n        storageDir: '~/.dsh/plan-completion-data' # follows DSH_HOME when explicitly set\n        # Debug endpoints (debug/diag/theme/experiment/autojob/steps/reset) stay off in production.\n        enableDebugRoutes: false\n        rag:\n          enabled: false\n          sendContextToGenerator: false\n          backend: 'llama.cpp'\n          executablePath: '' # empty: use the managed installation after explicit setup\n          modelPath: '' # absolute official Qwen3-Embedding-0.6B-Q8_0.gguf path\n          strategy: 'typed' # source-aware retrieval + established acceptance targets\n        # Optional: set a local directory to persist debug logs / experiment data.\n        # debugDir: '<local debug directory>'\n    - id: plan-completion-observer\n      name: 'dsh-plan-completion/observer'\n    - id: plan-completion-embedding\n      name: 'dsh-plan-completion/embedding'\n    - id: plan-completion-retrieval\n      name: 'dsh-plan-completion/retrieval'\n    - id: plan-completion-generator\n      name: 'dsh-plan-completion/generator'\n    - id: plan-completion-api\n      name: 'dsh-plan-completion/api'\n"
    }
  ],
