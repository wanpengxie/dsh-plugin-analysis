    {
      "path": "cordis.patch.yml",
      "text": "# The GoodJob bundle patch: one composition row.\n# Applied after the dsh-base and dsh-web-app layers.\n#\n# GoodJob owns no exclusive authority: it registers the `goodjob` settings\n# namespace and projects owner-logged Job Group, Wait, and optional Team state\n# through the shared Session feed. Its browser half reads the existing Jobs\n# and Subagent channels. The package is dual-face: this row mounts\n# the host half, and the same package's `dsh.client` declaration puts the\n# operations UI on the web roster. Removing this bundle returns the\n# composition to stock DSH.\n- insert:\n    - id: goodjob\n      name: dsh-goodjob\n"
    }
