  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# Bundle layer for the Hermes panel.\n#\n# The row carries NO config on purpose. Hermes locations are discovered at\n# runtime from the installation's own `official-web/.env` (HERMES_HOME, VENV,\n# HERMES_EXE, DASHBOARD_PORT), so this file must stay machine-independent: an\n# earlier revision pinned this author's `hermes.exe` and `HERMES_HOME` here,\n# which meant every other machine mounted a row pointing at paths that do not\n# exist.\n#\n# Anything that genuinely needs overriding belongs in the profile's own user\n# patch layer, or in the settings form this plugin's `Config` schema feeds —\n# which the client half contributes through the Plugins page's three slots: a\n# card beside the official bundles (`plugins.item`), the form on this bundle's\n# own detail page (`plugins.bundle.config`), and the form on its row page\n# (`plugins.row.config`, keyed `bundle#rowId`).\n- insert:\n    - id: hermes-panel\n      name: '@yang3333/dsh-hermes-panel'\n"
    }
  ],
