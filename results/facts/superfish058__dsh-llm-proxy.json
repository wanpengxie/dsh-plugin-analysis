  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# @superfish058/dsh-llm-proxy v1.5.0 — bundle patch: inserts the LLM proxy-routing plugin row (deployment-global).\n#\n# v1.0.0 redesign (model-level intent):\n#   proxyHost      proxy hostname/IP (does not have to be this machine; default 127.0.0.1)\n#   proxyPort      proxy port (default 7897)\n#   proxiedModels  model keys that route through the proxy, `<providerId>/<modelId>`\n#                  (resolved against llm-pi-ai + llm-deepseek settings); everything\n#                  else stays DIRECT. Loopback hosts are always direct.\n#   retries        mirrored into the official `retryPolicy` of every SELECTED provider\n#                  (maxRetries); the retry itself is executed by dsh-llm-retry, not by\n#                  this plugin — since v1.4.0 there is no transport-layer RetryAgent\n#   retryIntervalMs fixed delay between those retries (ms, mirrored as initialDelayMs)\n#\n# dsh 0.1.7: every field below is a live (`volatile`) Config field, so the row's values\n# are the plugin's settings document (Loader entry id `llm-proxy`) — edits made in\n# 设置 → 插件 → 模型代理 are written straight back here by the Host and apply live.\n#\n# Engine: with the official @deepseek-ai/dsh-http-proxy installed (dsh >= 0.1.3) the\n# plugin feeds that package a computed policy instead of installing its own dispatcher;\n# older harnesses fall back to the bundled RoutingDispatcher.\n#\n# Edit values below, or use the 设置 → 插件 → 模型代理 page (which also lists the selectable models).\n- insert:\n    - id: llm-proxy\n      name: '@superfish058/dsh-llm-proxy'\n      config:\n        proxyHost: '127.0.0.1'\n        proxyPort: 7897\n        # proxiedModels:\n        #   - 'deepseek-v4-flash/deepseek-v4-flash'   # b.ai provider\n        retries: 3\n        retryIntervalMs: 1000\n- insert:\n    - id: llm-proxy\n      name: '@superfish058/dsh-llm-proxy'\n      config:\n        proxyHost: '127.0.0.1'\n        proxyPort: 7897\n        # proxiedModels:\n        #   - 'deepseek-v4-flash/deepseek-v4-flash'   # b.ai provider\n        retries: 3\n        retryIntervalMs: 1000\n"
    }
  ],
