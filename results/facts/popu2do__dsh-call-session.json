  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# dsh-call-session bundle patch: mounts the native cross-session collaboration plugin\n# into the host composition of a DSH profile.\n#\n# The plugin registers native tools into the shared `tools` registry:\n# - board_post: Post public milestone or task context\n# - board_list: Query public announcements or tasks (titles_only supported)\n# - board_clear: Manage or clean blackboard entries\n# - session_call: Direct 1:1 in-process unicast agent call (steer/followup)\n# - session_query: Discover active/idle sessions in current workspace\n# - session_create: Create independent peer root session in current workspace\n#\n# Note:\n# When installed via `dsh plugin --profile <name> add <spec>`, DSH automatically\n# registers this bundle in `dsh.profile.bundles` and loads this patch.\n# Users do NOT need to manually copy `- insert:` blocks into their profile configuration.\n# To override settings, declare property overrides (`- id: dsh-call-session ...`) in\n# `~/.dsh/profiles/<profile>/cordis.patch.yml`.\n- insert:\n    - id: dsh-call-session\n      name: dsh-call-session\n      config:\n        enabled: true\n        # Debounce delay in ms for atomic blackboard flush (default: 300)\n        debounceMs: 300\n        # Maximum posts retained in blackboard memory (default: 200)\n        maxCapacity: 200\n        # Language preference ('auto' | 'zh' | 'en', default: auto)\n        locale: auto\n"
    }
  ],
