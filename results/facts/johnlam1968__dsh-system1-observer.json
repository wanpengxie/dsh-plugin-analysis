  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# A HOST ROW, not a preset row: it attaches to the loop's seams, which are process-wide, and its trace is a\n# property of the deployment rather than of one agent's preset.\n- insert:\n    - id: system1-observer\n      name: 'dsh-system1-observer'\n      config:\n        hooks: [admit, draft, pre_execute, post_execute]\n        provider: typesafe\n        model: jev-latest\n        timeoutMs: 8000\n"
    }
