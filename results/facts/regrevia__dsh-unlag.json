  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "- insert:\n    - id: dsh-unlag\n      name: 'dsh-unlag'\n\n# The button applies edits through this service's transaction, so it has to run\n# even when nothing is watched. `base` resolves against the plugin's own\n# location, and an installed plugin lives inside app.asar, which the service\n# cannot stat — hence the working directory, the one directory that always\n# exists on the machine that boots it.\n# `root` stays empty: an empty root means this service itself watches no module\n# source, so a saved file applies nothing unless the plugin's own automatic\n# reload is switched on (it is off by default). To watch source checkouts, add\n# their absolute paths to `root` in your own profile patch layer.\n- id: hmr\n  disabled: false\n  config:\n    base: !!js 'process.getBuiltinModule(\"node:url\").pathToFileURL(process.cwd()).href'\n    root: []\n"
    }
  ],
