  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# dsh-market-github bundle patch: mounts the plugin market over the web\n# profile. The host half registers the /api/dsh-market HTTP route (GitHub\n# real-time search + install/uninstall/update/enable-disable/restart) and the\n# market_search / market_install / market_installed / market_update model\n# tools; the client half contributes the startup onboarding plugin-market step,\n# the Settings → Plugins → Plugin Market and Installed tabs, and a frame-wide\n# install progress indicator. `config.perPage` (1..100, default 50) sets the\n# market list page size.\n\n- insert:\n    - id: dsh-market-github\n      name: 'dsh-market-github'\n      config:\n        perPage: 50\n"
    }
  ],
