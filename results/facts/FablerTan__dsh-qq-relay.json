  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# dsh-qq-relay bundle patch: inserts the plugin row into the profile\n# roster. Applied as a profile bundle layer (the `dsh.bundle.patch` manifest\n# field); activate with\n# `dsh plugin --profile <name> add link:<path-to-this-package>` — the target\n# profile's GUI has to be restarted before the row takes effect.\n#\n# One bare plugin row for both halves:\n#  - host (`lib/index.js`, exports \".\"): OneBot 11 forward-WS client, message\n#    gate, qq_send tool and approval bridge;\n#  - client (exports \"./client\" -> `lib/client.js`, served at\n#    /plugins/dsh-qq-relay/client.js): the configuration page rendered on this\n#    bundle's own page in the Plugins panel (`plugins.bundle.config`, keyed by\n#    this package name); the browser half's module graph order is declared by\n#    `dsh.client.inject` in package.json.\n#\n# v0.8.0: both halves are live — host runs the OneBot relay / gate / qq_send /\n# approval bridge; client renders the bundle's configuration page (status, config,\n# per-group project dirs, rebind). v0.17.0 moved it from `settings.section` to\n# `plugins.bundle.config` and split the form into 连接 / 项目 / 行为 / 记录 sub-pages.\n# v0.18.0 fixes the trigger rules (quoting someone else / @-ing someone else no longer\n# starts a turn) and adds the optional proxy-reply section (`proxyReply`).\n# v0.19.0 adds a plugin-provided agent preset (formerly declared statically here) and\n# persona support; v0.20.0 moves presets into `presets.json` (editable in the page)\n# and registers them dynamically at boot, so this patch stays a single plugin row.\n# v0.21.0 adds the optional ComfyUI drawing capability: the host probes the\n# configured service and registers the bundled `comfy-image` skill at runtime\n# (no extra row / preset changes needed).\n- insert:\n    - id: dsh-qq-relay\n      name: dsh-qq-relay\n"
    }
  ],
  "entries": [
    "lib/index.js",
    "lib/client.js",
    "package.json",
    "cordis.patch.yml"
  ],
