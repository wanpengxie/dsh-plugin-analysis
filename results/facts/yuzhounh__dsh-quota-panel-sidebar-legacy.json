    {
      "path": "cordis.patch.yml",
      "text": "# dsh-quota-panel bundle patch: mounts the quota panel into a dsh profile.\n# Applied as a profile layer when this package is installed with\n# `dsh plugin --profile web add \"github:owner/dsh-quota-panel\"`.\n#\n# v0.5: the built-in catalog auto-discovers every provider whose standard\n# credential reference resolves (DEEPSEEK_API_KEY, OPENROUTER_API_KEY,\n# SILICONFLOW_API_KEY / SILICONFLOW_CN_API_KEY, MOONSHOT_API_KEY,\n# MINIMAX_API_KEY / MINIMAX_CN_API_KEY, STEP_API_KEY / STEPFUN_API_KEY,\n# XAI_API_KEY, ZHIPU_API_KEY / GLM_API_KEY, ZAI_API_KEY /\n# ZAI_CODING_CN_API_KEY, KIMI_API_KEY, OPENCODE_GO_API_KEY) — no patch\n# config needed for those. This bundle therefore ships NO explicit provider\n# rows: the panel shows exactly the providers whose key resolves. If you\n# want rows outside the catalog, add them to `providers:` below (same-id\n# entries replace catalog rows wholesale). Set `auto: false` to list\n# everything by hand, `hide: [id...]` to drop single rows, and\n# `catalog: {<id>: {...}}` for partial overrides.\n#\n# Providers that cannot be reached directly (e.g. from within mainland\n# China) can route through an HTTP proxy. The primary way is the frontend\n# settings panel (settings gear -> proxy): one proxy URL per provider,\n# persisted to browser localStorage, applied immediately. The config below\n# acts as the profile-level default, used when the frontend leaves the row\n# empty; precedence: frontend settings > profile config > direct.\n#\n#   config:\n#     proxies:\n#       home: http://127.0.0.1:7890\n#     catalog:\n#       openrouter:\n#         proxy: home\n#\n# Explicit providers may set `proxy: home` per entry the same way.\n\n- insert:\n    - id: quota-panel\n      name: 'dsh-quota-panel-sidebar'\n      config:\n        refreshMs: 60000\n        # No explicit providers: the built-in catalog auto-discovers every\n        # provider whose standard credential reference resolves, so the panel\n        # shows exactly the providers you configured a key for. Explicit\n        # entries only belong here for providers outside the catalog (see the\n        # README \"Explicit providers\" section and the comments above).\n        providers: []\n"
    }
  ],
