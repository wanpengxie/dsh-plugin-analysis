    {
      "path": "cordis.patch.yml",
      "text": "# dsh-remote-session bundle patch layer.\n#\n# Installed with:\n#   dsh plugin --profile <profile> add file:<abs path to this directory>\n# The CLI appends \"dsh-remote-session\" to dsh.profile.bundles; this patch is\n# merged after the shipped bundle layers and before the profile's own patch.\n#\n# Config:\n#   relayUrl     relay base URL (no trailing slash), e.g. https://relay.example.com/dsh-relay\n#   token        shared relay token (keep this file private!). Empty -> env DSH_RELAY_TOKEN\n#   instanceId   stable id of THIS device (letters/digits/-/_), e.g. home / company\n#   instanceName display name shown on the other device\n#   indexMs      how often the local session index is pushed to the relay (ms)\n#   maxSessions  how many sessions are published per device\n#   maxMessages  transcript window size requested from the owning device\n- insert:\n    - id: remote-session\n      name: 'dsh-remote-session'\n      config:\n        relayUrl: ''\n        token: ''\n        instanceId: ''\n        instanceName: ''\n        indexMs: 10000\n        maxSessions: 60\n        maxMessages: 100\n"
    }
  ],
