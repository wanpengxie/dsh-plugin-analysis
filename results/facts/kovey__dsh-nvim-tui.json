  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# The dsh-nvim-tui bundle patch: mounts the Neovim TUI runner over dsh-base\n# under the stable plugin id `nvim-tui-runner`. The runner spawns nvim\n# (built-in TUI renders the terminal) and bridges DSH agent events to it\n# over msgpack-RPC.\n#\n# The runner is pure presentation — all agent state arrives via the host's\n# services/events (`agents`, `agentDefaultModel`, `session/event`, `appExit`).\n\n- insert:\n    - id: nvim-tui-runner\n      name: 'dsh-nvim-tui'\n"
    }
  ],
  "entries": [
    "lib/index.js",
    "cordis.patch.yml",
    "package.json"
  ],
