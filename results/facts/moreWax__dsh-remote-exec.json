      "text": "# One plugin owns transport plus remote fs/shell Service Providers.\n- id: fs-sandbox\n  disabled: true\n- id: bash-sandbox\n  disabled: true\n- id: permission\n  config:\n    defaultPreset: danger-full-access\n    presets:\n      read-only: { sandbox: read-only, approval: ask }\n      workspace-write: { sandbox: workspace-write, approval: ask }\n      danger-full-access: { sandbox: danger-full-access, approval: never }\n- insert:\n    - id: remote-exec\n      name: '@morewax/dsh-remote-exec'\n      config:\n        driver: !!js (process.env.DSH_REMOTE_DRIVER || 'ssh')\n        host: !!js process.env.DSH_REMOTE_HOST || ''\n        user: !!js process.env.DSH_REMOTE_USER || ''\n        root: !!js process.env.DSH_REMOTE_ROOT || '~'\n        tailscale: !!js process.env.DSH_REMOTE_TAILSCALE === 'true'\n"
