  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# DSH Promotion Toolkit is a normal profile bundle. Installing the package adds this\n# row after dsh-base; the plugin registers the viral_kit tool in apply().\n- insert:\n    - id: dsh-promotion-toolkit\n      name: '@lhmd/dsh-promotion-toolkit'\n      config:\n        maxInputChars: 24000\n        defaultLanguage: zh\n        defaultPlatform: xiaohongshu\n        chinesePlatforms:\n          - xiaohongshu\n          - zhihu\n          - wechat\n          - wechat_moments\n          - weibo\n          - bilibili\n          - douyin\n          - kuaishou\n        englishPlatforms:\n          - x\n          - threads\n          - linkedin\n          - reddit\n          - tiktok\n          - youtube\n          - medium\n          - facebook\n          - instagram\n"
    }
  ],
