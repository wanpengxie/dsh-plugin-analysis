  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# ankh-guard bundle patch: inserts the guard row into the composing profile,\n# so `dsh plugin --profile <name> add @khorsheed/dsh-ankh-guard` reconciles\n# it into the bundles layer (apps/cli plugin.ts reconcilePlugins). The row is\n# a bare mount — every config field has a schema default.\n#\n# NOTE: a composition must mount this row id exactly once. Official images\n# (the published npm line and upstream master) mount no ankh-guard row, so\n# plugin-adding this package is the install path there; a composition that\n# already mounts the id by other means (the pre-2026-08-16 deploy fork's base\n# bundle did) must NOT also add it — a duplicate loader entry id fails boot.\n# Check first: `dsh --profile <name> --dump-config | grep ankh-guard`.\n- insert:\n    - id: ankh-guard\n      name: \"@khorsheed/dsh-ankh-guard\"\n"
    }
  ],
