  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# dsh-wechat-bridge bundle layer: mounts the iLink gateway and the WeChat\n# conversation node as one composed plugin row.\n#\n# Threat model: the effective trust set is `allowFrom` ∪ users confirmed in\n# the Web settings panel ∪ the credential owner. `allowFrom` is REQUIRED with\n# no permissive default: an agent that accepts instructions from any WeChat\n# contact is a prompt-injection front door. Messages outside the trust set are\n# logged and ignored, never fed to the model. With an empty `allowFrom`, only\n# pairing is trusted: the first scanner is trusted automatically (bootstrap),\n# any later scanner must be explicitly confirmed in the Web settings panel, and\n# switching to another account also requires panel confirmation. API endpoints\n# under /api/dsh-wechat-bridge/* are guarded by a browser trust fence (loopback\n# Host check + sec-fetch-site cross-site rejection + Origin same-origin check);\n# non-loopback Hosts always get 403. See README.md \"安全模型\" for the full model.\n- insert:\n    - id: dsh-wechat-bridge\n      name: 'dsh-wechat-bridge'\n      config:\n        allowFrom: []\n"
    }
  ],
  "entries": [
    "lib/index.js",
    "lib/client.js",
    "package.json",
    "cordis.patch.yml"
