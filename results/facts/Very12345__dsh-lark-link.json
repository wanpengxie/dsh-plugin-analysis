  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# dsh-lark-link bundle patch — inserts the bridge plugin entry into the\n# composition. Users install via `dsh plugin add @very12345/dsh-lark-link`.\n#\n# `name` is the package specifier the dsh loader imports, resolved from the\n# profile directory. It must be the FULL published package name: the bare\n# `dsh-lark-link` this fork used to declare is not resolvable in a profile,\n# because pnpm installs the package under its scoped name, so the entry's\n# import failed and the plugin never activated.\n- insert:\n    - id: lark-link\n      name: '@very12345/dsh-lark-link'\n      config:\n        enabled: !!js \"process.env.DSH_LARK_LINK_ENABLED ?? 'true'\"\n        # Feishu app credentials. Prefer the one-click `/lark setup` flow\n        # (QR registerApp); manual entry writes to ctx.credentials.\n        appId: !!js \"process.env.DSH_LARK_LINK_APP_ID ?? ''\"\n        # groupPolicy: open | mention | keywords | reply\n        groupPolicy: !!js \"process.env.DSH_LARK_LINK_GROUP_POLICY ?? 'mention'\"\n        # denyList: exact command prefixes denied outright (no prompt, no card).\n        denyList: []\n"
    }
  ],
