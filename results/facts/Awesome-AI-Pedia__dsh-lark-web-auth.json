      "path": "cordis.patch.yml",
      "text": "# dsh-lark-web-auth bundle patch — inserts the auth plugin into the DSH web\n# profile composition. Users install via `dsh plugin --profile web add dsh-lark-web-auth`.\n#\n# MUST be inserted AFTER `api-remotes` so its typert lookup wrapper is\n# registered last and takes effect (see README §Load Order).\n- insert:\n    - id: lark-web-auth\n      name: 'dsh-lark-web-auth'\n      config:\n        enabled: !!js \"process.env.LARK_WEB_AUTH_ENABLED ?? 'true'\"\n        appId: !!js \"process.env.LARK_WEB_APP_ID ?? ''\"\n        appSecret: !!js \"process.env.LARK_WEB_APP_SECRET ?? ''\"\n        # Public URL where the browser reaches this server (Caddy/Nginx front),\n        # e.g. https://web.yourdomain.com. Used to build the OAuth redirect URI.\n        publicBaseUrl: !!js \"process.env.LARK_WEB_BASE_URL ?? ''\"\n        # 32+ byte random string. Rotating this invalidates every login.\n        cookieSecret: !!js \"process.env.LARK_WEB_COOKIE_SECRET ?? ''\"\n        # SQLite file for web_session / session_owner / oauth_state tables.\n        dbPath: !!js \"process.env.LARK_WEB_DB_PATH ?? ''\"\n        # Login cookie lifetime.\n        cookieTtlDays: 30\n        # Lark domain: 'feishu' (China) | 'lark' (International).\n        domain: !!js \"process.env.LARK_WEB_DOMAIN ?? 'feishu'\"\n"
    }
  ],
