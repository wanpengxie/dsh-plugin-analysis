  "bundle": [
    {
      "path": "dsh.cordis.yml",
      "text": "# changestab — bundle patch layer: the single plugin row that mounts BOTH faces.\n#\n# Dual-face package, one row (same pattern as modelspoke / dsh-web-tools).\n#\n# The row `name` MUST be the BARE package name:\n#   - the host Loader imports `name` as the node half (package `main` = the\n#     host face service);\n#   - the web app's client scanner keys the same row to\n#     `require.resolve('changestab/package.json')` and, seeing\n#     `dsh.client.platform: \"web\"` + `exports[\"./client\"]`, composes a browser\n#     graph row served at /plugins/changestab/client.js.\n# A subpath name (e.g. 'changestab/dist/dsh/client.js') is invisible to the client\n# scanner and would silently ship a host-only plugin.\n- insert:\n    - id: changestab\n      name: 'changestab'\n"
    }
  ],
