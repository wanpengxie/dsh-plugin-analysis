  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# dsh-maestro-remote bundle patch — three rows:\n#   dsh-maestro-remote-rpc  loopback RPC stub (status endpoint)\n#   dsh-maestro-tunnel      the real provider: cloudflared tunnel + LAN proxy\n#                           + PIN auth + startup notification (provides\n#                           service 'maestroTunnel' consumed by review)\n#   maestro-patch           the zero-fork patch shim, absorbed from\n#                           dsh-maestro-patch: viewport, apple-touch-icon,\n#                           connection loopback, welcome\n- insert:\n    # The RPC row is addressed by the BARE package name, not by\n    # '@ddtcorex/dsh-maestro-remote/lib/index.js'. Both resolve to the same file,\n    # but only the bare name gives the client module scan a package root to\n    # resolve. A package whose every row is a subpath is permanently skipped as\n    # \"not a client row\": its dsh.client declaration is never read, lib/client.js\n    # is never served, and the settings section disappears with no boot error\n    # naming a cause.\n    - id: dsh-maestro-remote-rpc\n      name: '@ddtcorex/dsh-maestro-remote'\n      channel: /dsh-maestro-remote\n      # Row-level inject: rpc.handle registers a webServer route inside an\n      # effect fiber, which carries only the row's inject (not the module's).\n      # Without webServer here the row fails on harnesses that provide\n      # webServer after rows apply (DSH 0.1.5-rc.1+). On DSH 0.2.x that alone is\n      # not enough: see the `connection` entry at the end of this file.\n      inject: ['webServer', 'connection', 'maestroTunnel']\n    - id: dsh-maestro-tunnel\n      name: '@ddtcorex/dsh-maestro-remote/lib/tunnel.js'\n\n    # The zero-fork patch shim, absorbed from dsh-maestro-patch. It stays its\n    # own row on purpose: the patches must work with the tunnel off, which a\n    # row merged into the tunnel provider could not guarantee.\n    - id: maestro-patch\n      name: '@ddtcorex/dsh-maestro-remote/lib/patch/index.js'\n      inject: ['connection']\n\n\n# DSH 0.2.x resolves `webServer` for `ctx.connection.rpc.handle` on the\n# `connection` row own fiber, so a row-level inject cannot reach it. `inject`\n# replaces the base list, hence `webStartup` (the base row needs it for\n# trustedHosts) is repeated. Identical in every maestro package that registers\n# RPC channels, so each one stays installable alone.\n- id: connection\n  inject:\n    - webStartup\n    - webServer\n"
    }
  ],
