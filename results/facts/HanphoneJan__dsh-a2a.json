      "cordis.patch.yml",
      "README.md",
      "README.zh.md"
    ],
    "main": "./lib/index.js",
    "exports": {
      ".": {
        "types": "./lib/types/index.d.ts",
        "default": "./lib/index.js"
      },
      "./client": {
        "types": "./lib/types/client/index.d.ts",
        "default": "./lib/client.js"
      },
      "./package.json": "./package.json"
    },
    "dsh": {
      "bundle": {
        "patch": "./cordis.patch.yml"
      },
      "client": {
        "inject": [
          "@deepseek-ai/dsh-client-ui-renderer",
          "@deepseek-ai/dsh-client-ui-settings",
          "@deepseek-ai/dsh-client-ui-slots"
        ],
        "platform": "web"
      }
    },
    "//peers": "A2A runs inside a DSH harness composition: the host provides these. Local typecheck resolves them through tsconfig paths to the harness checkout, not from node_modules. The dsh-* ranges state the DSH runtime versions this plugin supports; the DSH 0.1.7+ peer-compatibility preflight evaluates only @deepseek-ai/dsh and @deepseek-ai/dsh-*, with prereleases participating. cordis and schemastery are declared for install-time peer resolution: the stable ranges cover the 4.0.x/3.x line, which includes the vendored 4.0.5/3.18.5 in the 0.2.1-rc.2 harness; the trailing exact prereleases keep the 0.2.1-alpha.2 host covered.",
    "peerDependencies": {
      "@deepseek-ai/cordis": "~4.0.2 || 4.0.5-alpha.1",
      "@deepseek-ai/dsh-commands": ">=0.1.3 <0.3",
      "@deepseek-ai/dsh-storage-domain": ">=0.1.3 <0.3",
      "@deepseek-ai/schemastery": "3.* || 3.18.5-alpha.1"
    },
    "dependencies": {
      "zod": "~4.4.3"
    },
    "devDependencies": {
      "@types/node": "^22.20.0",
      "@types/react": "^18.3.31",
      "react": "^18.3.1",
      "tsdown": "^0.22.2",
      "typescript": "^6.0.3",
      "vitest": "^4.1.8"
    },
    "scripts": {
      "build": "tsc -b tsconfig.json && tsc -p tsconfig.client.json && tsdown && node scripts/build-client.mjs",
      "typecheck": "tsc -b tsconfig.json && tsc -p tsconfig.client.json && tsc -p tsconfig.types.json",
      "test": "vitest run",
      "test:integration": "vitest run tests/integration",
      "test:e2e": "node scripts/e2e-a2a.mjs",
      "test:all": "pnpm typecheck && pnpm test && pnpm build && pnpm test:e2e",
      "visual:a2a": "node scripts/visual-a2a-test.mjs"
    }
  },
  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# @hanphone/dsh-a2a bundle patch: mount the plugin as one row, enabled by\n# default. v1.0 instances are NOT patch-configured — inbound/outbound server\n# instances are created, preset-bound, and enabled/disabled entirely from the\n# GUI (persisted in the a2a domain); this row only mounts the plugin core.\n- insert:\n    - id: a2a\n      name: '@hanphone/dsh-a2a'\n      config: {}"
    }
