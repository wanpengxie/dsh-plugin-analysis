  "bundle": [
    {
      "path": "patch.yml",
      "text": "# Bundle layer contributed by @mfallah/dsh-mcp-studio.\n#\n# The DSH profile launcher applies this file after the shipped bundle layers and\n# before the user's own `cordis.patch.yml`, so installing the package is enough:\n# the entry below is what mounts the plugin.\n#\n#   dsh plugin --profile web add @mfallah/dsh-mcp-studio\n#\n# Everything the plugin needs at run time lives in its own store under\n# $DSH_HOME/mcp-studio/, never in this file.\n- insert:\n    - id: mcp-studio\n      name: '@mfallah/dsh-mcp-studio'\n      config:\n        # Keep the official MCP registry lookup on; disable it to render the\n        # curated offline catalog only.\n        catalogEnabled: true\n        registryUrl: https://registry.modelcontextprotocol.io\n        # Connection probes are bounded so a dead server cannot stall the UI.\n        # The generous budgets cover a cold `npx -y` download, which is the\n        # normal first-run cost of a stdio server.\n        probeTimeoutMs: 60000\n        mountTimeoutMs: 90000\n"
    }
  ],
