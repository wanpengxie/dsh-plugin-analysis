  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# dsh-remote-access bundle patch.\n#\n# When installed through the official DSH CLI/market, this row mounts the\n# host plugin automatically. A manual mount with the same id should be\n# removed from the profile's cordis.patch.yml to avoid double-mounting.\n- insert:\n    - id: remote-access\n      name: '@greenonion/dsh-remote-access'\n      config:\n        port: 3081\n        localPort: 3080\n        tailscalePort: 3082\n        apiGatewayPort: 3083\n        # Per-listener switches. The settings page can also toggle these at\n        # runtime; false removes the matching Caddy site/port from Caddyfile.\n        # lanPortEnabled: true\n        # tailscalePortEnabled: true\n\n        # Cloudflare Tunnel is disabled by default. For public access use\n        # authMode: cloudflare-tunnel-basic plus externalOrigins; the settings\n        # page's Access control toggle reuses the generated Basic Auth\n        # credential. `cloudflare-tunnel` is an explicit anonymous exception;\n        # `cloudflare-access` additionally verifies issuer/audience. In all\n        # cases point externally managed cloudflared at\n        # http://127.0.0.1:3084; this plugin never manages cloudflared.\n        # cloudflare:\n        #   enabled: false\n        #   authMode: cloudflare-tunnel-basic\n        #   listenHost: 127.0.0.1\n        #   listenPort: 3084\n        #   externalOrigins: ['https://dsh.example.com']\n        #   # Access mode only:\n        #   # issuer: https://<team>.cloudflareaccess.com\n        #   # audience: ['<application-audience-tag>']\n        #   upstreamTimeoutMs: 120000\n        #   upstreamConnectTimeoutMs: 10000\n        tailscale: true\n        certNotice: false\n"
    }
  ],
