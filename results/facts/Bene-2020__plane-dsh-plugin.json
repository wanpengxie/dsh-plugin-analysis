  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# plane-dsh-plugin bundle patch: one package owns both the Cordis host face and\n# the browser client face. DSH scans this same loader entry's package manifest\n# for dsh.client and therefore must not receive a second client-only row.\n# Applied after dsh-base's insert; rows here override base rows by id, and the\n# profile's own cordis.patch.yml and any --patch overlays still come later.\n#\n# The package's own dsh.client manifest (platform: 'web') plus its\n# exports[./client] bundle is what the client-modules node half scans into\n# window.__DSH_BOOT__. The credentials/tools injections retain the BUG-010\n# runtime contract for Config and tool registration.\n- insert:\n    - id: plane-dsh-plugin\n      name: plane-dsh-plugin\n      inject:\n        - credentials\n        - tools\n      config:\n        # Replace this value in the profile's own cordis.patch.yml. Profile\n        # configuration is applied after bundle defaults.\n        workspaceSlug: your-workspace-slug\n        planeMode: sdk\n        planeBaseUrl: https://api.plane.so\n"
    }
  ],
