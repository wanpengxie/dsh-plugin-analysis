  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# dsh-htb-skills bundle patch: inserts the host plugin row into the profile\n# roster. Applied as a profile bundle layer (the `dsh.bundle.patch` manifest\n# field). Activate with:\n#\n#   dsh plugin --profile <name> add link:/path/to/dsh-htb-skills\n#\n# or, once published to npm:\n#\n#   dsh plugin --profile <name> add dsh-htb-skills\n#\n# The row is a bare host plugin by package name: it registers a `htb` skill\n# provider over the package's own `skills/` tree AND the htb_sherlock_* model\n# tools (HTB labs API). No browser half.\n#\n# Deployments that already serve the same cards from another provider (e.g.\n# ~/.dsh/skills on a dev host) can mount tools-only with:\n#   - id: htb-skills\n#     name: 'dsh-htb-skills'\n#     config:\n#       skillsEnabled: false\n- insert:\n    - id: htb-skills\n      name: 'dsh-htb-skills'\n"
    }
  ],
