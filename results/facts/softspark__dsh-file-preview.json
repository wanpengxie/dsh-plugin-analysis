  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# Self-contained install unit for the file-preview plugin.\n#\n# Both halves live in one package, and the row names are not interchangeable:\n#\n#   ui-file-preview -> the package root. DSH imports a row's name on the HOST\n#     even when the row's behaviour is entirely in the browser, then reads the\n#     package's `dsh.client` declaration to decide what to serve the page. The\n#     root is therefore a no-op Node module; naming `/client` here instead\n#     points the host import straight at the browser artifact and the harness\n#     refuses to boot with `window is not defined`.\n#\n#   file-preview -> the `./host` subpath, where the Remote service actually is.\n#\n# `insert:` is load-bearing too. A bare `- id:` entry *patches* a row that\n# already exists; DSH reports `patch: entry \"file-preview\" not found`, skips it,\n# and leaves a plugin that installs cleanly and does nothing.\n#\n# The browser half claims conversation file-open gestures by wrapping the\n# harness's `remote.session.openWorkspacePath`. Removing this bundle from a profile\n# removes the whole surface and restores the harness's native open.\n- insert:\n    - id: file-preview\n      name: '@softspark/dsh-file-preview/host'\n    - id: ui-file-preview\n      name: '@softspark/dsh-file-preview'\n"
    }
  ],
