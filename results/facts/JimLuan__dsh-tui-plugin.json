  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# The dsh-tui bundle patch: the interactive terminal surface over dsh-base.\n# Applied after dsh-base's insert; rows here override base rows by id, with\n# the profile's own cordis.patch.yml and any --patch overlays still to come.\n#\n# A patch replaces the targeted row's whole `config`, so each row below\n# restates every key it owns.\n#\n# The tui-startup plugin injects `cmdlineArgs` and provides `tuiStartup` as an\n# ordinary Cordis service. Rows configured from flags inject that service, so\n# Loader resolves their expressions only after it exists. The tui-runner row\n# then reads the resolved startup values.\n\n# ── surface-specific values the base deliberately omits ─────────────────────\n\n- id: system-prompt\n  config:\n    persona: >-\n      You are a coding agent powered by the {{model}} model. Your working directory is {{cwd}}.\n\n# The shared module-reload HMR row stays off; the launcher's watch-only\n# fallback still keeps the user patch layers live while the TUI runs.\n- id: hmr\n  disabled: true\n\n- id: tools\n  config:\n    # Keep the same temporary process-wide Code Mode opt-in as the Web surface.\n    mode: !!js process.env.DSH_TOOLS_MODE\n\n# ── terminal-only host rows ─────────────────────────────────────────────────\n#\n# The `name` entries below reference THIS package's own name (it exports\n# `./startup` and its main entry). If you ever rename the package in\n# package.json, update the two `dsh-tui-plugin` names here to match.\n\n- insert:\n    - id: code-runtime\n      name: '@deepseek-ai/dsh-code-runtime-worker-thread'\n\n    - id: tui-startup\n      name: 'dsh-tui-plugin/startup'\n\n    # The TUI runner: an interactive in-process host surface. It reads its\n    # flags from the ordinary tuiStartup provider and drives the terminal\n    # directly from host services.\n    - id: tui-runner\n      name: 'dsh-tui-plugin'\n      inject: [tuiStartup]\n      config:\n        startup: !!js ctx.tuiStartup\n"
    }
  ],
  "entries": [
