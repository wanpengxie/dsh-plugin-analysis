  "manifest": {
    "name": "@dsh-external/dsh-engram-relay",
    "version": "0.4.3",
    "description": "大 engram 小 KV：外置 engram 转接层（跨会话分层记忆：global/project/session，AI 自主决策归属 + 因果链接索引 + 渐进披露 + 主动唤醒），为 DSH 实现超长上下文记忆稀疏路由，与官方 compact 共存（官方腾 KV，engram 保细节）",
    "private": true,
    "type": "module",
    "main": "./lib/index.js",
    "types": "./lib/types/index.d.ts",
