  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# dsh-auth-gateway bundle patch.\n#\n# Mounted as a bundle layer (package.json \"dsh.bundle\"), applied after\n# dsh-base / dsh-web-app. Two effects:\n#\n#   1. Move the real webserver to a loopback-only internal port. This is the\n#      security-critical half of the design: with host 127.0.0.1 the internal\n#      port is unreachable from other machines, so the login gateway (which\n#      owns the external port) is the only way in.\n#   2. Insert the login gateway plugin itself.\n#\n# Ports follow `dsh web --port <N>` (the web-startup service, the same\n# mechanism the web-app bundle uses): the gateway serves the URL port N\n# (default 3080) and the internal webserver sits at N+1 (default 3081).\n# `--host 0.0.0.0` is refused by dsh itself; the gateway's listenHost\n# (default 0.0.0.0) is what exposes the service. Do not use `--port 0`\n# (OS-assigned) — the gateway needs a fixed internal port to forward to.\n\n- id: webserver\n  config:\n    host: 127.0.0.1\n    port: !!js (ctx.webStartup.port ?? 3080) + 1\n    # Whole-config replacement: the web-app bundle's compression defaults\n    # (gzip / level 1 / ≥1024 bytes) must be restated here too, or the row\n    # falls back to the schema defaults ('none') and the internal server\n    # stops compressing responses.\n    compression: gzip\n    compressionLevel: 1\n    compressionThresholdBytes: 1024\n\n# web-app's own URL line prints the INTERNAL webserver address\n# (http://127.0.0.1:<internal port>), which is loopback-only by design and\n# would mislead; the login gateway prints the real URL instead. The whole\n# config is restated because a patch replaces it:\n#\n#   surfaceContext   stays on;\n#   openBrowser      must keep flowing from the CLI flags — the web-app schema\n#                    default is TRUE, so omitting it makes `dsh web --no-open`\n#                    ineffective and pops a browser tab on every boot;\n#   publicUrl        preserves an operator's `--public-url`; otherwise it must\n#                    name the gateway, not webServer's internal listener.\n#                    This override belongs only to this bundle layer, so removing\n#                    the plugin restores the web-app's original URL selection.\n#                    It is display-only (dsh's own help says\n#                    it \"grants no trust\") and feeds the printed/opened URL,\n#                    DSH_WEB_URL, and — since 0.2.1-alpha.3 — the runtime\n#                    context line `Current DeepSeek Harness Web GUI URL`.\n#                    Dropping it makes those surfaces name the internal\n#                    loopback origin, and the browser handoff then opens the\n#                    INTERNAL port with the launch token, minting a dsh session\n#                    that never passes the gateway password;\n#   trustedHosts     is a web-app config field only on dsh <= 0.1.7-rc.2\n#                    (commit cb9a590c86 moved it to the `connection` row, which\n#                    this patch does not touch). Kept so `--trusted-host` still\n#                    reaches web-app at the older end of the supported range;\n#                    ignored on newer dsh. Do not \"clean it up\".\n- id: web-runtime\n  config:\n    printUrl: false\n    surfaceContext: true\n    openBrowser: !!js ctx.webStartup.openBrowser\n    publicUrl: !!js ctx.webStartup.publicUrl ?? ('http://127.0.0.1:' + (ctx.webStartup.port ?? 3080))\n    trustedHosts: !!js ctx.webStartup.trustedHosts\n\n- insert:\n    - id: dsh-lifecycle\n      name: dsh-lifecycle\n      inject: [webStartup]\n      config:\n        listenHost: 0.0.0.0\n        listenPort: !!js ctx.webStartup.port ?? 3080\n        upstreamHost: 127.0.0.1\n        upstreamPort: !!js (ctx.webStartup.port ?? 3080) + 1\n\n- insert:\n    - id: dsh-lifecycle-power\n      name: dsh-lifecycle/power\n"
    }
  ],
