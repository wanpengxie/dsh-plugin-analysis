  "manifest": {
    "name": "@starxer/chatterbox4dsh",
    "version": "0.3.0",
    "description": "A Feishu/Lark channel plugin for DeepSeek Harness (dsh): use the same agent from Feishu chat, with every step (reasoning, tool calls, results, timing) shown as a card.",
    "icon": "./icon.svg",
    "type": "module",
    "main": "lib/index.js",
    "types": "lib/types/index.d.ts",
    "exports": {
      ".": {
        "types": "./lib/types/index.d.ts",
        "default": "./lib/index.js"
      },
      "./client": "./client/client.js",
      "./locale/*.json": "./locale/*.json",
      "./package.json": "./package.json"
    },
    "dsh": {
      "bundle": {
        "patch": "./cordis.patch.yml"
