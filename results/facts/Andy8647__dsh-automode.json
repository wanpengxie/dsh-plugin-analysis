  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# The dsh-auto-approval bundle patch.\n#\n# Two rows, no disabling of anything official:\n#   1. `insert` mounts this package as one composition row (the host half; the\n#      same package's browser half is served by `dsh.client`).\n#   2. `permission` restates the whole preset table with a fourth entry.\n#      A patch replaces the targeted row's entire `config`, so every preset the\n#      base layer ships is restated verbatim — dropping one would remove it from\n#      the composer dropdown. `automode` shares the danger-full-access bundle\n#      (full access + approval `never`) on purpose: the classifier, not the\n#      sandbox, is what gates the session. The official preset service keeps\n#      the last `permission/preset` name, so the two shared-bundle entries stay\n#      distinguishable in the UI.\n- insert:\n    - id: auto-approval\n      name: 'dsh-auto-approval'\n\n- id: permission\n  config:\n    presets:\n      read-only:\n        sandbox: read-only\n        approval: ask\n      workspace-write:\n        sandbox: workspace-write\n        approval: ask\n      danger-full-access:\n        sandbox: danger-full-access\n        approval: never\n      automode:\n        sandbox: danger-full-access\n        approval: never\n        name: Automode\n        description: Full access with the classifier as the only gate before each tool call.\n"
    }
  ],
