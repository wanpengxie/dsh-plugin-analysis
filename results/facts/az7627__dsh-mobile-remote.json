  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# Patch layer for the @az7627/dsh-mobile-remote bundle.\n#\n# The row's package name resolves from the profile's node_modules (installed\n# via `dsh plugin --profile <name> add @az7627/dsh-mobile-remote`).\n- insert:\n    - id: mobile-remote\n      name: '@az7627/dsh-mobile-remote'\n\n# Pin the browse directory-picker pair. rc.6's webserver host schema accepts\n# only 127.0.0.1 | 0.0.0.0 while the CLI refuses 0.0.0.0, so the adaptive\n# chooser would always resolve the native backend — whose OS dialog a phone\n# can never see. Mounting the browse pair directly keeps the Web directory\n# page active on every bind (loopback included), which is the interaction\n# remote phones and port-forwarded deployments need. Trade-off: the desktop\n# also uses the Web directory page instead of the OS chooser.\n- id: directory-picker\n  disabled: true\n\n- insert:\n    - id: directory-picker-browse\n      name: '@deepseek-ai/dsh-host-directory-picker-browse'\n\n# The built-in browse SURFACE is replaced by dsh-mobile-remote's own\n# directory-flow occupant (shortcut sidebar + gallery picker on desktop,\n# shortcut landing + single-column list on mobile, all over the fs.* RPC).\n# The host browse backend above stays mounted for any other pickDirectory\n# consumer; only the dialog is superseded.\n- id: directory-picker-browse-surface\n  disabled: true\n"
    }
  ],
  "entries": [
    "package.json",
    "cordis.patch.yml"
