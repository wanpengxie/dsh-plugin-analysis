  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# cordis.patch.yml — mount the dsh-dev-progress-memory plugin\n#\n# Copy this snippet into your profile's cordis.patch.yml (or create one)\n# to activate the dev progress memory plugin.\n#\n# The plugin registers:\n#   - turn/end hook: classifies completed turns → doc/progress/\n#   - agent/pre-step hook: injects INDEX.md + system memory retrieval\n#   - agent/request-error hook: context-overflow recovery with handoff\n#   - progress_read tool: on-demand full document loading\n\n- insert:\n    - id: dsh-dev-progress-memory   # 插件在配置树中的唯一 id\n      name: dsh-dev-progress-memory # package.json 中的包名\n      config:\n\n      # --- Core settings ---\n\n      # Workspace-relative directory for progress .md files\n      progressDir: doc/progress\n\n      # INDEX.md hard limits (rewrites rather than truncates)\n      indexMaxLines: 200\n      indexMaxBytes: 25600\n\n      # SYSTEM_MEMORY.md total character budget (triggers archival on overflow)\n      systemMemoryBudget: 8000\n\n      # Max characters per system-memory entry\n      systemMemoryEntryBudget: 2200\n\n      # ---- Compact settings ----\n\n      # Whether proactive compact is enabled\n      compactEnabled: true\n\n      # Pressure ratio to trigger compact (fraction of context window)\n      # 0.75 means compact when estimated tokens reach 75% of available window\n      # This is deliberately below the DSH default of 0.8 to leave safety margin\n      compactPressureRatio: 0.75\n\n      # ---- LLM settings ----\n\n      # LLM route for classification & summarization (empty = reuse current session route)\n      summarizationProvider: \"\"\n      summarizationModel: \"\"\n\n      # Max output tokens for classification calls\n      classifyMaxTokens: 2048\n\n      # Max output tokens for handoff summarization\n      summarizeMaxTokens: 4096\n\n      # ---- Feature toggles ----\n\n      progressEnabled: true\n      systemMemoryEnabled: true\n\n      # ---- Timing ----\n\n      # Debounce delay in ms before writing turn classification results\n      debounceMs: 1000"
    }
  ],
