  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# dsh-npu 的默认装配（v1.0.0 · schema v2）。\n# 机器相关的差异（flm 路径、端口、token）放到 profile 的 cordis.patch.yml 里覆盖。\n#\n# 这里只插入 npu-runtime 一行：LLM provider `npu-local` 由插件自己 registerAdapter。\n#\n# 槽位（slots）按 backend 字段区分：\n#   backend: flm               → FastFlowLM / AMD XDNA2 NPU\n#   backend: llamacpp-vulkan   → llama.cpp GPU（也可 rocm/cuda；运行时按 detect 选）\n# 模型清单来自实测（见 README「模型怎么选」）：\n#   hy-mt2-flash:1.8b  专职翻译（数字/日期/代码保真最好）\n#   qwen3.5:0.8b       通用对话、整理（--embed 1 同进程顺带 embed-gemma:300m）\n#   qwen2.5-1.5b gguf  GPU 侧对话/代码（第五框架的第二引擎）\n\n- insert:\n    - id: npu-runtime\n      name: 'dsh-npu'\n      config:\n        schema: 2\n        provider: npu-local\n        displayName: '燧心 · 本地推理'\n        # 便携版 flm.exe 的路径；不在 PATH 上就必须改成绝对路径\n        exePath: flm\n        dataRoot: ''\n        mode: auto\n        frontPort: 52630\n        bindHost: 127.0.0.1\n        readyTimeoutSec: 180\n        # 给局域网其它软件用时设一个 Bearer token；留空表示不校验\n        apiToken: ''\n        updateCheck: true\n        # 第五框架：NPU 与 GPU 两个引擎协同（需同时有 flm 槽位与 llamacpp 槽位）\n        hybrid:\n          enabled: true\n          mode: auto\n          draftModel: 'qwen3.5:0.8b'\n          verifyModel: 'Qwen2.5-1.5B-Instruct-Q4_K_M.gguf'\n        slots:\n          # 通用对话 / 整理；--embed 1 让同一进程顺带服务 embed-gemma:300m\n          - id: chat\n            backend: flm\n            model: 'qwen3.5:0.8b'\n            name: Qwen3.5 0.8B (NPU)\n            contextWindow: 8192\n            think: false\n            embed: true\n            alsoServes: ['embed-gemma:300m']\n            idleSec: 180\n            args: ['serve', '{model}', '--port', '{port}', '--quiet']\n          # 专职翻译：1k 上下文、单轮，只适合整段翻译\n          - id: mt\n            backend: flm\n            model: 'hy-mt2-flash:1.8b'\n            name: Hy-MT2 1.8B (NPU)\n            contextWindow: 1024\n            think: false\n            llm: true\n            idleSec: 60\n            args: ['serve', '{model}', '--port', '{port}', '--quiet']\n          # GPU 引擎（第五框架用；gguf 不存在时会被标 stale，不影响 NPU 槽位）\n          - id: gpu\n            backend: llamacpp-vulkan\n            model: 'Qwen2.5-1.5B-Instruct-Q4_K_M.gguf'\n            name: Qwen2.5 1.5B (GPU)\n            contextWindow: 4096\n            think: false\n            idleSec: 120"
    }
  ],
