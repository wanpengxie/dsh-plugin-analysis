  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# @dsh-feishu/dsh-feishu bundle patch: the Feishu (Lark) surface over the\n# dsh-base layer. Applied after dsh-base's insert; rows here override base\n# rows by id, with the profile's own cordis.patch.yml and any --patch\n# overlays still to come.\n#\n# Iteration 0: mount only the bridge entry point. It starts in \"not\n# configured\" mode until credentials are supplied (via the appId/appSecret\n# config keys or the FEISHU_APP_ID / FEISHU_APP_SECRET environment\n# variables), so the bundle is safe to add to any profile without\n# credentials. The Feishu transport, session bridge, and streaming cards\n# arrive in later iterations.\n- insert:\n    - id: feishu\n      name: '@dsh-feishu/dsh-feishu'\n\n    # Parity with the web surface (its standard/code agent presets mount\n    # this tool): the model can ask the user questions on Feishu, rendered\n    # as question cards by the surface's userQuestions provider. The tool\n    # needs `tools` + `userQuestions`, both mounted by dsh-base above.\n    - id: tool-ask-user\n      name: '@deepseek-ai/dsh-tool-ask-user'\n\n    # The next three rows exist for one reason: reminders are a shipped\n    # feature, and dsh 0.1.7 re-parented `dsh-schedule` onto the session\n    # business API — schedule needs `sessionController` (row 3), which needs\n    # `fileUploads` (row 2), which needs `connection` (row 1). dsh-base mounts\n    # neither of the three, and a missing link leaves the whole chain\n    # `pending`: the reminder tools never register and the agent's calls fail\n    # with `unknown tool \"schedule_create\"`. Do not prune them as unrelated to\n    # a Feishu surface — with them gone, reminders are gone.\n    #\n    # Client-connection service (`connection`), which the upload bundle below\n    # injects; part of the same 0.1.7 chain that `dsh-schedule` now needs.\n    - id: client-connection\n      name: '@deepseek-ai/dsh-client-connection'\n\n    # Host storage/staged-receipt service for uploads. dsh 0.1.7's\n    # `api-session-controller` below injects `fileUploads`, which only this\n    # bundle provides; without it the controller stays pending and the\n    # reminder scheduler never activates (`unknown tool \"schedule_create\"`).\n    # It injects nothing itself, so it is the root of this chain.\n    - id: client-file-upload\n      name: '@deepseek-ai/dsh-client-file-upload'\n\n    # The Session business API owner. dsh 0.1.7's `dsh-schedule` injects\n    # `sessionController`, which only this bundle provides — without it the\n    # schedule row below stays `pending (waiting for service:\n    # sessionController)` and registers no tools (the agent's create/list\n    # calls fail with an unknown tool). dsh-base mounts `api-gateway` but\n    # not this controller.\n    - id: api-session-controller\n      name: '@deepseek-ai/dsh-api-session-controller'\n\n    # Agent-scoped durable reminders (after / at / every): the model creates\n    # them in chat (\"remind me in 5 minutes\"), and a fired reminder wakes the\n    # agent, whose response the surface renders as an '⏰ Reminder' card\n    # (agent-initiated turn path in the bridge). dsh-base does not mount it.\n    - id: schedule\n      name: '@deepseek-ai/dsh-schedule'\n    # dsh 0.2.1 split the reminder TOOLS out of `dsh-schedule` (which keeps\n    # owning the service/storage) into this bundle; without it the service is\n    # live but `schedule_create` is an unknown tool and the agent cannot set a\n    # reminder at all.\n    - id: tool-schedule\n      name: '@deepseek-ai/dsh-tool-schedule'\n\n\n    # Durable workspace registry (session archive/restore, web-visible).\n    # The workspace registry persists through the storage domain, so a\n    # rename/archive on Feishu is observed by the dsh web UI sharing the\n    # same DSH_HOME, and vice versa. dsh-base @0.1.2-rc.1 already mounts the\n    # storage ×3 domain core (storage / storage-json / storage-domain) with\n    # the same config, so only the `workspace` bundle row is added here.\n    - id: workspace\n      name: '@deepseek-ai/dsh-workspace'\n"
    }
  ],
