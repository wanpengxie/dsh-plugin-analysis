  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# dsh-session-navigator bundle patch.\n#\n# Applied over the dsh-web-app layer. This bundle contributes ONE host row: the\n# plugin that serves /session-navigator/api over the DSH webserver. The browser\n# half is loaded through the `dsh.client` manifest in package.json.\n#\n# A patch replaces the targeted row's whole `config`, so only additive `insert`\n# rows appear here (no shipped row is ever overridden).\n\n- insert:\n    - id: session-navigator\n      name: 'dsh-session-navigator'\n      config: {}\n"
    }
  ],
