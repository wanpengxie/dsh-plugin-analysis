  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# dsh-plugin-weixin bundle patch layer.\n#\n# The row `id` below stays `dsh-weixin` on purpose: it is the stable identity\n# that was deployed in existing profiles, and renaming it would leave the old\n# row behind. The package `name` is what the loader resolves.\n#\n# `insert` mounts a plugin row into the loader. `name` is the package name (the\n# loader resolves it through normal node resolution from the profile's\n# node_modules), and `id` is the row's stable identity — the id the settings\n# service addresses this plugin's preferences by.\n#\n# `disabled` guards a double mount when the same package is already listed\n# (for example by another bundle's patch layer), so installing this bundle twice\n# cannot start two long-poll loops on one WeChat account.\n- insert:\n    - id: dsh-weixin\n      name: 'dsh-plugin-wechat'\n      config:\n        enabled: true\n        # Empty means deny-everyone. Fill in the Weixin user id(s) you scanned\n        # with, then reload; anything else is refused before a session exists.\n        allowedSenders: []\n        maxMessageLength: 1500\n        progressAfterMs: 45000\n        maxTurnWaitMs: 1200000\n        typingIndicator: true\n      # Must stay a single-line scalar: the loader evaluates this with eval(),\n      # and `entries()` yields entry records, not [id, entry] tuples — the\n      # row's identity lives on `entry.options.id`, not in a destructured key.\n      disabled: !!js \"[...ctx.loader.entries()].some((e) => (e.options.name === 'dsh-plugin-wechat' || e.options.name === 'dsh-plugin-weixin') && e.options.id !== 'dsh-weixin' && !e.disabled)\"\n"
    }
  ],
