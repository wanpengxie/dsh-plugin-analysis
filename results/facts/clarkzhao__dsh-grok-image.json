      "path": "cordis.patch.yml",
      "text": "# dsh-grok-image bundle layer.\n# Installed via `dsh plugin --profile <name> add ./dsh-grok-image`\n# (or linked into the profile's node_modules and added to bundles).\n#\n# Compatible with DSH 0.2.0-rc.2 and 0.2.1-rc.2. Registers the model tool\n# `image_gen` that generates images through the Grok Imagine subscription\n# endpoint (same base URL, credential and proxy as dsh-llm-grok).\n# The `@deepseek-ai/dsh*` peerDependencies range must cover the running dsh\n# version: the loader refuses to mount a bundle whose peers do not satisfy it\n# with prereleases included. npm and pnpm evaluate the same ranges strictly,\n# where `^0.2.0-rc.2` never covers a 0.2.1 pre-release, so each line is named\n# explicitly.\n- insert:\n    - id: grok-image\n      name: dsh-grok-image\n      config:\n        # Direct Grok subscription endpoint. `proxy` is optional: set it to\n        # your local HTTP(S) proxy (e.g. Clash on http://127.0.0.1:7890) when\n        # direct egress to cli-chat-proxy.grok.com is unavailable. Omit or\n        # leave empty for a direct connection.\n        baseURL: https://cli-chat-proxy.grok.com/v1\n        apiKeyEnv: GROK_SESSION_TOKEN\n        proxy: http://127.0.0.1:7890\n        model: grok-imagine-image-quality\n        outputDir: ~/grok-images\n        usageLog: true\n"
    }
