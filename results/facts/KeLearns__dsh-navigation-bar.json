  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# dsh-navigation-bar bundle patch: inserts the dual-face plugin row into the\n# web profile roster. Applied as a profile bundle layer (the dsh.bundle.patch\n# manifest field) over dsh-base; activate with\n#   dsh plugin --profile web add <package>\n#   dsh plugin --profile web add link:<this-directory>   (local development)\n#\n# The row is a bare plugin by package name: the node half (exports \".\") runs\n# in the host process (currently a no-op; the piano bar is fully client-side),\n# and the dsh.client declaration in package.json makes the browser half\n# (exports \"./client\") load in the web GUI (shell.overlay slot entry).\n- insert:\n    - id: dsh-navigation-bar\n      name: '@kelearns/dsh-navigation-bar'\n"
    }
  ],
