      "path": "cordis.patch.yml",
      "text": "# DeepSeek Companion Enterprise — bundle patch layer\n# 当 profile 的 dsh.profile.bundles 列出本包时，该层被应用。\n# 每个功能模块在此独立成行：注释掉某行（或加 disabled: true）即可整体停用它。\n\n- insert:\n    - id: companion-enterprise\n      name: dsh-companion-enterprise\n      config:\n        # 十个功能模块可独立启停，互不影响\n        enableExport: true\n        enableHandoff: true\n        enableCost: true\n        enableSearch: true\n        enableTrace: true\n        enablePrompt: true\n        enableArena: true\n        enableOrchestrator: true\n        enableTeam: true\n        enableSecurity: true\n        # DeepSeek 官方 API（manifest.json 已全量放行各厂商与中转网关域名）\n        apiBaseUrl: 'https://api.deepseek.com'\n        apiTimeoutMs: 60000\n"
    }
