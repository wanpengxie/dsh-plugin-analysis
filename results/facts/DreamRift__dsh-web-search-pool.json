  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# dsh-web-search-pool Bundle patch for DeepSeek Harness (0.1.7+ / 0.2.0+).\n#\n# 0.5.0（2026-10-19）起本 patch **不再改写官方 'web' 行**。\n# 官方搜索的接管发生在运行时（src/dsh/takeover.js 直接替换 ctx.web.search），\n# 因此不依赖 web.searchProvider、也不会和用户 profile 的 cordis.patch.yml 或\n# 官方 Web search 设置页互相覆盖。0.4.0 的 web 行覆盖写法会在 profile 层被覆盖，\n# 表现为“启用了 key 池却仍走官方 API key”，已移除。\n#\n# 这里只插入搜索池自身的 loader 行；行 id 同时是 settings namespace\n# （web-search-pool），Config schema 自动投影成插件页表单，client card 注册到\n# plugins.row.config 的 key dsh-web-search-pool#web-search-pool。\n- insert:\n    - id: web-search-pool\n      name: dsh-web-search-pool\n      config:\n        enabled: true\n        # 池不可用/全部 key 失败时是否回退官方搜索。默认 false = 启用即完全替代；\n        # 回退时模型看到的仍是同一个 web_search 工具，只是结果来自官方。\n        fallbackToOfficial: false\n        # 0.6.0 起 web_fetch（web_fetch 工具）也由本插件接管（Tavily Extract）。\n        # 关闭后 web.fetch 原样走宿主 fetch provider（按 web.fetchProvider 配置）。\n        fetchEnabled: true\n        # 池抓取不可用/失败时是否回退官方 fetch provider。默认 false，\n        # 语义与 fallbackToOfficial 对齐（启用即完全替代）。\n        fetchFallbackToOfficial: false\n        providers:\n          tavily:\n            keys: []\n            # Extract 抓取深度/格式。默认 basic + markdown：advanced 按 2 credits/URL、\n            # basic 按 1 credit/5 URL 计费，成本差约 10 倍；basic 抓不到正文的\n            # JS/反爬站点再改 advanced。\n            fetchDepth: basic\n            fetchFormat: markdown\n          exa:\n            keys: []\n        strategy: weighted-round-robin\n        providerPriority: [tavily, exa]\n        allowedFails: 3\n        cooldownMs: 30000\n        retryAfterFallbackMs: 1000\n        usageCacheMs: 300000\n        quotaReserveCredits: 2\n        quotaExhaustedCooldownMs: 2592000000\n        requestTimeoutMs: 20000\n"
    }
  ],
