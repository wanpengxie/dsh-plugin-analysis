  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# Two rows, one package:\n#\n# 1. the host row owns the downloaded server, its config, and the managed\n#    subprocess through ctx.subprocess;\n# 2. the panel row serves the pi-ai route, the catalog, and the settings UI.\n#\n# The panel never spawns a process. Keeping the rows separate is what lets a\n# panel reload leave the gateway running.\n- insert:\n    - id: workbuddy2api-gateway-host\n      name: dsh-workbuddy-panel/gateway\n    - id: llm-workbuddy2api-gateway\n      name: dsh-workbuddy-panel\n"
    }
  ],
