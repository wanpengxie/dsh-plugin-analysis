  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# Register the UI/UX Pro Max auto-invocation plugin.\n#\n# When a step's direct user input mentions UI/UX, the plugin loads the\n# `ui-ux-pro-max` skill and splices its body into that same step, so the model\n# receives the design intelligence without first calling the `skill` tool.\n#\n# Toggle in Settings -> Plugins. Disabling this bundle stops the automatic\n# injection; the `skill` tool and the `/ui-ux-pro-max` gesture keep working.\n- insert:\n    - id: ui-ux-pro-max-auto\n      name: 'dsh-ui-ux-pro-max'\n"
    }
  ],
