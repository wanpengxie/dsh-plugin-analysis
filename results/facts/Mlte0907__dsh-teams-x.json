  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# dsh-teams-x bundle patch: mounts the TeamsX plugin into the host composition\n# of a dsh profile. The plugin registers its `teamsx_*` tools into the shared\n# `tools` registry and one usage section into the global system prompt, so any\n# session of the profile can drive a multi-agent team through natural language.\n#\n# Install: `dsh plugin --profile <name> add /path/to/dsh-teams-x` (local path\n# or npm). The `dsh plugin` command pnpm-installs the package into the profile\n# and reconciles it into the profile's `dsh.profile.bundles` layer list.\n#\n# Tool namespace is `teamsx_*` and the state dir is `.teams-x`, so this plugin\n# stays isolated from any other team-mode plugins that may be mounted.\n- insert:\n    - id: teams-x\n      # Node-resolvable package name — must stay in sync with package.json `name`.\n      name: dsh-teams-x\n      config:\n        # Team state lives under `<session workspace>/<stateDir>/<teamId>/`\n        # (team.json + index files + inbox/*.jsonl mailboxes).\n        stateDir: .teams-x\n        # Provider used to spawn member subagents ('spawn' or 'fork').\n        memberProvider: spawn\n"
    }
  ],
