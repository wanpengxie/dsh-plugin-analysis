  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# The dsh-quorfloat bundle patch.\n#\n# This repository ships as ONE dsh bundle that contributes ONE host plugin row.\n# The row is inserted with the plugin's own `id` so that a user (or a\n# higher-priority patch layer, e.g. `$DSH_HOME/cordis.patch.yml`) can override\n# this row's whole `config` by targeting `id: quorfloat`.\n#\n# Every field below restates the schema defaults in `src/config.ts` on purpose:\n# a patch replaces a row's entire `config` rather than merging into it, so the\n# row must spell out the complete configuration it wants.\n\n- insert:\n    - id: quorfloat\n      name: dsh-quorfloat\n      config:\n        enabled: true\n        hotkey: Alt+Space\n        quorfloatPath: \"\"\n        defaultWorkspaceId: \"\"\n        window:\n          width: 640\n          maxHeight: 560\n          anchor: center\n          alwaysOnTop: true\n          reduceMotion: false\n          theme: system\n          # Empty means \"nobody has chosen a panel language yet\": the first launch\n          # resolves it from the Harness's own locale preference and the sidecar\n          # persists the answer as the panel's own setting.\n          language: \"\"\n        startupTimeoutMs: 8000\n        requestTimeoutMs: 10000\n        heartbeatMs: 5000\n        heartbeatMissLimit: 3\n        claimDeadlineMs: 600000\n        maxWriteBufferBytes: 4194304\n        maxStderrLines: 200\n        presenceMaxAgeMs: 30000\n        shutdownGraceMs: 1500\n        restartLimit: 3\n        restartWindowMs: 30000\n        logLevel: info\n"
    }
  ],
  "entries": [
    "package.json",
    "cordis.patch.yml"
  ],
