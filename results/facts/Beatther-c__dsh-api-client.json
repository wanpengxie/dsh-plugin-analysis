  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# dsh-api-client bundle patch: inserts the dual-face probe plugin row into the\n# profile roster. Applied as a profile bundle layer (the `dsh.bundle.patch`\n# manifest field) over dsh-base; activate with\n# `dsh plugin --profile <name> add link:<this repository>`.\n#\n# The row is a bare plugin by package name: the node half (exports \".\") runs\n# in the host process (system-prompt announcement contribution included), and\n# the `dsh.client` declaration in package.json makes the browser half\n# (exports \"./client\", served at /plugins/<id>/client.js) load in the web GUI.\n# Format follows the shipped sample @linxin666/dsh-client-ui-task-board\n# (REVIEW_NOTES_V1.1 §五).\n- insert:\n    - id: api-client\n      name: 'dsh-api-client'\n"
    }
  ],
