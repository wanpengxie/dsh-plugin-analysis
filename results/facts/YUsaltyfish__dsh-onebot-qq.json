  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# dsh-onebot-qq bundle patch — 两行：QQ 机器人本体 + 随包声明的「qq-chat」agent preset。\n# 业务配置在实例 config.json（默认 <dataDir>/config.json），这里只放引导项与 preset 声明。\n- insert:\n    - id: dsh-onebot-qq\n      name: 'dsh-onebot-qq'\n      config:\n        dataDir: ''          # 空 = $DSH_HOME/dsh-onebot-qq\n        configPath: ''       # 空 = <dataDir>/config.json\n        autoConnect: true\n        compatServer: false  # 可选 :3971 兼容网关（默认关）\n        compatPort: 3971\n\n    # 纯聊天 preset：**随包声明**，安装插件即注册，不用手改 profile 的 cordis.patch.yml。\n    # 保留：聊天 / 联网 / 上下文压缩；裁掉：shell（bash+pwsh 都关）、文件、任务、技能、提问卡、插件管理。\n    # 配置里没手填 dsh.agentPreset 时，插件会自动把 QQ 线切到这个 preset。\n    # 可选配件：装 dsh-onebot-qq-opsgate 后，它会覆盖本 preset、在 plugins 列表末尾追加工具门，\n    # 把全局插件注册的工具（ops_* / agent-team / MCP 资源）挡在 QQ 会话之外 —— 只影响 qq-chat。\n    # 安装与作用见 docs/安装与卸载.md「可选：QQ 线工具门」。\n    - id: preset-qq-chat\n      name: '@deepseek-ai/dsh-agent-preset'\n      config:\n        id: qq-chat\n        name: QQ 聊天\n        description: 纯聊天 + 联网；裁掉 shell / 文件 / 任务 / 技能 / 插件管理类工具（QQ 机器人安装即用）。\n        order: 50\n        plugins:\n          - id: persona\n            name: '@deepseek-ai/dsh-persona'\n            config:\n              prefix: |-\n                You are a QQ chat assistant. Reply naturally and briefly in the language of the incoming message.\n                QQ 线每轮必须调用 mcp__qq__* 工具才能让对方收到内容；只写正文等于没有回话。\n          - id: agent-instructions\n            name: '@deepseek-ai/dsh-agent-instructions'\n            config:\n              maxBytes: 65536\n          - id: time-context\n            name: '@deepseek-ai/dsh-time-context'\n\n          # ── shell：两平台都裁掉（纯聊天不需要）──\n          - id: tool-bash\n            name: '@deepseek-ai/dsh-tool-bash'\n            disabled: true\n          - id: tool-pwsh\n            name: '@deepseek-ai/dsh-tool-pwsh'\n            disabled: true\n\n          # ── 文件 / 搜索 / 任务 / 技能 / 交互卡片 / 插件管理：全裁 ──\n          - id: tool-fs\n            name: '@deepseek-ai/dsh-tool-fs'\n            disabled: true\n          - id: tool-fs-search\n            name: '@deepseek-ai/dsh-tool-fs-search'\n            disabled: true\n          - id: tool-jobs\n            name: '@deepseek-ai/dsh-tool-jobs'\n            disabled: true\n          - id: tool-schedule\n            name: '@deepseek-ai/dsh-tool-schedule'\n            disabled: true\n          - id: skill-filesystem\n            name: '@deepseek-ai/dsh-skill-filesystem'\n            disabled: true\n          - id: tool-skill\n            name: '@deepseek-ai/dsh-tool-skill'\n            disabled: true\n          - id: tool-ask-user\n            name: '@deepseek-ai/dsh-tool-ask-user'\n            disabled: true\n          - id: tool-todo\n            name: '@deepseek-ai/dsh-tool-todo'\n            disabled: true\n          - id: present\n            name: '@deepseek-ai/dsh-tool-present'\n            disabled: true\n          - id: tool-plugin-manager\n            name: '@deepseek-ai/dsh-plugin-manager/tools'\n            disabled: true\n          - id: tool-plugin-market\n            name: '@deepseek-ai/dsh-plugin-market/tools'\n            disabled: true\n\n          # ── 联网：搜索 / 抓取（QQ 线查资料靠它）──\n          - id: tool-web\n            name: '@deepseek-ai/dsh-tool-web'\n            config:\n              fetch: true\n              searchTimeoutMs: 60000\n\n          # ── 上下文压缩：QQ 会话长，阈值调低、保留量调小 ──\n          - id: compaction\n            name: cordis:group\n            group: true\n            isolate:\n              compaction: true\n              toolResultPruner: true\n            config:\n              - id: compaction-basic\n                name: '@deepseek-ai/dsh-compaction-basic'\n                config:\n                  thresholdRatio: 0.1\n                  retainTokens: 20000\n              - id: command-compact\n                name: '@deepseek-ai/dsh-command-compact'\n              - id: tool-result-pruner\n                name: '@deepseek-ai/dsh-compaction-tool-result-pruner'\n                config:\n                  thresholdChars: 8192\n                  headChars: 4096\n                  tailChars: 1024\n"
    }
