  "bundle": [
    {
      "path": "packages/selector/cordis.patch.yml",
      "text": "# Standalone Profile Bundle entry. The same package may already be present in a\n# Harness distribution; its Host implementation reference-counts the preset\n# decoration so the two rows never install two compression stacks.\n- insert:\n    - id: context-compression-improved-bundle\n      name: 'dsh-context-compression-improved'\n      config:\n        presetOverlay: true\n    # The HTTP routes ride their own row so the compression stack stays loadable\n    # on profiles that have no host web server. Measured on the host source:\n    # `dsh-host-webserver.register` performs no authorization check and\n    # `ctx.get(name)` only asks whether the providing fiber is active, so this\n    # `inject` is belt-and-braces — the row is simply absent instead of\n    # announcing a pending route on a webServer-less profile. The two-channel\n    # registration inside the plugin covers both arrival orders on its own.\n    #\n    # `estimatorCatalogRoute` is the only flag this row sets. The retired\n    # review gate's `reviewQueueRoute` used to live here; that key no longer\n    # exists in the plugin's Config schema (a reduction must never block\n    # automatic processing), so setting it would advertise a route that can\n    # never register.\n    - id: context-compression-improved-estimator-catalog\n      name: 'dsh-context-compression-improved'\n      inject:\n        - webServer\n      config:\n        estimatorCatalogRoute: true\n"
    }
  ],
