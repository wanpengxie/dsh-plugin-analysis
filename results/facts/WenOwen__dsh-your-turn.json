  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# dsh-your-turn bundle patch — inserts one Cordis Loader entry for this package.\n#\n# The entry id is also the settings namespace this plugin owns: the Host half\n# declares a Config schema with `.volatile()` fields, `dsh-settings` projects it\n# into the profile settings document under this id, and the browser half reads\n# and writes it through `ctx.configForms.get(\"your-turn\")`.\n#\n# Everything below is a default. A user profile patch can override any field by\n# targeting `id: your-turn`; a patch replaces the whole `config` block, so restate\n# every field you want to keep.\n- insert:\n    - id: your-turn\n      name: '@wu5/dsh-your-turn'\n      config:\n        surface: modal\n        autoDismissSeconds: 5\n        soundEnabled: true\n        soundPreset: chime\n        errorSoundPreset: alert\n        volume: 70\n"
    }
  ],
