  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# Bundle layer applied when a profile lists this package in dsh.profile.bundles.\n# The row references the package by NAME so Node resolution finds the installed\n# code from the profile directory.\n#\n# `dshHomePath` is provided on the root context by the app boot, so a layer's\n# `!!js` config expressions can reach it. A profile's own cordis.patch.yml\n# overrides this row by id; a patch REPLACES a row's whole `config`, so an\n# override must restate every key it wants to keep.\n#\n# This layer deliberately does NOT touch the `web` or `tool-web` rows.\n# `web.fetchProvider` is a deployment decision — pinning it here would silently\n# replace whatever provider a profile already selected — and `tool-web`'s\n# `fetch: false` in the base bundle means `web_fetch` is not even registered\n# until a deployment turns it on. README.md carries the composition a profile\n# needs, and `apply()` fails loud at mount when it is missing.\n#\n# The default mode is `audit`: every decision is recorded, nothing is refused.\n# Audit mode is not a control. Run `dsh-netguard report --suggest` to turn the\n# observed hosts into an allow list, then set `mode: enforce`.\n#\n# The allow list ships EMPTY, which under `mode: enforce` denies everything. A\n# guessed default is simultaneously too wide and too narrow; audit mode exists\n# to derive the real one.\n- insert:\n    - id: dsh-netguard\n      name: 'dsh-netguard'\n      config:\n        mode: audit\n        allow: []\n        deny: []\n        spoolPath: !!js dshHomePath('netguard/decisions.ocsf.jsonl')\n"
    }
  ],
  "entries": [
    "package.json",
    "cordis.patch.yml"
  ],
