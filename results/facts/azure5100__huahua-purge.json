  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# huahua-purge bundle patch\n#\n# 清洗 + 演练台都在本插件内（lib/redteam、presets/redteam、skills/redteam）。\n# 只装 huahua-purge，不外接、不 link 其它红队包。\n\n# 关掉旧的独立红队包行（若用户以前装过 dsh-redteam-mode）\n- id: redteam-store\n  name: dsh-redteam-store\n  disabled: true\n\n- id: redteam-ui\n  name: dsh-redteam-ui\n  disabled: true\n\n- id: redteam-mode\n  name: dsh-redteam-mode\n  disabled: true\n\n- id: redteam-mode-store\n  name: dsh-redteam-mode/store\n  disabled: true\n\n- id: redteam-mode-ui\n  name: dsh-redteam-mode/ui\n  disabled: true\n\n- id: system-prompt\n  config:\n    includeHarnessIdentity: false\n    personaPrefix: \"\"\n    personaSuffix: Your working directory is {{cwd}}.\n\n- id: huahua-purge\n  inject: [systemPrompt, tools]\n\n- insert:\n    - id: huahua-purge\n      name: 'huahua-purge'\n      inject: [systemPrompt, tools]\n      config:\n        enabled: true\n        autoApplyOnStart: false\n        autoUpdateOnStart: false\n        autoRevertOnMissing: false\n        injectOnce: false\n        stripMnemon: true\n        verbose: false\n        postPrompt: \"\"\n        postPromptOrder: 5100\n        autoRetry: true\n        retryMax: 3\n        autoContinue: false\n        continueMax: 3\n        continueText: \"继续\"\n        capabilityProtocol: true\n        hooksDenyBypass: true\n\n    # 演练台：预设 + 技能落地（本插件 lib/redteam）\n    - id: huahua-purge-redteam\n      name: huahua-purge/redteam\n\n    # 演练台事实库（SQLite），数据在 $DSH_HOME/redteam\n    - id: huahua-purge-redteam-store\n      name: huahua-purge/redteam/store\n      config:\n        root: !!js dshHomePath('redteam')\n\n    # 演练台 HTTP 桥 POST /redteam/api\n    - id: huahua-purge-redteam-ui\n      name: huahua-purge/redteam/ui\n"
    }
  ],
