  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# Installation is fail-safe: JSONL remains authoritative until the operator\n# has started the Teleport service and explicitly enables the cutover.\n- id: session-persistence-jsonl\n  disabled: !!js process.env.DSH_TELEPORT_ENABLE === '1'\n\n- insert:\n    - id: session-persistence-teleport\n      name: '@mattheliu/session-teleport/dsh-adapter'\n      disabled: !!js process.env.DSH_TELEPORT_ENABLE !== '1'\n      config:\n        baseUrl: !!js process.env.DSH_TELEPORT_URL ?? 'http://127.0.0.1:43127'\n        apiToken: !!js process.env.DSH_TELEPORT_API_TOKEN\n        deviceId: !!js process.env.DSH_TELEPORT_DEVICE_ID ?? process.env.HOSTNAME ?? 'local-device'\n        credentialDir: !!js dshHomePath('session-teleport', 'writers')\n        healthTimeoutMs: !!js Number(process.env.DSH_TELEPORT_HEALTH_TIMEOUT_MS ?? '5000')\n"
    }
  ],
