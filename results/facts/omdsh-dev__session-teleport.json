      "./importer": "./dist/importer.js",
      "./plugin-lifecycle": "./dist/plugin-lifecycle.js",
      "./source-capture": "./dist/source-capture.js",
      "./source-export-plugin": "./dist/source-export-plugin.js"
    },
    "bin": {
      "dsh-teleport-server": "./dist/cli.js",
      "dsh-teleport-device": "./dist/device-cli.js",
      "dsh-teleport-admin": "./dist/admin-cli.js",
      "dsh-teleport-import": "./dist/import-cli.js",
      "dsh-teleport-plugin": "./dist/plugin-cli.js"
    },
    "dsh": {
      "bundle": {
        "patch": "./cordis.patch.yml"
      }
    },
    "dshWorkshop": {
      "schema": "omdsh-workshop-package/v1",
      "type": "plugin",
      "integration": {
        "protocol": "harness-profile",
        "artifact": "cordis.patch.yml"
      },
      "install": {
        "mode": "transactional",
        "adapter": "profile-bundle",
        "failurePolicy": "generation-rollback",
        "touchesCurrentBeforeActivation": false
      },
      "lifecycle": {
        "activation": "restart-profile",
        "dispose": "supported"
      },
      "permissions": [
        "database:read",
        "database:write",
        "filesystem:write",
        "network:outbound"
      ],
      "capability": {
        "id": "session-persistence-teleport",
        "kind": "provider",
        "invocation": "boot a DSH 0.2.0-rc.1 Profile with DSH_TELEPORT_ENABLE=1 and run the Session persistence lifecycle",
        "expected": "the Teleport persistence provider becomes ready only after its PostgreSQL-backed health check passes"
      },
      "evidence": {
        "install": "docs/PLUGIN_LIFECYCLE.md",
        "failureIsolation": "docs/PLUGIN_LIFECYCLE.md",
        "hotReload": null,
        "remove": "docs/PLUGIN_LIFECYCLE.md"
      }
    },
    "scripts": {
      "build": "esbuild src/*.ts --outdir=dist --platform=node --format=esm --target=node22 --sourcemap --sources-content=false && tsc -p tsconfig.declarations.json",
      "start": "node dist/cli.js",
      "device": "node dist/device-cli.js",
      "admin": "node dist/admin-cli.js",
      "test": "vitest run",
      "test:lifecycle:local": "pnpm build && node scripts/plugin-profile-local.mjs",
      "test:lifecycle:real": "pnpm build && node scripts/plugin-lifecycle-real.mjs",
      "test:postgres": "vitest run tests/postgres.recovery.integration.spec.ts",
      "typecheck:core": "tsc -p tsconfig.core.json",
      "typecheck:adapter": "tsc -p tsconfig.adapter.json",
      "typecheck": "pnpm typecheck:core && pnpm typecheck:adapter",
      "verify:release": "node scripts/check-release-artifacts.mjs",
      "pack:check": "node scripts/check-package-tarball.mjs",
      "check": "pnpm typecheck && pnpm build && pnpm verify:release && pnpm test"
    },
    "engines": {
      "node": "^22.19.0 || >=24.0.0"
    },
    "dependencies": {
      "pg": "^8.23.0",
      "@deepseek-ai/node-addon-system": "~0.1.2"
    },
