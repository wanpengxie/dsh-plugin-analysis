  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# The @youdotcom-oss/dsh-plugin-youcom bundle patch: mounts the You.com search + fetch\n# provider and pins it as the active provider on `ctx.web`. Requires the\n# composition already loads `@deepseek-ai/dsh-web` (every shipped profile does).\n#\n# This patch replaces the `web` row's `searchProvider` / `fetchProvider` config\n# — installing this plugin means opting into You.com for web access. The base\n# bundle only sets those two fields on the row, so nothing else is clobbered.\n# To stack this alongside another provider instead, delete the `- id: web`\n# stanza below and manually pin `searchProvider: youcom` on your profile's own\n# cordis.patch.yml.\n\n- id: web\n  config:\n    searchProvider: youcom\n    fetchProvider: youcom\n\n- insert:\n    - id: youcom\n      name: '@youdotcom-oss/dsh-plugin-youcom'\n      config:\n        apiKey: !!js process.env.YDC_API_KEY\n"
    }
  ],
