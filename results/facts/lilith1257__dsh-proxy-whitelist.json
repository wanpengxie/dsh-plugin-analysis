  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# dsh-proxy-whitelist — the loader row this bundle contributes.\n#\n# A patch replaces the targeted row's whole `config`, so this bundle only adds\n# its own row. Edit the values below in your profile's cordis.patch.yml (or in\n# Settings → Plugins once the row is live), then restart DSH.\n#\n#   config:\n#     enabled: true\n#     proxy: http://127.0.0.1:7890    # your local proxy client's HTTP port\n#     include:\n#       - .d1api.xin                  # .host = the host and every subdomain below it\n#       - api.commandcode.ai          # a bare host = exactly that host\n#       - \"*.sta1n.cn\"                # *.host = subdomains only, not the apex\n#     exclude: []                     # always direct, wins over include\n#\n# A missing/omitted include list proxies nothing, which is what \"safe to\n# install\" means here: the plugin can be mounted before it is configured.\n\n- insert:\n    - id: proxy-whitelist\n      name: dsh-proxy-whitelist"
    }
