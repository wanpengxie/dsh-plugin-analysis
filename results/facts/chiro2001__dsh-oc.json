  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# 叠加在 dsh-base 之上；插入顺序决定依赖激活顺序。\n- id: session-title-llm\n  disabled: true\n\n- insert:\n    - id: webserver\n      name: '@deepseek-ai/dsh-host-webserver'\n      config:\n        host: 127.0.0.1\n        port: 0\n\n    - id: agent-presets\n      name: '@deepseek-ai/dsh-agent-presets'\n      config:\n        default: minimal\n\n    # The standard preset's delegation tools need the host model-selection\n    # settings namespace, which dsh-base does not mount by itself.\n    - id: subagent-model-selection-settings\n      name: '@deepseek-ai/dsh-tool-subagent/model-selection-settings'\n\n    - id: workspace\n      name: '@deepseek-ai/dsh-workspace'\n\n    - id: directory-picker\n      name: '@deepseek-ai/dsh-host-directory-picker-auto'\n\n    # dsh 0.1.5 moved `fileUploads` into the session-controller inject list.\n    # oc-bridge has no browser transport, so mount the headless provider in\n    # the same insert before the controller (activation follows insert order).\n    - id: oc-file-uploads\n      name: '@chiro2001/dsh-oc/file-uploads'\n\n    - id: session-controller\n      name: '@deepseek-ai/dsh-api-session-controller'\n\n    - id: oc-bridge\n      name: '@chiro2001/dsh-oc/bridge'\n      inject: [sessionController, agentPresets, goals, sessionSkillCatalog, agents, sessions, sessionProjections]\n\n    - id: oc-tui\n      name: '@chiro2001/dsh-oc/tui'\n      inject: [ocBridge]\n"
    }
  ],
