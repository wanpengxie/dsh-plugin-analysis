      "url": "https://github.com/copylee711/dsh-academic/issues"
    },
    "homepage": "https://github.com/copylee711/dsh-academic#readme",
    "main": "lib/index.js",
    "types": "lib/types/index.d.ts",
    "exports": {
      ".": {
        "types": "./lib/types/index.d.ts",
        "default": "./lib/index.js"
      },
      "./client": {
        "types": "./lib/types/client/index.d.ts",
        "default": "./lib/client.js"
      },
      "./package.json": "./package.json"
    },
