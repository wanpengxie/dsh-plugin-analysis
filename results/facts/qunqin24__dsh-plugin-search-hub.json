  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# dsh-plugin-search-hub bundle layer, applied after dsh-base (and dsh-web-app when present).\n# A patch replaces a row's whole `config`, so every key a row needs is restated.\n\n# 1. Route web search through the hub. Every agent preset's built-in web_search\n#    (dsh-tool-web) reads ctx.web, so this alone switches the desktop/Web app over.\n#    The fetch side keeps dsh-base's local HTTP fetch.\n- id: web\n  config:\n    searchProvider: plugin-search-hub\n    fetchProvider: http\n\n# 2. Host tool-web (TUI / headless; the Web app disables this row and mounts tool-web\n#    per preset instead) keeps web_fetch but leaves web_search to this package's tool,\n#    which adds time range, domain, region, language, and news filters.\n- id: tool-web\n  config:\n    search: false\n    fetch: true\n\n- insert:\n    # 3. The shared service: engines, scheduler, cooldowns, and the `plugin-search-hub` web provider.\n    #    One instance for every session. Its settings page lives on the Plugins page.\n    - id: plugin-search-hub\n      name: dsh-plugin-search-hub\n      config:\n        mode: single\n        engine: free\n        engines: [free]\n        cooldownSeconds: 60\n\n    # 4. The filter-rich web_search on the host plane. Agent presets mount their own\n    #    web_search, which shadows this one; there the hub is reached through step 1.\n    - id: plugin-search-hub-tool\n      name: dsh-plugin-search-hub/tool\n      config:\n        maxResults: 8\n        maxQueries: 4\n        timeoutMs: 60000\n        allowEngineChoice: false\n"
    }
  ],
