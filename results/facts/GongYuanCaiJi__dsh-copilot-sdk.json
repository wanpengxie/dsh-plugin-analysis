  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# dsh-copilot-sdk bundle layer.\n#\n# When this package is listed in a profile's dsh.profile.bundles, this patch\n# is applied over the profile composition: it INSERTS one plugin row that\n# bridges a GitHub Copilot subscription into the harness as the `copilot`\n# llm provider (/copilot status | models | stop).\n#\n# 配置走环境变量（COPILOT_GITHUB_TOKEN / GH_TOKEN / GITHUB_TOKEN / BYOK\n# provider config），行配置保持空，不阻塞 boot。\n- insert:\n    - id: copilot\n      name: 'dsh-copilot-sdk/plugin'\n      config: {}\n"
    }
  ],
