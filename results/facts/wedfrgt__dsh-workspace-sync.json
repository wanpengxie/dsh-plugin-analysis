      "capability": {
        "id": "workspace-sync",
        "kind": "command",
        "invocation": "/wssync status",
        "expected": "the /wssync command is registered on the commands service: status lists the mirror state and per-workspace mapping, pull/push move session bytes with append-only keep-both conflict resolution, and pulled sessions land in the correct local workspace"
      },
