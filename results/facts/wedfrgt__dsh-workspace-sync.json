  "manifest": {
    "name": "dsh-workspace-sync",
    "description": "Cross-device DSH session sharing across Windows and macOS: sessions stay grouped under the same portable workspace on every machine, the git repository never contains a machine-specific path, and sync behaviour is configured in a runtime-live settings page. Workspace identity is explicit (workspaceId + name in the repo, local path only on the machine that owns it); adopted sessions get their header cwd rewritten as a byte-surgical first-frame edit that leaves the rest of the log untouched; deletion propagation is bounded so a peer can never remove a session you created.",
    "version": "0.1.0",
    "type": "module",
    "main": "./index.mjs",
    "exports": {
      ".": {
        "default": "./index.mjs"
      },
      "./client": {
        "default": "./client/client.js"
      },
      "./cordis.patch.yml": "./cordis.patch.yml",
      "./package.json": "./package.json"
    },
    "files": [
