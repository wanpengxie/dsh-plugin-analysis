  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# dsh-workspace-sync —— DSH bundle patch\n#\n# 这是插件的\"挂载声明\"。DSH 启动时按 bundle 层栈叠加各插件 patch，\n# 本文件把插件行插进 profile 的配置树。\n#\n# 安装：\n#   dsh plugin --profile desktop add link:/path/to/dsh-workspace-sync\n#\n# 注意：不要与**另一个同样做会话同步的插件**同时启用——两个都读写会话库与各自的\n# 同步仓库，交叉运行会互相干扰。启用本插件前，先在 profile 的 cordis.patch.yml 里\n# 把那一行关掉。\n- insert:\n    - id: workspace-sync\n      name: dsh-workspace-sync\n      config:\n        enabled: true\n        # **留空**：装上之后请打开设置页，把 remote 填成你自己的私有仓库地址\n        #   git@github.com:<你>/<你的仓库>.git\n        # 留空时插件不会碰你的磁盘或网络，只会提示\"还没配置远端\"。\n        remote: ''\n        branch: main\n        authMode: ssh\n        syncMode: manual\n"
    }
  ],
