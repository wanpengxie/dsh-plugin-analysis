    {
      "path": "cordis.patch.yml",
      "text": "# dsh-pdf-mineru bundle layer. Values below are first-boot composition defaults;\n# later edits persist through the DSH settings service.\n- insert:\n    - id: dsh-pdf-mineru\n      name: 'dsh-pdf-mineru'\n      config:\n        schemaVersion: 3\n        activeProvider: mp_self_hosted\n        providers:\n          - id: mp_self_hosted\n            type: self-hosted-legacy-v2\n            baseURL: 'http://localhost:18000'\n            apiKeyEnv: MINERU_API_KEY\n            allowInsecureHttp: true\n            modelMap:\n              pipeline: pipeline\n              vlm: vlm-engine\n          - id: mp_official\n            type: official-v4\n            baseURL: 'https://mineru.net/api/v4'\n            apiKeyEnv: MINERU_API_KEY\n            models:\n              - pipeline\n              - vlm\n            configuredVersion: v4\n          - id: mp_self_hosted_v1\n            type: self-hosted-v1\n            baseURL: 'http://localhost:8000'\n            apiKeyEnv: MINERU_API_KEY\n            allowInsecureHttp: true\n            ocrMode: auto\n        defaults:\n          model: pipeline\n          ocr: false\n          parseMethod: auto\n          language: ch\n          formula: true\n          table: true\n        retry:\n          maxAttempts: 3\n          baseDelayMs: 500\n          maxDelayMs: 10000\n"
    }
