      "text": "# dsh-ai4scholar bundle layer.\n#\n# `dsh plugin --profile <name> add dsh-ai4scholar` appends this layer to the\n# profile's `dsh.profile.bundles`. It inserts ONE row that mounts the plugin\n# with its shipped defaults; override any field from the profile's own\n# `cordis.patch.yml` (a patch replaces the whole `config`, so restate every key\n# you keep):\n#\n#   - id: ai4scholar\n#     config:\n#       apiKeyEnv: AI4SCHOLAR_API_KEY\n#       defaultMaxResults: 20\n#       googleScholar: false\n#\n# The API key itself is never written here: the plugin resolves the reference\n# named by `apiKeyEnv` through the dsh credentials service (`$DSH_HOME/.credentials.yaml`\n# or the launching environment).\n- insert:\n    - id: ai4scholar\n      name: dsh-ai4scholar\n"
    }
