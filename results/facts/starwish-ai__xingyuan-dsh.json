  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# 星愿 bundle 层：只插常驻行（存储后端 / HTTP 路由 / schedule / Agent 预设声明）。\n# 语义：`- insert:` 插入新行；裸行按 id 整行替换既有配置（不深合并）。\n# DB 文件固定在 ~/.dsh/xingyuan/：插件卸载 / 升级数据均存活，禁止放入包安装目录。\n- insert:\n    # sqlite 后端：只依赖 storage hub，DB 位于 ~/.dsh/xingyuan/\n    - id: xingyuan-sqlite\n      name: '@starwish-ai/xingyuan-dsh/sqlite'\n      config:\n        path: !!js \"dshHomePath('xingyuan', 'xingyuan.sqlite')\"\n    # 主行 id 不能与 preset 声明行的行 id 或 config.id 同名，故加 xy- 前缀\n    - id: xy-bundle\n      name: '@starwish-ai/xingyuan-dsh'\n    # 宿主默认组装不含 schedule 行，需补插以满足加载顺序要求\n    - id: schedule\n      name: '@deepseek-ai/dsh-schedule'\n    # Agent 预设「星愿」。dsh 0.1.7 起宿主不再扫描 $DSH_HOME/.agent-presets 目录——\n    # preset 就是这一行声明，激活期由 @deepseek-ai/dsh-agent-preset 提交给注册表。\n    # 行 id 按官方约定 preset-<config.id>；config.id 是会话落盘的预设身份，与\n    # src/tab-policy.ts 的 XINGYUAN_PRESET_ID 逐字同源（对拍 test/preset-declaration.test.ts，\n    # 少这一行则选择器静默不出现星愿、typecheck 全绿）。\n    - id: preset-xingyuan\n      name: '@deepseek-ai/dsh-agent-preset'\n      config:\n        id: xingyuan\n        name: 星愿\n        description: 愿望与任务管理助手：对话创建愿望/任务、机会日打卡、微行动、记忆与图表。\n        order: 100\n        plugins:\n          # 工具 / 提示词 / HITL 只挂 preset 层：未选择星愿的会话看不到它们\n          - name: '@starwish-ai/xingyuan-dsh/preset/side'\n# 领域路由：星愿领域走 sqlite 后端；其余领域维持 json（整行替换须重述 backend）\n- id: storage-domain\n  name: '@deepseek-ai/dsh-storage-domain'\n  config:\n    backend: json\n    routes:\n      xingyuan: sqlite\n"
    }
  ],
