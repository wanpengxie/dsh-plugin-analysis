  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# dsh-motor-ai 完整版 Cordis 配置补丁（bundle patch）\n# ============================================================\n# 本文件是插件的「组合包默认配置」。DSH 通过 package.json 的\n#     dsh.bundle.patch -> ./cordis.patch.yml\n# 识别该插件可作为组合包安装；profile 自身的 cordis.patch.yml\n# 可在本层之上做用户级覆盖（同 id 行会合并/覆盖）。\n#\n# 层级设计：总闸 level = 'l2'（完整版覆盖 L0+L1+L2）。\n#   - L0 永久免费，无码可用\n#   - L1/L2 工具恒注册，**调用时**按激活码门控；无码/过期/无效\n#     返回 LICENSE_REQUIRED 引导，绝不影响 L0\n- insert:\n    - id: dsh-motor-ai\n      name: 'dsh-motor-ai'\n      config:\n        # ---- 层级总闸 ----\n        level: 'l2'                        # 'l0' | 'l1' | 'l2'\n        l1Enabled: true                    # L1（RMxprt 磁路法）分闸\n        l2Enabled: true                    # L2（Motor-CAD 精验）分闸\n        # ---- 激活验签（v2 非对称 Ed25519）----\n        # 留空 = 使用包内置公钥 lib/activation-public.pem；\n        # 仅在密钥轮换或测试时填 PEM 覆盖。\n        activationPublicKeyPem: ''\n        # ---- L0 运行参数（免费层）----\n        l0Mode: 'auto'                     # formula | surrogate | auto\n        surrogatePath: 'models/l0_surrogate_family.json'\n        surrogateConfidenceThreshold: 0.4\n        maxMatrixSize: 2000\n        topNPreview: 20\n        constantsSource: 'lib/motor-constants.mjs'\n        # ---- 效率与温升口径 ----\n        efficiencyCap: 96\n        tempRiseRange: [45, 130]\n        # ---- 物理校验参数（motor_design_validate）----\n        airGapFluxT: 0.8                   # 气隙磁密基准 T\n        insulationClass: 'F'               # B=80K / F=105K / H=125K\n        highSpeedRpm: 8000                 # 超此转速气隙上限放宽到 4mm\n        # ---- 脱敏聚合遥测（完整版默认开，2026-10-14）----\n        # 只回传「按工具聚合的次数/成败/耗时/规模」，不含设计参数/结果/提示词/路径/密钥。\n        # ⚠️ telemetryEndpoint 全文件只允许出现一次（YAML 禁重复键；DSH 客户端\n        #    插件管理器用 yaml@2 严格模式解析补丁，遇重复键抛 \"Map keys must be\n        #    unique\" → 判「patch file is not a valid entry list」→ 升级失败自动回滚）。\n        #    端点取值见下方「聚合遥测端点」节；置空 = 回退 {后端}/api/dsh/dsh-plugins/dsh-motor-ai/usage-report。\n        telemetryEnabled: true             # 总开关（boolean）；完整版默认开，置 false 显式退出\n        telemetryBatchSize: 50\n        telemetryMinIntervalMs: 60000      # 上报尝试最小间隔（0=不节流；兼容旧键 telemetryIntervalSec）\n        sessionTelemetry: 'auto'           # auto = 顺带挂 DSH sessionTelemetry\n        # ---- 免费额度旁路计数后端（P1 对齐 l0：预填官方接收端，2026-10-14）----\n        # 仅旁路遥测用（fire-and-forget，不参与放行决策、不阻塞调用链；放行 100% 本地）。\n        # 官方接收端（Deno Deploy 2，境内直连可达）：https://dsh-motor-ai-receiver.wangxuewangxue98.deno.net\n        # 置空串 = 不发旁路计数（回退 env.DSH_BACKEND_URL → http://127.0.0.1:5000）。\n        commerceBackendUrl: 'https://dsh-motor-ai-receiver.wangxuewangxue98.deno.net'\n        # ---- 来源区分（v1.0.1：完整版与 l0 在后端账本上分离）----\n        # 默认与 l0 同为 'dsh-motor-ai-l0'（两侧共用免费额度账的设计）；\n        # 显式设为 'dsh-motor-ai-full' 后，receiver KV 计数键 ['fce'/'pd', plugin_id, ...]\n        # 按本值分桶 —— 后端统计可区分来源，本地额度文件仍按 device 维度共用，不受影响。\n        # ⚠️ 仅对新安装/升级到含本补丁版本的用户生效（cordis patch 在安装时注入）。\n        quotaPluginId: 'dsh-motor-ai-full'\n        # ---- 聚合遥测端点（v1.0.1：接通官方接收端 telemetry 通道）----\n        # 完整版 telemetry 默认开（telemetryEnabled=true），缺省打 usage-report 路径\n        # （Flask 后端契约，deno receiver 无此路径会 404 静默）。\n        # 显式指向 receiver 的 /api/dsh/telemetry 后，版本分布/工具使用统计当天可见。\n        telemetryEndpoint: 'https://dsh-motor-ai-receiver.wangxuewangxue98.deno.net/api/dsh/telemetry'\n        # ---- 脱敏设计经验回传（默认开启；用于 L0 代理重训与经验回流，2026-10-21 起默认开）----\n        designExperienceUpload: true\n        experienceEndpoint: ''             # 空 = 同源派生 telemetryEndpoint 的 /api/dsh/experience\n        experienceBatchSize: 200\n        experienceMinIntervalMs: 60000     # design_exp 上报节流窗口（ms）；0 = 不节流\n        # ---- 已解决问题回流（P1-B；贡献型、不占配额，默认关闭）----\n        # 与 telemetry/designExperienceUpload 相互独立：本项回传「用户主动提交的\n        # 已解决问题知识」（问题分类/症状/根因/改进措施/解决过程），喂在线知识库做知识积累。\n        # 身份类字段（账号/路径/提示词/密钥）经白名单硬排除。开启后通过 submit_resolved_case 工具触发。\n        issueResolvedEnabled: true        # 总开关（boolean）；默认开启（2026-10-21 起默认开，知识经验回流）\n        issueResolvedEndpoint: ''         # 目标 URL；为空则回退 commerceBackendUrl + /api/dsh/issue-resolved\n        # ---- 故障协助（在线经验智能支持，Part 二完整版，2026-10-21）----\n        # 用户报故障时，提示上传脱敏故障情况 → 自动匹配在线知识库相似案例给经验建议；\n        # 解决后用 submit_resolved_case 回流。faultAssistEnabled 默认开；端点缺省回退后端同源。\n        faultAssistEnabled: true          # 故障协助总开关（boolean）；默认开启（opt-out 置 false）\n        faultReportEndpoint: ''           # 脱敏故障上报 URL；空 = 回退 commerceBackendUrl + /api/dsh/fault-report\n        issueQueryEndpoint: ''            # 相似案例查询 URL；空 = 回退 commerceBackendUrl + /api/dsh/issue-resolved/query\n        # ---- 文字经验反馈（经验反馈渠道 P0-B/P1，2026-10-30；opt-in 默认关）----\n        # 用户/AI 会话总结「踩坑经验/改进建议/能力缺口」后经 motor_submit_experience 工具发回，\n        # 接收端落 ['fbk']，策展后进 ['kb'] 供 design-assist 注入。四道脱敏闸（白名单 +\n        # 黑名单键即拒 + S01~S10 内容级扫描 + rec_id 内容 sha1）。与 issueResolvedEnabled 分工：\n        # iss=问题→根因→解决（故障向）；fbk=经验/建议/缺口（知识向）。\n        experienceFeedbackEnabled: false  # 总开关（boolean）；默认关闭（opt-in，需用户明示授权）\n        experienceFeedbackEndpoint: ''    # 目标 URL；为空则回退 commerceBackendUrl + /api/dsh/experience-feedback\n        # ---- 整篇文档分块回传（doc 通道，2026-10-30；opt-in 默认关）----\n        # 客户端收集的资料/整理的文件完整原样回传：motor_upload_doc 分块 POST\n        # /api/dsh/doc-upload，落 ['doc']，维护者 export 重组还原。与 fbk 分工：\n        # fbk=蒸馏条目（可检索）；doc=原文件留档（不进检索库）。文件原样传输不做脱敏。\n        docUploadEnabled: false           # 总开关（boolean）；默认关闭（opt-in，需用户明示授权）\n        docUploadEndpoint: ''             # 目标 URL；为空则回退 commerceBackendUrl + /api/dsh/doc-upload\n        docUploadToken: ''                # 上传令牌（可选）；空=开放档 ≤32 块（≈1.1MB）；配置后解锁 512 块\n        openChannelSecret: ''             # 开放通道轻量共享密钥（v1.2.2，可选）；空=用烘焙默认；接收端设 OPEN_CHANNEL_SECRET 同值后闸门生效\n        # ---- 在线知识库入口（P1-C；为空 = 文案不带链接）----\n        knowledgeBaseUrl: 'https://workbuddy.link/p/xWcD0qQyCUoGVl98S2LHei'  # 在线知识库公开入口（导航页）；空 = 文案不带链接（与 index.mjs 默认值保持一致，勿加 www）\n        # ---- 设计经验自动注入（design-assist，2026-10-23）----\n        # 设计前经 /api/dsh/kb/query 拉取 L1 杠杆 / L2 评价 / 策展经验，\n        # 以 design_knowledge_hints 非破坏性追加到结果，不改动原有返回结构。\n        designAssistEnabled: true          # 总开关（boolean）；默认开启（opt-out 置 false）\n        kbQueryEndpoint: ''                # 知识查询 URL；空 = 回退 commerceBackendUrl + /api/dsh/kb/query\n        # ---- L2 Motor-CAD 默认模板（1.2.5；S2 补齐开箱模板缺口）----\n        # motor_motorcad_verify 未显式传 template 时的 .mot 兜底链：config.motFile\n        # > env MOTORCAD_DEFAULT_MOT > 包内 models/templates/default/（按 motorType 解析）\n        # > 空（用 Motor-CAD 当前模型）。包内模板为 DSH 自制，无 Ansys 示例版权内容。\n        motFile: ''                        # .mot 模板绝对路径（可选）；空 = 走包内默认模板解析\n"
    }
  ],
