  "manifest": {
    "name": "dsh-naiwa",
    "version": "0.1.0",
    "description": "奶蛙桌宠 for DSH Web: 原版 432 帧动画、眼神跟随、Q 弹形变、分裂分身与物理反弹堆积，复用 dsh-whale-widget 账本只读记账",
    "keywords": [
      "dsh",
      "dsh-plugin",
      "deepseek-harness",
      "desktop-pet",
      "naiwa"
    ],
    "type": "module",
    "main": "lib/index.js",
    "icon": "./icon.svg",
    "exports": {
      ".": "./lib/index.js",
      "./client": "./lib/client.js",
      "./locale/*.json": "./locale/*.json",
      "./icon": "./icon.svg",
      "./package.json": "./package.json"
    },
    "files": [
      "lib",
      "locale",
      "assets",
      "icon.svg",
      "cordis.patch.yml",
      "THIRD-PARTY-NOTICES.md",
      "LICENSE",
      "README.md"
    ],
    "dsh": {
      "bundle": {
        "patch": "./cordis.patch.yml"
      },
      "client": {
        "platform": "web",
        "inject": []
      }
    },
    "scripts": {
      "build": "node tools/build.mjs",
      "test": "node tools/test.mjs",
      "smoke": "node tools/smoke.mjs"
    },
    "license": "MIT"
  },
  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# ============================================================================\n# dsh-naiwa —— 奶蛙桌宠 DSH bundle patch\n# ============================================================================\n# 这是插件的\"挂载声明\"。DSH 启动时按 bundle 层栈叠加各插件 patch，\n# 本文件把奶蛙桌宠插件插入 Web profile 的配置树。\n#\n# 安装方式：\n#   dsh plugin --profile web add dsh-naiwa\n# 或本地目录安装（Plugin Manager install_bundle / link:）：\n#   dsh plugin --profile web add link:<本目录绝对路径>\n#\n# ⚠️ 本插件与 dsh-whale-widget 完全独立：不占用它的 id、路由、CSS 前缀、\n#    localStorage 键，也不写它的账本文件。两者可以分别安装/启用/禁用。\n# ============================================================================\n\n- insert:\n    - id: dsh-naiwa\n      name: dsh-naiwa\n      config: {}\n"
    }
  ],
  "entries": [
    "lib/index.js",
    "lib/client.js",
    "icon.svg",
    "package.json",
    "cordis.patch.yml"
  ],
