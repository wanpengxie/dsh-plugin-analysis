  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# The dsh-team bundle patch: one row over whatever base layer the profile\n# composes. The package is its own bundle, so `dsh plugin add link:<path>`\n# both installs and activates it — there is no separate bundle package to\n# keep in step.\n#\n# The row needs `@deepseek-ai/dsh-subagent` (with a continuable provider, e.g.\n# `subagent-spawn-in-process`), `dsh-session-projection`, and session\n# persistence — all present in `@deepseek-ai/dsh-base`.\n#\n# The virtual workspaces additionally need a mounted `storage-domain` form\n# (`@deepseek-ai/dsh-web-app` composes one). Without it the team keeps\n# everything else and `team_note` / `team_board` are simply never registered.\n\n- insert:\n    - id: team\n      name: 'dsh-team'\n      config:\n        # `ctx.subagents` provider that materializes teammates.\n        provider: spawn\n        # Live roster ceiling per leader session.\n        maxTeammates: 8\n        # Mailbox rows kept in the durable fold and shown on the stage.\n        maxRecentMessages: 50\n        # How far one teammate-to-teammate conversation may relay; reaching\n        # the leader is never counted and never refused.\n        maxChainHops: 4\n        # Messages one ordered member pair may exchange inside one conversation.\n        maxChainRoundTrips: 2\n        # Notes one workspace area (the shared board, or one private pad) holds.\n        maxWorkspaceEntries: 32\n        # Longest single note body.\n        maxNoteChars: 4000\n"
    }
  ],
