  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# GitHub source-install entry point. Internal plugins use paths relative to\n# this repository package so they do not need to be published independently.\n\n- id: session-query-sqlite\n  config:\n    path: !!js dshHomePath('aiops-incidents.sqlite')\n    openAt: startup\n\n- insert:\n    - id: aiops-observability\n      name: './packages/aiops-observability/lib/index.js'\n\n    - id: webhook-runtime\n      name: '@deepseek-ai/dsh-webhook'\n\n    - id: aiops-skill-k8s-diag\n      name: './packages/skill-k8s-diag/lib/index.js'\n\n    - id: aiops-incident-router\n      name: './packages/incident-router/lib/index.js'\n      config:\n        source: primary-alertmanager\n        ruleId: aiops-alertmanager-router\n        statePath: !!js dshHomePath('aiops-router.sqlite')\n        workspacePath: !!js process.env.AIOPS_WORKSPACE || process.cwd()\n        agentPreset: standard\n        permissionPreset: read-only\n        # Route every alert by default. Keep this list limited to known noise\n        # that should never open a diagnostic Session.\n        routingPolicy:\n          ignoredAlertnames:\n            - Watchdog\n            - InfoInhibitor\n          defaultSeverity: warning\n        severityMap:\n          debug: info\n          info: info\n          notice: info\n          warn: warning\n          warning: warning\n          error: critical\n          critical: critical\n          fatal: critical\n          page: critical\n        modelBudgets:\n          info: 2048\n          warning: 4096\n          critical: 8192\n        stormControl:\n          cooldownSeconds: 60\n          maxQueueSize: 100\n          maxQueueAgeSeconds: 900\n          maxDispatchAttempts: 3\n          retryBackoffSeconds: 10\n          globalConcurrency: 4\n          severityConcurrency:\n            info: 1\n            warning: 2\n            critical: 4\n          globalReservedTokens: 24576\n          severityReservedTokens:\n            info: 2048\n            warning: 8192\n            critical: 24576\n        diagnosisWindow:\n          beforeSeconds: 900\n          afterSeconds: 1800\n          prometheusStepSeconds: 30\n          logTailLines: 1000\n\n    - id: aiops-alertmanager-webhook-ingress\n      name: cordis:group\n      group: true\n      isolate:\n        webServer: true\n      config:\n        - id: aiops-alertmanager-webhook-server\n          name: '@deepseek-ai/dsh-host-webserver'\n          config:\n            host: !!js process.env.AIOPS_WEBHOOK_HOST || '127.0.0.1'\n            port: !!js Number(process.env.AIOPS_WEBHOOK_PORT || 3081)\n\n        - id: aiops-alertmanager-webhook-adapter\n          name: './packages/webhook-alertmanager/lib/index.js'\n          config:\n            source: primary-alertmanager\n            path: /alertmanager\n            secretEnv: AIOPS_ALERTMANAGER_WEBHOOK_SECRET\n            maxBodyBytes: 1048576\n            maxAlerts: 100\n            maxMapEntries: 100\n            maxTextChars: 10000\n\n    - id: aiops-alertmanager\n      name: './packages/aiops-alertmanager/lib/index.js'\n      config:\n        baseUrl: !!js process.env.ALERTMANAGER_URL\n        timeoutMs: 30000\n        maxResponseBytes: 2000000\n        maxFilterCount: 20\n        maxQueryValueChars: 1000\n\n    - id: aiops-prometheus\n      name: './packages/aiops-prometheus/lib/index.js'\n      config:\n        baseUrl: !!js process.env.PROMETHEUS_URL\n        timeoutMs: 30000\n        maxResponseBytes: 2000000\n        defaultDiscoveryLimit: 20\n        maxDiscoveryLimit: 100\n        maxMatcherCount: 20\n        maxInputChars: 2000\n        maxDiscoveryWindowSeconds: 86400\n\n    - id: aiops-kubernetes\n      name: './packages/aiops-kubernetes/lib/index.js'\n      config:\n        context: !!js process.env.KUBERNETES_CONTEXT\n        timeoutMs: 30000\n        maxResponseBytes: 2000000\n        defaultLogTailLines: 200\n        maxLogTailLines: 2000\n\n    - id: aiops-observe-tools\n      name: './packages/tool-aiops-observe/lib/index.js'\n\n    - id: aiops-incident\n      name: './packages/aiops-incident/lib/index.js'\n\n    - id: aiops-history-tools\n      name: './packages/tool-aiops-history/lib/index.js'\n      config:\n        defaultLimit: 20\n        maxLimit: 100\n        maxScanSessions: 500\n        timeoutMs: 30000\n\n    - id: aiops-portal\n      name: './packages/aiops-portal/lib/index.js'\n      config:\n        maxIncidents: 100\n        maxAuditRecords: 250\n        maxScanSessions: 500\n        webhookUrl: !!js process.env.AIOPS_WEBHOOK_PUBLIC_URL || 'http://127.0.0.1:3081/alertmanager'\n        webhookSecretRef: AIOPS_ALERTMANAGER_WEBHOOK_SECRET\n"
    }
  ],
