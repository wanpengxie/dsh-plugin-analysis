    {
      "path": "cordis.patch.yml",
      "text": "# ============================================================================\n# dsh-cache-control — DSH bundle patch\n# ============================================================================\n# Host row: mounted into the profile composition on boot, like dsh-bg-atelier.\n# The row id and package name below are what loader patches / the Plugins page\n# show. The host half serves the settings/gate routes AND registers the session\n# gate's system-prompt section (host plane, so every preset, subagent and\n# workflow child gets it); the client half is served from disk as\n# /plugins/dsh-cache-control/client.js.\n# Install (canonical form, run from a terminal while DSH is closed):\n#\n#   dsh plugin --profile web add link:D:/DeepSeek/dsh-plugins/dsh-cache-control\n#\n# or wire the package by hand the same way dsh-bg-atelier is wired:\n#   1. add the dependency + bundle entry in profiles/web/package.json, and\n#   2. junction node_modules/dsh-cache-control to this directory.\n# Then restart the desktop app once (host half + new client bundle). After that\n# settings apply live: gate / ponytail / output-shape to the NEXT step of any\n# session, and edits to session-gate.md / gate.md are picked up on the next\n# request — no further restarts.\n# ============================================================================\n\n- insert:\n    - id: cache-control\n      name: dsh-cache-control\n"
    }
  ],
