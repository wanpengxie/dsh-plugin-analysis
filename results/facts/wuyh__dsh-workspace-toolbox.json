  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# dsh-workspace-toolbox bundle patch: mount the plugin's Host half into a DSH\n# profile. The `id` is the plugin row identity; `name` resolves to this\n# package's Host entry (lib/index.js via package.json `main`/`exports[\".\"]`).\n# The browser half is declared in package.json via `dsh.client` and mounted by\n# the client-modules kernel from lib/client.js — no extra row is needed here.\n- insert:\n    - id: dsh-workspace-toolbox\n      name: dsh-workspace-toolbox\n"
    }
  ],
