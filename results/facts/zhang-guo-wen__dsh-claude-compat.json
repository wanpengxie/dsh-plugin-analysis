  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# Install-order independence: a bundle such as @guowenzhang/dsh-agent-manager\n# may already mount this plugin under its own row. Two live instances register\n# the same service twice and fail the whole plugin tree at boot, so this row\n# backs off when an earlier composed row already mounts the package. The\n# mirrored guard in that bundle's patch covers the opposite install order.\n- insert:\n    - id: claude-compat\n      name: '@guowenzhang/dsh-claude-compat'\n      disabled: !!js \"[...ctx.loader.entries()].some((e) => e.options.name === '@guowenzhang/dsh-claude-compat' && e.options.id !== 'claude-compat' && !e.disabled)\"\n"
    }
  ],
