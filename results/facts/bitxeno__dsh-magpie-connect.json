  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# dsh-magpie-connect DSH plugin — bundle patch: insert the plugin row (deployment-global).\n#\n# The gateway ships with the conventional local address but no key: set the key\n# on the Settings sidebar page (\"Magpie\") or via the config object below (see\n# src/config.ts). Until a key is set the picker stays empty and calls fail fast.\n#\n# The Settings sidebar page can override baseUrl/apiKey at runtime\n# (saved to <dataDir>/settings.json, applied without restart) and hides models\n# from the picker. Page values win per-field; the patch config below stays as\n# fallback (e.g. headless compositions without the settings page).\n# <dataDir> defaults to $DSH_HOME/storages/magpie-connect\n# (~/.dsh/storages/magpie-connect). The pre-0.5 dir ~/.dsh-magpie-connect is\n# read once as a fallback and removed on the first save; it is never migrated\n# eagerly, so an upgrade that changes nothing touches no file.\n#\n# - baseUrl: versioned API root (default http://127.0.0.1:3425/v1). Include the\n#   version segment: the plugin appends only the resource (/models, /responses),\n#   so a gateway on /v2 or /v3 is reached by changing this one string.\n# - apiKey:  gateway credential (required, even if /models needs none).\n# - dataDir: plugin state dir (status snapshot, settings file, catalog cache);\n#   defaults to $DSH_HOME/storages/magpie-connect.\n# - displayName: cosmetic label in the model picker (route id stays providerId).\n# - providerId:  RENAME the route id itself (existing sessions pointing at the\n#   old id will orphan — prefer displayName for a cosmetic rename).\n- insert:\n    - id: dsh-magpie-connect\n      name: 'dsh-magpie-connect'\n      config: {}\n"
    }
  ],
  "entries": [
    "lib/index.js",
    "lib/types/index.d.ts",
