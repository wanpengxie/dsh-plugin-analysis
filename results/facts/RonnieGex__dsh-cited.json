    {
      "path": "cordis.patch.yml",
      "text": "# dsh-cited bundle patch: mounts the plugin into a profile layer stack.\n# The row id is the key a user overrides in the profile's cordis.patch.yml; the row\n# name is the module this package exports, so it stays the package name. The two are\n# different on purpose: DSH's plugin card prints the row id and the module name on\n# separate lines.\n- insert:\n    - id: cited\n      name: 'dsh-cited'\n"
    }
