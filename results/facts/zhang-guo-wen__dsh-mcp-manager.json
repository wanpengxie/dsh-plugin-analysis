  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# Install-order independence: a bundle such as @guowenzhang/dsh-agent-manager\n# may already mount this plugin under its own row. Two live instances register\n# the same service twice and fail the whole plugin tree at boot, so this row\n# backs off when an earlier composed row already mounts the package. The\n# mirrored guard in that bundle's patch covers the opposite install order.\n#\n# The row id is `mcp-manager-ui`, not `mcp-manager`: the shipped DeepSeek\n# Harness Web composition (and 0.2.2+ Desktop) mounts its own\n# `@deepseek-ai/dsh-mcp-manager` on the `mcp-manager` row, and this plugin's\n# Settings namespace is its Loader row id. A distinct id keeps both plugins\n# mountable and keeps `mcp-manager-ui` addressing this plugin's Config.\n- insert:\n    - id: mcp-manager-ui\n      name: '@guowenzhang/dsh-mcp-manager'\n      disabled: !!js \"[...ctx.loader.entries()].some((e) => e.options.name === '@guowenzhang/dsh-mcp-manager' && e.options.id !== 'mcp-manager-ui' && !e.disabled)\"\n"
    }
  ],
