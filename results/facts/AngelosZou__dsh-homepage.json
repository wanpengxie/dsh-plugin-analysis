  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# dsh-homepage bundle patch.\n#\n# Applied as a profile patch layer after every in-box bundle. Inserts the plugin\n# row at the profile root; later layers (or the user's own cordis.patch.yml) can\n# address it by id, with the last write winning.\n#\n# The model-facing `homepage` tool ships off so it never sits in a model's\n# context unasked. Turn it on in the Plugins settings page (the `exposeTool`\n# switch), or by adding `config: { exposeTool: true }` to this row.\n- insert:\n    - id: dsh-homepage\n      name: 'dsh-homepage'\n"
    }
  ],
