  "bundle": [
    {
      "path": "cordis.patch.yml",
      "text": "# 本 bundle 声明两个组件行：记忆上下文自身 + 定制版 dsh-ops。\n#\n# dsh-ops 以 vendored 依赖（package.json 的 file:./vendor/dsh-ops）随本包安装，\n# 不在 dsh.profile.bundles 里单独出现；插件页「包含的组件」因此显示两行，\n# 点进 dsh-ops 行就是它自己的完整设置页。\n#\n# 默认值（2026-11-04 用户拍板）：\n# - bash: true          随包携带完整 Windows x64 Bash 载荷（PortableGit + bash 5.3.15）\n# - hidePwsh: false     不夺走宿主 pwsh\n# - hideOfficialTools: true  用 ops_* 替换官方 read/glob/grep（可在组件设置页关闭）\n# - dynamicTools: false 会话中途不改工具 schema（缓存纪律）\n- insert:\n    - id: memory-context-lab\n      name: dsh-memory-context-lab\n      config: {}\n\n    - id: dsh-ops\n      name: dsh-ops\n      config:\n        global:\n          bash: true\n          hidePwsh: false\n          hideOfficialTools: true\n          dynamicTools: false\n        minimal:\n          enabled: true\n        standard:\n          enabled: true\n          residentTools: true\n        ptc:\n          enabled: true\n          residentTools: true\n        cordis:\n          enabled: true\n          residentTools: true\n        discovery:\n          enabled: false\n        panel:\n          enabled: false\n        tui:\n          enabled: false\n"
    }
  ],
