    {
      "kind": "tool",
      "name": "hub_search",
      "where": "lib/index.js:64",
      "description": "检索本地知识库正文、笔记和批注。默认当前文献所在目录当前层；scope=vault可检索整个知识库。结果保留来源和原文定位。"
    },
    {
      "kind": "tool",
      "name": "hub_read",
      "where": "lib/index.js:65",
      "description": "读取当前或指定文献的正文片段，可按可靠页码或段落blockId定位。笔记与学习档案分别使用hub_notes和hub_study。"
    },
    {
      "kind": "tool",
      "name": "hub_notes",
      "where": "lib/index.js:66",
      "description": "读取或保存文献笔记。用 content 保留段落、引用和录音顺序；兼容旧的 blocks 与 freeText。写入需 expectedRevision。"
    },
    {
      "kind": "tool",
      "name": "hub_annotations",
      "where": "lib/index.js:67",
      "description": "读取或保存文献高亮、勾画与批注。写入前先读取revision；items是完整批注数组。"
    },
