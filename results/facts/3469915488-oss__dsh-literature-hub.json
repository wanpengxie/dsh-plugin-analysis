      "kind": "tool",
      "name": "hub_study",
      "where": "lib/index.js:68",
      "description": "读取或保存学习计划、理解问题、测验反馈和复习日期。保存前先读取revision；study保留已有字段。"
    },
    {
      "kind": "tool",
      "name": "hub_citation",
