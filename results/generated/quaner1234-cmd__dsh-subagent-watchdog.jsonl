{"unit_id":"quaner1234-cmd__dsh-subagent-watchdog#intent-2","repo":"quaner1234-cmd/dsh-subagent-watchdog","commit":"37c1da0275ecab1dc2818cd624fe2c8255df0ebc","type":"intent","lang":"zh","text":"让 DSH 的可续接子任务在 max-tokens 中断后继续跑一次。","source":"generated","evidence":["lib/index.js:453","lib/index.js:509"]}
