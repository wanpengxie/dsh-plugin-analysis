{"unit_id":"dshworks__dsh-crew#feature-broadcast","repo":"dshworks/dsh-crew","commit":"13b0fdfd0503c29ada9647d3b2f0cb1c4c40ea99","type":"feature","lang":"zh","text":"dsh-crew 的功能「多面板广播」：至少有两个运行中的面板时，界面显示广播输入框；提交消息后会把文本和回车依次发送给所有运行中的面板。","source":"generated","evidence":["src/client/crew-view.js:158-175","src/client/crew-view.js:214-228"]}
