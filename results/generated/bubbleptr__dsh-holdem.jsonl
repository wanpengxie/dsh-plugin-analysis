{"unit_id":"bubbleptr__dsh-holdem#feature-4","repo":"bubbleptr/dsh-holdem","commit":"23c476efb0bd52e0472610942e248b7db12f3372","type":"feature","lang":"zh","text":"dsh-holdem 的功能「买入与出局」：每位玩家筹码耗尽后最多重新买入三次，用尽后退出牌局；玩家可重置牌桌重新开始。","source":"generated","evidence":["src/table-rules.js:5","src/table-rules.js:12","src/host.js:784"]}
