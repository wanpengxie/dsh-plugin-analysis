{"unit_id":"wbb316__dsh-profile-sync#feature-4","repo":"wbb316/dsh-profile-sync","commit":"dc2c6a01931ff87cd100cd842dfe241c9e38550c","type":"feature","lang":"zh","text":"dsh-profile-sync 的功能「迁移落地核对」：status 动作读取待核对记录，对照目标 manifest、依赖和 bundle 状态，报告已匹配、仅写入 manifest 或仍有缺项。","source":"generated","evidence":["lib/index.js:350-380","lib/artifacts.js:186-237"]}
