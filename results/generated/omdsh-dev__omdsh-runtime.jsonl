{"unit_id":"omdsh-dev__omdsh-runtime#caveat-activate","repo":"omdsh-dev/omdsh-runtime","commit":"816d453c1d20afa110b78f4cc524d7a58c45679a","type":"caveat","lang":"zh","text":"应用 Pack 会先准备候选配置，激活和运行时确认由独立命令完成；回滚仅恢复 Profile 代次选择，不覆盖外部副作用。","source":"generated","evidence":["dist/cli.mjs:15-42","dist/profile-pack.mjs:1-30"]}
