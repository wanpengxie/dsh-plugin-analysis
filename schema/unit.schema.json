{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dsh-plugin-analysis/unit.schema.json",
  "title": "One text unit for the search index (one line of results/units/<owner>__<name>.jsonl); see INDEX-TEXTS.md",
  "type": "object",
  "additionalProperties": false,
  "required": ["unit_id", "repo", "commit", "type", "lang", "text", "source"],
  "properties": {
    "unit_id": {"type": "string", "pattern": "^[^#]+__[^#]+#(card|intent|feature|declared|readme|caveat|lifecycle)-[A-Za-z0-9_.-]+$"},
    "repo": {"type": "string"},
    "commit": {"type": "string"},
    "type": {"enum": ["card", "intent", "feature", "declared", "readme", "caveat", "lifecycle"]},
    "lang": {"enum": ["zh", "en"]},
    "text": {"type": "string", "minLength": 4, "maxLength": 1200},
    "source": {"enum": ["generated", "extracted"]},
    "evidence": {"type": "array", "items": {"type": "string"}, "description": "file:line; required when source is generated"},
    "section": {"type": "string", "description": "readme units: the section heading"}
  },
  "if": {"properties": {"source": {"const": "generated"}}},
  "then": {"required": ["evidence"], "properties": {"evidence": {"minItems": 1}}}
}
