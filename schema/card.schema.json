{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dsh-plugin-analysis/card.schema.json",
  "title": "One DSH plugin's card: the structured fields a marketplace filters, ranks and shows by",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "repo",
    "commit",
    "tier",
    "generated_at",
    "worker",
    "name",
    "one_liner",
    "clients",
    "surfaces",
    "requirements",
    "install",
    "topics",
    "keywords",
    "risk",
    "signals",
    "coverage",
    "readme_mismatch",
    "quality"
  ],
  "$defs": {
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[^:]+(:[0-9]+(-[0-9]+)?)?$"
      },
      "description": "file:line or file:start-end"
    }
  },
  "properties": {
    "repo": {
      "type": "string",
      "description": "owner/name"
    },
    "commit": {
      "type": "string"
    },
    "tier": {
      "enum": [
        "A",
        "B",
        "C"
      ]
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "worker": {
      "type": "string",
      "description": "which luna worker wrote it"
    },
    "name": {
      "type": "string",
      "description": "the plugin's display name (from package.json or README)"
    },
    "one_liner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "zh",
        "en"
      ],
      "properties": {
        "zh": {
          "type": "string",
          "maxLength": 60
        },
        "en": {
          "type": "string",
          "maxLength": 120
        }
      }
    },
    "clients": {
      "type": "array",
      "items": {
        "enum": [
          "web",
          "tui",
          "desktop",
          "mobile",
          "cli",
          "any",
          "unknown"
        ]
      },
      "description": "which DSH clients it works in, from dsh.client and the code"
    },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "ui-panel",
          "ui-theme",
          "ui-widget",
          "tool",
          "command",
          "prompt",
          "model-provider",
          "model-routing",
          "context",
          "memory",
          "session",
          "storage",
          "integration",
          "background",
          "other"
        ]
      },
      "description": "where it hooks into DSH"
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api_keys",
        "accounts",
        "external_services",
        "local"
      ],
      "properties": {
        "api_keys": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "purpose",
              "required",
              "evidence"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "the env var or setting it is read from"
              },
              "purpose": {
                "type": "string"
              },
              "required": {
                "type": "boolean"
              },
              "evidence": {
                "$ref": "#/$defs/evidence"
              }
            }
          }
        },
        "accounts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "accounts the user needs (e.g. a Feishu bot, an OpenRouter account)"
        },
        "external_services": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "host",
              "purpose",
              "evidence"
            ],
            "properties": {
              "host": {
                "type": "string"
              },
              "purpose": {
                "type": "string"
              },
              "sends_user_data": {
                "type": "boolean"
              },
              "evidence": {
                "$ref": "#/$defs/evidence"
              }
            }
          }
        },
        "local": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "what it needs or does on the machine: OS, binaries, ports it opens, files it writes, autostart"
        }
      }
    },
    "install": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method"
      ],
      "properties": {
        "method": {
          "enum": [
            "dsh-plugin-add",
            "npm",
            "git",
            "manual",
            "unknown"
          ]
        },
        "command": {
          "type": "string",
          "description": "the exact command, when the code or README gives one"
        },
        "config_items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "required"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "required": {
                "type": "boolean"
              },
              "default": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "evidence": {
                "$ref": "#/$defs/evidence"
              }
            }
          }
        },
        "dsh_version": {
          "type": "string",
          "description": "dsh.compatibility / engines, when declared"
        }
      }
    },
    "topics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary",
        "secondary"
      ],
      "properties": {
        "primary": {
          "type": "string",
          "description": "an id from TAXONOMY.md"
        },
        "secondary": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "string"
          }
        },
        "proposed": {
          "type": "string"
        }
      }
    },
    "keywords": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "zh",
        "en"
      ],
      "properties": {
        "zh": {
          "type": "array",
          "minItems": 3,
          "maxItems": 12,
          "items": {
            "type": "string"
          }
        },
        "en": {
          "type": "array",
          "minItems": 3,
          "maxItems": 12,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "ui_language": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "languages its UI or messages are in"
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "flags",
        "checked",
        "reviewed"
      ],
      "properties": {
        "level": {
          "enum": [
            "none",
            "low",
            "medium",
            "high"
          ]
        },
        "flags": {
          "type": "array",
          "items": {
            "enum": [
              "jailbreak",
              "credential_access",
              "exfiltration",
              "obfuscated_code",
              "remote_code_download",
              "crypto_mining",
              "unofficial_model_access",
              "terms_violation",
              "telemetry",
              "broad_permissions",
              "prompt_injection_text",
              "other"
            ]
          }
        },
        "notes": {
          "type": "string",
          "maxLength": 400
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reviewed": {
          "type": "boolean",
          "description": "false until a person has checked a high"
        },
        "checked": {
          "type": "array",
          "description": "one conclusion for every place facts.suspicious points at",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "where",
              "finding",
              "verdict"
            ],
            "properties": {
              "where": {
                "type": "string"
              },
              "finding": {
                "type": "string"
              },
              "verdict": {
                "enum": [
                  "problem",
                  "benign"
                ]
              }
            }
          }
        }
      }
    },
    "signals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stars",
        "pushed_at",
        "commits"
      ],
      "properties": {
        "stars": {
          "type": "integer"
        },
        "pushed_at": {
          "type": "string"
        },
        "commits": {
          "type": "integer"
        },
        "created_at": {
          "type": "string"
        }
      },
      "description": "copied from the list, for ranking"
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "read_all"
      ],
      "properties": {
        "read_all": {
          "type": "boolean"
        },
        "skipped": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "readme_mismatch": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "what the README claims that the code does not do, or the other way round"
    },
    "copies": {
      "type": "integer",
      "description": "how many copies lists/duplicates.csv maps to this repo"
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grade",
        "completeness",
        "code",
        "docs",
        "maintenance",
        "tests"
      ],
      "description": "STRATEGY.md §6",
      "properties": {
        "grade": {
          "enum": [
            "S",
            "A",
            "B",
            "C",
            "D"
          ]
        },
        "completeness": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "score",
            "reason",
            "evidence"
          ],
          "properties": {
            "score": {
              "type": "integer",
              "minimum": 0,
              "maximum": 5
            },
            "reason": {
              "type": "string",
              "maxLength": 200
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "code": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "score",
            "reason",
            "evidence"
          ],
          "properties": {
            "score": {
              "type": "integer",
              "minimum": 0,
              "maximum": 5
            },
            "reason": {
              "type": "string",
              "maxLength": 200
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "docs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "score",
            "reason",
            "evidence"
          ],
          "properties": {
            "score": {
              "type": "integer",
              "minimum": 0,
              "maximum": 5
            },
            "reason": {
              "type": "string",
              "maxLength": 200
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "maintenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "score",
            "reason",
            "evidence"
          ],
          "properties": {
            "score": {
              "type": "integer",
              "minimum": 0,
              "maximum": 5
            },
            "reason": {
              "type": "string",
              "maxLength": 200
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "tests": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "score",
            "reason",
            "evidence"
          ],
          "properties": {
            "score": {
              "type": "integer",
              "minimum": 0,
              "maximum": 5
            },
            "reason": {
              "type": "string",
              "maxLength": 200
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "notes": {
          "type": "string",
          "maxLength": 400
        }
      }
    }
  }
}
