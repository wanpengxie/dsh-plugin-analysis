{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dsh-plugin-analysis/analysis.schema.json",
  "title": "One DSH plugin, analysed",
  "type": "object",
  "additionalProperties": false,
  "required": ["repo", "commit", "tier", "analysed_at", "analyst", "summary", "keywords", "topic", "dsh_usage", "stack", "quality", "risk", "originality", "evidence"],
  "properties": {
    "repo": {"type": "string", "description": "owner/name"},
    "commit": {"type": "string", "description": "the HEAD commit analysed (from lists/*.csv), so a result can be checked against the same code"},
    "tier": {"enum": ["A", "B"]},
    "analysed_at": {"type": "string", "format": "date-time"},
    "analyst": {"type": "string", "description": "which worker produced it, e.g. luna-07"},

    "summary": {"type": "string", "maxLength": 200, "description": "one sentence, Chinese: what it does for a DSH user"},
    "keywords": {"type": "array", "minItems": 3, "maxItems": 12, "items": {"type": "string"}, "description": "lowercase, from the code and docs, not invented"},

    "topic": {
      "type": "object", "additionalProperties": false, "required": ["primary", "secondary"],
      "properties": {
        "primary": {"type": "string", "description": "one id from TAXONOMY.md"},
        "secondary": {"type": "array", "maxItems": 3, "items": {"type": "string"}},
        "proposed": {"type": "string", "description": "only when no id fits: a short name for a new topic"}
      }
    },

    "dsh_usage": {
      "type": "object", "additionalProperties": false, "required": ["bundle_kind", "surfaces"],
      "properties": {
        "bundle_kind": {"type": "string", "description": "what dsh.bundle declares (patch, full bundle, ...)"},
        "surfaces": {"type": "array", "items": {"type": "string"}, "description": "where it hooks into DSH: web ui, tui, tools, prompts, model provider, routing, storage, ..."},
        "client": {"type": "string", "description": "dsh.client.platform when declared"},
        "capabilities": {"type": "array", "items": {"type": "string"}}
      }
    },

    "stack": {
      "type": "object", "additionalProperties": false, "required": ["languages"],
      "properties": {
        "languages": {"type": "array", "items": {"type": "string"}},
        "frameworks": {"type": "array", "items": {"type": "string"}},
        "external_services": {"type": "array", "items": {"type": "string"}, "description": "APIs, sites or binaries it talks to"}
      }
    },

    "quality": {
      "type": "object", "additionalProperties": false, "required": ["grade", "scores", "notes"],
      "properties": {
        "grade": {"enum": ["S", "A", "B", "C", "D"], "description": "QUALITY rubric in STRATEGY.md"},
        "scores": {
          "type": "object", "additionalProperties": false,
          "required": ["completeness", "code", "docs", "maintenance", "tests"],
          "properties": {
            "completeness": {"type": "integer", "minimum": 0, "maximum": 5},
            "code": {"type": "integer", "minimum": 0, "maximum": 5},
            "docs": {"type": "integer", "minimum": 0, "maximum": 5},
            "maintenance": {"type": "integer", "minimum": 0, "maximum": 5},
            "tests": {"type": "integer", "minimum": 0, "maximum": 5}
          }
        },
        "notes": {"type": "string", "maxLength": 400}
      }
    },

    "risk": {
      "type": "object", "additionalProperties": false, "required": ["level", "flags"],
      "properties": {
        "level": {"enum": ["none", "low", "medium", "high"]},
        "flags": {"type": "array", "items": {"enum": ["jailbreak", "credential_access", "exfiltration", "obfuscated_code", "remote_code_download", "crypto_mining", "unofficial_model_access", "terms_violation", "telemetry", "other"]}},
        "notes": {"type": "string", "maxLength": 400}
      }
    },

    "originality": {
      "type": "object", "additionalProperties": false, "required": ["kind"],
      "properties": {
        "kind": {"enum": ["original", "derived", "copy"], "description": "derived: builds on another plugin; copy: little of its own"},
        "of": {"type": "array", "items": {"type": "string"}, "description": "owner/name it derives from or copies"}
      }
    },

    "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}, "description": "file:line or file paths the judgements rest on"}
  }
}
