{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dsh-plugin-analysis/facts.schema.json",
  "title": "Facts extracted from one plugin's code by scripts/extract_facts.py (static only, nothing executed); STRATEGY.md §3.3",
  "type": "object",
  "required": [
    "repo",
    "commit",
    "extracted_at",
    "tree",
    "manifest",
    "bundle",
    "entries",
    "config",
    "endpoints",
    "declared",
    "deps",
    "quality_raw",
    "readme",
    "skipped"
  ],
  "$defs": {
    "loc": {
      "type": "string",
      "description": "file:line"
    },
    "repository_health": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lifecycle", "maintenance", "issues", "health_score", "score_components", "method"],
      "properties": {
        "lifecycle": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "repository_archived", "repository_disabled", "deprecated_notice", "maintenance_notice", "last_push_at", "inactive_days", "commit_count", "checked_at", "signals"],
          "properties": {
            "status": {"enum": ["active", "low_activity", "inactive", "deprecated", "archived", "unknown"]},
            "repository_archived": {"type": ["boolean", "null"]},
            "repository_disabled": {"type": ["boolean", "null"]},
            "deprecated_notice": {"type": "boolean"},
            "maintenance_notice": {"type": "boolean"},
            "last_push_at": {"type": "string"},
            "inactive_days": {"type": ["integer", "null"], "minimum": 0},
            "commit_count": {"type": "integer", "minimum": 0},
            "checked_at": {"type": "string", "format": "date-time"},
            "signals": {"type": "array", "items": {"type": "string"}}
          }
        },
        "maintenance": {
          "type": "object", "additionalProperties": false,
          "required": ["frequency", "commits_30d", "commits_90d", "commits_365d", "active_months_12m", "median_commit_interval_days"],
          "properties": {
            "frequency": {"enum": ["weekly_or_more", "monthly_or_more", "occasional", "dormant", "unknown"]},
            "commits_30d": {"type": ["integer", "null"], "minimum": 0},
            "commits_90d": {"type": ["integer", "null"], "minimum": 0},
            "commits_365d": {"type": ["integer", "null"], "minimum": 0},
            "active_months_12m": {"type": ["integer", "null"], "minimum": 0, "maximum": 12},
            "median_commit_interval_days": {"type": ["number", "null"], "minimum": 0}
          }
        },
        "issues": {
          "type": "object", "additionalProperties": false,
          "required": ["enabled", "open_items_count", "sample_size", "open_sample", "closed_sample", "close_rate_sample", "median_close_days_sample", "updated_90d_sample", "latest_updated_at"],
          "properties": {
            "enabled": {"type": ["boolean", "null"]},
            "open_issue_count": {"type": ["integer", "null"], "minimum": 0, "description": "Pure GitHub Issue count when GraphQL enrichment is used"},
            "open_items_count": {"type": ["integer", "null"], "minimum": 0, "description": "GitHub repository open_issues_count; includes pull requests"},
            "sample_size": {"type": ["integer", "null"], "minimum": 0},
            "open_sample": {"type": ["integer", "null"], "minimum": 0},
            "closed_sample": {"type": ["integer", "null"], "minimum": 0},
            "close_rate_sample": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
            "median_close_days_sample": {"type": ["number", "null"], "minimum": 0},
            "updated_90d_sample": {"type": ["integer", "null"], "minimum": 0},
            "latest_updated_at": {"type": "string"}
          }
        },
        "health_score": {"type": "integer", "minimum": 0, "maximum": 100},
        "score_confidence": {"enum": ["low", "medium", "high"]},
        "score_components": {
          "type": "object", "additionalProperties": false,
          "required": ["lifecycle", "maintenance", "issues"],
          "properties": {"lifecycle": {"type": "integer"}, "maintenance": {"type": "integer"}, "issues": {"type": "integer"}}
        },
        "method": {"const": "repository-health-v1"}
      }
    }
  },
  "properties": {
    "repo": {
      "type": "string"
    },
    "commit": {
      "type": "string"
    },
    "extracted_at": {
      "type": "string",
      "format": "date-time"
    },
    "tree": {
      "type": "object",
      "required": [
        "files",
        "lines_by_language",
        "outline"
      ],
      "properties": {
        "files": {
          "type": "integer"
        },
        "bytes": {
          "type": "integer"
        },
        "lines_by_language": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "outline": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "paths, three levels deep"
        }
      }
    },
    "manifest": {
      "type": "object",
      "description": "package.json, long scripts trimmed; includes the dsh field"
    },
    "bundle": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "text"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        }
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "config": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "kind",
          "where"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "env",
              "setting",
              "file",
              "other"
            ]
          },
          "default": {
            "type": "string"
          },
          "where": {
            "$ref": "#/$defs/loc"
          }
        }
      }
    },
    "endpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "host",
          "where"
        ],
        "properties": {
          "host": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "where": {
            "$ref": "#/$defs/loc"
          }
        }
      }
    },
    "declared": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "name",
          "where"
        ],
        "properties": {
          "kind": {
            "enum": [
              "tool",
              "command",
              "setting",
              "ui",
              "hook",
              "other"
            ]
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "where": {
            "$ref": "#/$defs/loc"
          }
        }
      }
    },
    "deps": {
      "type": "object",
      "properties": {
        "dependencies": {
          "type": "object"
        },
        "devDependencies": {
          "type": "object"
        }
      }
    },
    "quality_raw": {
      "type": "object",
      "required": [
        "test_files",
        "has_ci",
        "typed"
      ],
      "properties": {
        "test_files": {
          "type": "integer"
        },
        "has_ci": {
          "type": "boolean"
        },
        "has_lint": {
          "type": "boolean"
        },
        "typed": {
          "type": "boolean"
        },
        "commits": {
          "type": "integer"
        },
        "pushed_at": {
          "type": "string"
        },
        "created_at": {
          "type": "string"
        }
      }
    },
    "repository_health": {
      "$ref": "#/$defs/repository_health"
    },
    "readme": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "section",
          "text"
        ],
        "properties": {
          "section": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        }
      }
    },
    "skipped": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
