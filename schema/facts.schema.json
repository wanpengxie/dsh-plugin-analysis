{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dsh-plugin-analysis/facts.schema.json",
  "title": "Facts extracted from one plugin's code by scripts/extract_facts.py (static only, nothing executed); STRATEGY.md §3.3",
  "type": "object",
  "required": ["repo", "commit", "extracted_at", "tree", "manifest", "bundle", "entries", "config", "endpoints", "declared", "deps", "quality_raw", "suspicious", "readme", "skipped"],
  "$defs": {
    "loc": {"type": "string", "description": "file:line"}
  },
  "properties": {
    "repo": {"type": "string"},
    "commit": {"type": "string"},
    "extracted_at": {"type": "string", "format": "date-time"},
    "tree": {"type": "object", "required": ["files", "lines_by_language", "outline"], "properties": {
      "files": {"type": "integer"}, "bytes": {"type": "integer"},
      "lines_by_language": {"type": "object", "additionalProperties": {"type": "integer"}},
      "outline": {"type": "array", "items": {"type": "string"}, "description": "paths, three levels deep"}}},
    "manifest": {"type": "object", "description": "package.json, long scripts trimmed; includes the dsh field"},
    "bundle": {"type": "array", "items": {"type": "object", "required": ["path", "text"], "properties": {"path": {"type": "string"}, "text": {"type": "string"}}}},
    "entries": {"type": "array", "items": {"type": "string"}},
    "config": {"type": "array", "items": {"type": "object", "required": ["name", "kind", "where"], "properties": {
      "name": {"type": "string"}, "kind": {"enum": ["env", "setting", "file", "other"]}, "default": {"type": "string"}, "where": {"$ref": "#/$defs/loc"}}}},
    "endpoints": {"type": "array", "items": {"type": "object", "required": ["host", "where"], "properties": {
      "host": {"type": "string"}, "url": {"type": "string"}, "where": {"$ref": "#/$defs/loc"}}}},
    "declared": {"type": "array", "items": {"type": "object", "required": ["kind", "name", "where"], "properties": {
      "kind": {"enum": ["tool", "command", "setting", "ui", "hook", "other"]}, "name": {"type": "string"}, "description": {"type": "string"}, "where": {"$ref": "#/$defs/loc"}}}},
    "deps": {"type": "object", "properties": {"dependencies": {"type": "object"}, "devDependencies": {"type": "object"}}},
    "quality_raw": {"type": "object", "required": ["test_files", "has_ci", "typed"], "properties": {
      "test_files": {"type": "integer"}, "has_ci": {"type": "boolean"}, "has_lint": {"type": "boolean"}, "typed": {"type": "boolean"},
      "commits": {"type": "integer"}, "pushed_at": {"type": "string"}, "created_at": {"type": "string"}}},
    "suspicious": {"type": "array", "items": {"type": "object", "required": ["kind", "where"], "properties": {
      "kind": {"enum": ["eval", "new_function", "child_process", "download_execute", "obfuscation", "base64_blob", "secret_file_read", "outbound_with_local_data", "other"]},
      "where": {"$ref": "#/$defs/loc"}, "snippet": {"type": "string", "maxLength": 300}}}},
    "readme": {"type": "array", "items": {"type": "object", "required": ["section", "text"], "properties": {"section": {"type": "string"}, "text": {"type": "string"}}}},
    "skipped": {"type": "array", "items": {"type": "string"}}
  }
}
